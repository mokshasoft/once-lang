-- arith-simple.once: integer arithmetic
--
-- Demonstrates infix operators with correct precedence.
-- Computes: 3 + 5 * 2 = 3 + 10 = 13 and exits with that code.
--
-- Build and run (from the repository root):
--   once build examples/arith-simple.once -o arith-simple
--   ./arith-simple; echo $?        # 13

import I.Linux.Syscalls as S

main : Act Unit Void
main = exit@S (3 + 5 * 2)
