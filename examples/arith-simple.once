-- arith-simple.once: Simple arithmetic test for --arith flag
--
-- Demonstrates infix operators with correct precedence.
-- Computes: 3 + 5 * 2 = 3 + 10 = 13 and exits with that code.
--
-- Build and run:
--   cd compiler && stack exec -- once build --exe --strata ../Strata ../examples/arith-simple.once -o ../.build/arith-simple
--   ../.build/arith-simple; echo "Exit code: $?"
--
-- With --arith flag (uses native arithmetic compiler):
--   cd compiler && stack exec -- once build --exe --arith --strata ../Strata ../examples/arith-simple.once -o ../.build/arith-simple
--   ../.build/arith-simple; echo "Exit code: $?"

import I.Linux.Syscalls as S

main : IO Unit
main = effCompose (exit@S) (pure (3 + 5 * 2))
