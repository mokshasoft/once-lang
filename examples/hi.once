-- hi.once: The simplest Once executable
--
-- Demonstrates:
--   - Minimal executable (just exits with status 0)
--   - Module imports (I.Linux.Syscalls)
--   - No string handling, no I/O beyond exit
--
-- Build and run (from the repository root):
--   once build examples/hi.once -o hi
--   ./hi && echo "Success!"

import I.Linux.Syscalls as S

main : Act Unit Void
main = exit0@S
