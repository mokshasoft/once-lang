------------------------------------------------------------------------
-- seL4 Echo Server in Once (Minimal Version)
--
-- This demonstrates the seL4_Yield primitive in a loop.
--
-- NOTE: Full IPC functionality requires pair literal support
-- which is not yet implemented. This is a minimal example showing
-- the basic structure of a seL4 server in Once.
------------------------------------------------------------------------

import I.SeL4.IPC

------------------------------------------------------------------------
-- Server Loop
------------------------------------------------------------------------

-- | Minimal server loop that just yields
serverLoop : Eff Unit Unit
serverLoop =
  let y = seL4_Yield@IPC ()
  in serverLoop

------------------------------------------------------------------------
-- Main Entry Point
------------------------------------------------------------------------

main : IO Unit
main = serverLoop

------------------------------------------------------------------------
