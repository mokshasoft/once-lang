------------------------------------------------------------------------
-- seL4 Echo Server in Once
--
-- A server that receives IPC messages and yields.
-- Demonstrates pair literals for seL4 syscall arguments.
------------------------------------------------------------------------

import I.SeL4.IPC

------------------------------------------------------------------------
-- Configuration
------------------------------------------------------------------------

-- Endpoint capability slot (set by rootserver)
serverEndpoint : Int
serverEndpoint = 4

-- Reply capability slot
replySlot : Int
replySlot = 0

------------------------------------------------------------------------
-- Server Loop
------------------------------------------------------------------------

-- | Server loop: receive message, yield, repeat
serverLoop : Eff Unit Unit
serverLoop =
  -- Receive on endpoint (using pair literal for args)
  let recvResult = seL4_Recv@IPC (serverEndpoint, replySlot)
  -- Yield and loop
  in let y = seL4_Yield@IPC ()
  in serverLoop

------------------------------------------------------------------------
-- Main Entry Point
------------------------------------------------------------------------

main : IO Unit
main = serverLoop

------------------------------------------------------------------------