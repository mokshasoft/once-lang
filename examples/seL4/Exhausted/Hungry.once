-- Plan 0.123 A.5 on seL4: a program whose live data grows without bound (a
-- list that gains a cell every round, all of it kept) runs out of its region.
-- A room check sees it before the allocation that would not fit and calls the
-- seL4 Host's `once_exhausted`, which faults. Never a write past the region
-- into the stack (before plan 0.123 the heap ran into the stack silently).
--
-- As the root task it has no fault endpoint: the kernel reports the fault and
-- stops the thread. Started by Monitor.once, the fault goes to the monitor.

grow : Mu (K Unit + K Int * Id) -> Void + Mu (K Unit + K Int * Id)
grow l = inr (In (inr (1, l)))

keep : Eff (Mu (K Unit + K Int * Id)) Void
keep = ana grow

main : Eff Unit Void
main = keep . (\_ -> In (inl unit))
