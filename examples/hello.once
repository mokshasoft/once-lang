-- hello.once: Hello World for Once
--
-- Once has no strings yet, so the program says hello the only way it can be
-- observed today: by its exit code. It computes 6 * 7 and exits with it.
--
-- Demonstrates:
--   - a pure function (`answer`)
--   - importing an interpretation (I.Linux.Syscalls)
--   - an executable's `main : Act Unit Void` ending in the `exit` effect
--
-- Build and run (from the repository root):
--   once build --target x86_64 --exe examples/hello.once -o hello
--   ./hello; echo $?        # 42

import I.Linux.Syscalls as S

answer : Int -> Int
answer x = x * (x + 1)

main : Act Unit Void
main = exit@S (answer 6)
