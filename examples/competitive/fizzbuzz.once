-- fizzbuzz.once: FizzBuzz in Once (point-free style)
--
-- Once is a categorical language - no named parameters.
-- Functions are compositions of morphisms.
--
-- This simplified version demonstrates:
--   - Module imports (Arith, Control, File)
--   - Integer comparisons via ifZero
--   - Conditional output via case
--
-- Build:
--   cd compiler && stack exec -- once build --exe \
--     --strata ../Strata \
--     ../examples/competitive/fizzbuzz.once -o ../.build/fizzbuzz
--   gcc -o ../.build/fizzbuzz ../.build/fizzbuzz.c
--   ../.build/fizzbuzz

import I.Linux.File as F
import I.Math.Int as A
import I.Linux.Control as C
import I.Linux.Syscalls as S

-- For now, just verify imports compile and run
-- Full FizzBuzz would need integer literals in expressions
-- which requires extending the IR/codegen

main : IO Unit
main = exit0@S