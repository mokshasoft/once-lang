-- fizzbuzz.once: Classic FizzBuzz problem
--
-- Problem: For numbers 1 to N, print:
--   - "Fizz" if divisible by 3
--   - "Buzz" if divisible by 5
--   - "FizzBuzz" if divisible by both
--   - The number otherwise
--
-- This demonstrates:
--   - Integer arithmetic (mod)
--   - Branching via ifZero and case
--   - String output
--
-- Build:
--   cd compiler && stack exec -- once build --exe \
--     --strata ../Strata \
--     ../examples/competitive/fizzbuzz.once -o ../.build/fizzbuzz

import I.Linux.File as F
import I.Linux.arith as A
import I.Linux.control as C

-- Check if a number is divisible by d (returns 0 if yes, non-zero if no)
isDivisible : Int * Int -> Int
isDivisible = mod@A

-- FizzBuzz for a single number
-- This is the core logic: check divisibility and print appropriate string
fizzbuzzOne : Int -> IO Unit
fizzbuzzOne n =
  let by3 = isDivisible (pair (const n) (const 3) terminal)
      by5 = isDivisible (pair (const n) (const 5) terminal)
      by15 = isDivisible (pair (const n) (const 15) terminal)
  in case (ifZero@C by15)
       (const (println@F "FizzBuzz"))
       (const (case (ifZero@C by3)
                (const (println@F "Fizz"))
                (const (case (ifZero@C by5)
                         (const (println@F "Buzz"))
                         (const (compose println@F (intToString@C n)))))))
       terminal

-- For now, just demonstrate with a few hardcoded values
main : IO Unit
main =
  let _ = fizzbuzzOne 1
      _ = fizzbuzzOne 2
      _ = fizzbuzzOne 3
      _ = fizzbuzzOne 4
      _ = fizzbuzzOne 5
      _ = fizzbuzzOne 6
      _ = fizzbuzzOne 9
      _ = fizzbuzzOne 10
      _ = fizzbuzzOne 15
  in fizzbuzzOne 20
