-- fannkuch.once: Fannkuch-redux benchmark (D040, D042, D044)
--
-- Benchmarks Game: https://benchmarksgame-team.pages.debian.net/benchmarksgame/
--
-- Uses typed arrays (D042) with pure operations (D044) and recursion (D040)
-- to implement the algorithm entirely in Once.
--
-- D044: Array operations are PURE (not wrapped in Eff).
-- State is threaded through return values.
-- Only I/O (print) uses effects.
--
-- Expected output for n=7:
--   228
--   Pfannkuchen(7) = 16
--
-- Build:
--   cd compiler && stack exec -- once build --exe \
--     --strata ../Strata ../examples/competitive/fannkuch.once -o ../.build/fannkuch
--   gcc -o ../.build/fannkuch ../.build/fannkuch.c
--   ../.build/fannkuch 7
--
-- Algorithm:
--   1. Parse n from command line
--   2. Initialize perm array [0, 1, ..., n-1]
--   3. Iterate through all n! permutations (Heap's algorithm)
--   4. For each permutation, count pancake flips
--   5. Accumulate checksum and track max flips
--   6. Print results

import I.Linux.Memory as M
import I.Linux.Array as A
import I.Linux.Control as C
import I.Linux.Arith as AR
import I.Linux.Argv as AV
import I.Linux.File as F
import D.Array as DA

------------------------------------------------------------------------
-- Count pancake flips (pure)
------------------------------------------------------------------------

-- | Count flips loop: flip prefix until first element is 0
-- Input: (work, flips) where work is the working array
-- Returns: (work, flips) with final flip count
-- D047: Tail-recursive (calls itself in tail position)
countFlipsLoop : Array Int * Int ->> Array Int * Int
countFlipsLoop = \args ->
  let work = fst args in
  let flips = snd args in
  let first = unsafeRead@A (work, 0) in
  case ifZero@C first of {
    Left done -> (work, flips);
    Right cont ->
      let first1 = add@AR (first, 1) in
      let work1 = reversePrefix@DA (work, first1) in
      let flips1 = add@AR (flips, 1) in
      countFlipsLoop (work1, flips1)
  }

-- | Count flips for a permutation (pure)
-- Input: (perm, (work, n))
-- Copies perm to work, counts flips
-- Returns: (work, flips)
countFlips : Array Int * (Array Int * Int) -> Array Int * Int
countFlips = \args ->
  let perm = fst args in
  let wn = snd args in
  let work = fst wn in
  let n = snd wn in
  -- Copy perm to work
  let work1 = copyArray@DA (work, (perm, n)) in
  -- Count flips starting from 0
  countFlipsLoop (work1, 0)

------------------------------------------------------------------------
-- Rotation-based next permutation (pure)
------------------------------------------------------------------------

-- | Rotation-based permutation generation loop
-- Input: (perm, (count, (i, n)))
-- Returns: (perm, (count, isDone)) where isDone = 1 if no more perms
-- D047: Tail-recursive (calls itself in tail position)
nextPermLoop : Array Int * (Array Int * (Int * Int)) ->> Array Int * (Array Int * Int)
nextPermLoop = \args ->
  let perm = fst args in
  let rest1 = snd args in
  let count = fst rest1 in
  let in_ = snd rest1 in
  let i = fst in_ in
  let n = snd in_ in
  -- Check if i >= n (done with all permutations)
  let diff = sub@AR (n, i) in
  case ifZero@C diff of {
    Left atEnd ->
      -- i >= n: no more permutations
      (perm, (count, 1));
    Right notAtEnd ->
      -- Rotate perm[0..i]: move first element to position i
      let perm1 = rotate@DA (perm, i) in
      -- Increment count[i]
      let ci = unsafeRead@A (count, i) in
      let ci1 = add@AR (ci, 1) in
      let count1 = unsafeWrite@A (count, (i, ci1)) in
      -- Check if count[i] > i (need to reset and try next i)
      -- lt returns 1 if first < second, 0 otherwise
      let ciGtI = lt@AR (i, ci1) in
      case ifZero@C ciGtI of {
        Left ciLeI ->
          -- ci1 <= i: we have a new permutation (isDone = 0)
          (perm1, (count1, 0));
        Right ciGtITrue ->
          -- ci1 > i: reset count[i] to 0 and try next i
          let count2 = unsafeWrite@A (count1, (i, 0)) in
          let i1 = add@AR (i, 1) in
          nextPermLoop (perm1, (count2, (i1, n)))
      }
  }

-- | Generate next permutation (pure)
-- Input: (perm, (count, n))
-- Returns: (perm, (count, isDone))
nextPerm : Array Int * (Array Int * Int) -> Array Int * (Array Int * Int)
nextPerm = \args ->
  let perm = fst args in
  let rest1 = snd args in
  let count = fst rest1 in
  let n = snd rest1 in
  -- Start loop at i = 1
  nextPermLoop (perm, (count, (1, n)))

------------------------------------------------------------------------
-- Main fannkuch loop (pure array operations)
------------------------------------------------------------------------

-- | State for fannkuch: (perm, (work, (count, (n, (permNum, (checksum, maxFlips))))))
-- All in one tuple, threaded through

-- | Main iteration: process all permutations (pure)
-- Input: state = (perm, (work, (count, (n, (permNum, (checksum, maxFlips))))))
-- Returns: final state
-- D047: Tail-recursive (calls itself in tail position)
fannkuchLoop : Array Int * (Array Int * (Array Int * (Int * (Int * (Int * Int)))))
           ->> Array Int * (Array Int * (Array Int * (Int * (Int * (Int * Int)))))
fannkuchLoop = \state ->
  let perm = fst state in
  let rest1 = snd state in
  let work = fst rest1 in
  let rest2 = snd rest1 in
  let count = fst rest2 in
  let rest3 = snd rest2 in
  let n = fst rest3 in
  let rest4 = snd rest3 in
  let permNum = fst rest4 in
  let rest5 = snd rest4 in
  let checksum = fst rest5 in
  let maxFlips = snd rest5 in
  -- Count flips for current permutation
  let flipResult = countFlips (perm, (work, n)) in
  let work1 = fst flipResult in
  let flips = snd flipResult in
  -- Update checksum: + if even permNum, - if odd
  let permMod2 = mod@AR (permNum, 2) in
  let delta = case ifZero@C permMod2 of {
    Left isEven -> flips;
    Right isOdd -> neg@AR flips
  } in
  let checksum1 = add@AR (checksum, delta) in
  -- Update maxFlips
  let maxFlips1 = max@AR (maxFlips, flips) in
  -- Increment permNum
  let permNum1 = add@AR (permNum, 1) in
  -- Generate next permutation
  let nextResult = nextPerm (perm, (count, n)) in
  let perm1 = fst nextResult in
  let countDone = snd nextResult in
  let count1 = fst countDone in
  let isDone = snd countDone in
  -- Build updated state
  let newState = (perm1, (work1, (count1, (n, (permNum1, (checksum1, maxFlips1)))))) in
  -- Check if done
  case ifZero@C isDone of {
    Left notDone -> fannkuchLoop newState;
    Right done -> newState
  }

------------------------------------------------------------------------
-- Main entry point
------------------------------------------------------------------------

main : IO Unit
main =
  -- Get n from command line
  let argc_ = argc@AV () in
  let checkArgc = lt@AR (argc_, 2) in
  case ifZero@C checkArgc of {
    Left hasArg ->
      -- Parse n
      let nStr = argv@AV 1 in
      let n = parseInt@C nStr in
      -- Allocate arrays
      let perm = allocIntArray@M n in
      let work = allocIntArray@M n in
      let count = allocIntArray@M n in
      -- Initialize perm to [0, 1, ..., n-1]
      let perm1 = initRange@DA (perm, n) in
      -- Initialize count to zeros
      let count1 = fill@DA (count, (0, n)) in
      -- Build initial state: (perm, (work, (count, (n, (permNum, (checksum, maxFlips))))))
      let initState = (perm1, (work, (count1, (n, (0, (0, 0)))))) in
      -- Run main loop
      let finalState = fannkuchLoop initState in
      -- Extract results
      let finalRest = snd (snd (snd (snd finalState))) in
      let permNum = fst finalRest in
      let checksum = fst (snd finalRest) in
      let maxFlips = snd (snd finalRest) in
      -- Print results (matching benchmark format)
      let checksumStr = intToString@C checksum in
      let maxFlipsStr = intToString@C maxFlips in
      let nStr2 = intToString@C n in
      -- Build effect chain: arr lifts pure value, >>> composes effects
      arr (\_ -> checksumStr) >>> println@F
        >>> arr (\_ -> "Pfannkuchen(") >>> print@F
        >>> arr (\_ -> nStr2) >>> print@F
        >>> arr (\_ -> ") = ") >>> print@F
        >>> arr (\_ -> maxFlipsStr) >>> println@F;
    Right noArg ->
      arr (\_ -> "Usage: fannkuch <n>") >>> println@F
  }
