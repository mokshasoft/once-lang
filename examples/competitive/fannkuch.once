-- fannkuch.once: Fannkuch-redux benchmark (D040, D042)
--
-- Benchmarks Game: https://benchmarksgame-team.pages.debian.net/benchmarksgame/
--
-- Uses typed arrays (D042) and recursion (D040) to implement
-- the algorithm entirely in Once, without benchmark-specific C primitives.
--
-- Expected output for n=7:
--   228
--   Pfannkuchen(7) = 16
--
-- Build:
--   cd compiler && stack exec -- once build --exe \
--     --strata ../Strata ../examples/competitive/fannkuch.once -o ../.build/fannkuch
--   gcc -o ../.build/fannkuch ../.build/fannkuch.c
--   ../.build/fannkuch 7
--
-- Algorithm:
--   1. Parse n from command line
--   2. Initialize perm array [0, 1, ..., n-1]
--   3. Iterate through all n! permutations (Heap's algorithm)
--   4. For each permutation, count pancake flips
--   5. Accumulate checksum and track max flips
--   6. Print results

import I.Linux.Memory as M
import I.Linux.Array as A
import I.Linux.Control as C
import I.Linux.Arith as AR
import I.Linux.Argv as AV
import I.Linux.File as F
import D.Array as DA

