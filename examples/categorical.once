-- categorical.once: pure categorical combinators (a library, no `main`)
--
-- Only the generators: identity, projections, pairing. With no `main` the
-- build is a library: it emits assembly and stops.
--
-- Build (from the repository root):
--   once build examples/categorical.once -o categorical      # categorical.s
--   once build --target riscv64 examples/categorical.once -o categorical

-- Identity function
identity : Unit -> Unit
identity = id

-- First projection: (A * B) -> A
projFirst : (Unit * Unit) -> Unit
projFirst = fst

-- Second projection: (A * B) -> B
projSecond : (Unit * Unit) -> Unit
projSecond = snd

-- Diagonal/copy: A -> (A * A) using pair combinator
diagonal : Unit -> (Unit * Unit)
diagonal = pair id id