-- Categorical programs (pure, no primitives)
-- Used to test native code generation via verified generators
--
-- These examples use only categorical combinators and can be compiled
-- to native assembly using the verified code generators:
--
--   once build --target arm64 examples/categorical.once -o .build/output
--   once build --target x86_64 examples/categorical.once -o .build/output
--   once build --target riscv64 examples/categorical.once -o .build/output
--
-- Note: Native targets only support pure categorical expressions.
-- Use --target c for full language support (primitives, strings, etc.)

-- Identity function
identity : Unit -> Unit
identity = id

-- First projection: (A * B) -> A
projFirst : (Unit * Unit) -> Unit
projFirst = fst

-- Second projection: (A * B) -> B
projSecond : (Unit * Unit) -> Unit
projSecond = snd

-- Diagonal/copy: A -> (A * A) using pair combinator
diagonal : Unit -> (Unit * Unit)
diagonal = pair id id