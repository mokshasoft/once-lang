-- let-test.once: let bindings
--
--   let x = e in body
--
-- Several bindings nest: `let a = e1 in let b = e2 in body`.
--
-- single 4 = 5 * 5 = 25; multiple 5 = 10 + 13 = 23; exits with 48.
--
-- Build and run (from the repository root):
--   once build examples/let-test.once -o let-test
--   ./let-test; echo $?        # 48

import I.Linux.Syscalls as S

single : Int -> Int
single x = let y = x + 1 in y * y

multiple : Int -> Int
multiple x = let a = x * 2 in let b = a + 3 in a + b

main : Act Unit Void
main = exit@S (single 4 + multiple 5)
