-- let-test.once: Test let bindings
--
-- Demonstrates let expression syntax.
--
-- Single binding:
--   let x = e in body
--
-- Multiple bindings (semicolon separated, desugars to nested lets):
--   let x = e1; y = e2 in body
--
-- Build and run:
--   cd compiler && stack exec -- once build --exe --strata ../Strata ../examples/let-test.once -o ../.build/let-test
--   ../.build/let-test

import I.Linux.File as F

-- Test: single binding
test_single : IO Unit
test_single = let msg = "Single binding works!" in effCompose (println@F) (pure msg)

-- Test: multiple bindings (semicolon separated)
-- Later bindings can reference earlier ones
test_multi : IO Unit
test_multi = let greeting = "Hello"; target = "Multiple bindings work!" in effCompose (println@F) (pure target)

-- Main runs the multi-binding test
main : IO Unit
main = test_multi