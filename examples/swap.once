-- swap.once: a pure library (no `main`)
--
-- Demonstrates:
--   - Products (a * b)
--   - Projections (fst, snd)
--   - Pairing (pair)
--   - Polymorphism (a, b are type variables — LOWERCASE; uppercase names like
--     Int/Unit are concrete types)
--
-- A polymorphic definition has no code of its own; it is compiled where it is
-- used at a concrete type, here `swapInts`.
--
-- Build (from the repository root):
--   once build examples/swap.once -o swap      # swap.s

swap : a * b -> b * a
swap = pair snd fst

swapInts : Int * Int -> Int * Int
swapInts = swap
