-- swap.once
-- Once "hello world" - a pure library with C interface
--
-- Demonstrates:
--   - Products (a * b)
--   - Projections (fst, snd)
--   - Pairing (pair)
--   - Polymorphism (a, b are type variables — LOWERCASE; uppercase names like
--     Int/Unit are concrete types)
--
-- No primitives - pure natural transformations only.

swap : a * b -> b * a
swap = pair snd fst