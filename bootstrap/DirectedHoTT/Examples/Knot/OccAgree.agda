-- ★★★ THE STATEMENT QUANTIFIES THE LEVEL, NOT A SECOND VARIABLE.
--   `agree-var x y i` with both in `Var Γ` is UNPROVABLE: `cVar-vs`
--   descends to `enVar y'` with `y' : Var Γ` while `x : Var (Γ ∙)`, and
--   a `vz` has no counterpart in `Γ`.  See `LVL-ATTEMPTS.md`.
------------------------------------------------------------------------
agree-var {Γ ∙} k vz i =
  ⟶*-appˡ (ihead-red KnotD occMethsK tagVar-vz i
             (pair (num (len Γ))
                   (pair (idrefl ⌜Nat⌝ sVar)
                         (pair (idrefl ⌜Nat⌝ (nsuc (num (len Γ)))) unit)))
             sel-vz
             (⟶*-appˡ (⟶*-appˡ (step (β _ _) done)) »
              ⟶*-appˡ (step (β _ _) done) »
              step (β _ _) done))
  » step (β _ _) done
  -- ⚠ `fst p` has passed THREE binders, so it is not literally
  --   `num (len Γ)` — it only REDUCES there.  `eqNat-red` takes the
  --   reduction; `eqNat-num` (literal numerals) cannot be used, and
  --   cannot be patched at the call site because `eqNatTm` mentions its
  --   argument twice.
  » eqNat-red k (len Γ) done
      (step (βfst _ _) done » ⟶*-castᵣ (num-stable _ _ _ _ (len _)) done)

-- ★ `cVar-vs` IS GENERIC — `lvl (vs y) = lvl y`, which is exactly what
--   the fold returns, so there is no cast at all.  (With de Bruijn
--   INDICES this row would have needed a shift; `Knot/Occ`'s header
--   says so, and this is where it is cashed.)
agree-var {Γ ∙} k (vs y) i =
  ⟶*-appˡ (ihead-red KnotD occMethsK tagVar-vs i
             (pair (num (len Γ))
                   (pair (enVar y)
                         (pair (idrefl ⌜Nat⌝ sVar)
                               (pair (idrefl ⌜Nat⌝ (nsuc (num (len Γ)))) unit))))
             sel-vs
             (⟶*-appˡ (⟶*-appˡ (step (β _ _) done)) »
              ⟶*-appˡ (step (β _ _) done) »
              step (β _ _) done))
  » occSum-red (num k) (ilookupD KnotD tagVar-vs)
      (aih-κ (aih-ρ (b2n (eqℕ k (lvl y)))
                (⟶*-appˡ (step (βfst _ _) done »
                       ⟶*-ielimᵗ ((⟶*-fst (⟶*-snd done » step (βsnd _ _) done)
                                   » step (βfst _ _) done)))
                 » agree-var k y _)
                (aih-κ (aih-κ aih-ι))))
