-- ⚠ every `_` spelled out (`meta-standing-for-a-computation`)
occ-head-red : {Γ' : Cx} (k : ℕ) → sel k (occMethsK {Γ'}) ⟶* occAt k →
               (i p : RTm Γ') {u : RTm Γ'} →
               app (app (app (occAt k) i) p)
                   (iihs KnotD occMethsK (isingle i) (ilookupD KnotD k) p) ⟶* u →
               ielim KnotD i occMethsK (icon k p) ⟶* u
occ-head-red k sp i p h = ihead-red KnotD occMethsK k i p sp h

