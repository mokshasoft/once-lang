from-toTm (ordtr a0 a1 a2 a3 a4) = c5 ordtr (from-toTm a0) (from-toTm a1) (from-toTm a2) (from-toTm a3) (from-toTm a4)
from-toTm (fst a0) = cong fst (from-toTm a0)
from-toTm (snd a0) = cong snd (from-toTm a0)
from-toTm ⌜base⌝ = refl
from-toTm (⌜Π⌝ a0 a1) = cong₂ ⌜Π⌝ (from-toTm a0) (from-toTm a1)
from-toTm (⌜Σ⌝ a0 a1) = cong₂ ⌜Σ⌝ (from-toTm a0) (from-toTm a1)
from-toTm (⌜Hom⌝ a0 a1 a2) = c3 ⌜Hom⌝ (from-toTm a0) (from-toTm a1) (from-toTm a2)
from-toTm (hrefl a0 a1) = cong₂ hrefl (from-toTm a0) (from-toTm a1)
from-toTm (tr a0 a1 a2) = c3 tr (from-toTm a0) (from-toTm a1) (from-toTm a2)
from-toTm (ap a0 a1 a2) = c3 ap (from-toTm a0) (from-toTm a1) (from-toTm a2)
from-toTm (⌜Id⌝ a0 a1 a2) = c3 ⌜Id⌝ (from-toTm a0) (from-toTm a1) (from-toTm a2)
from-toTm (idrefl a0 a1) = cong₂ idrefl (from-toTm a0) (from-toTm a1)
from-toTm (jsub a0 a1 a2) = c3 jsub (from-toTm a0) (from-toTm a1) (from-toTm a2)
from-toTm unit = refl
from-toTm nzero = refl
from-toTm (nsuc a0) = cong nsuc (from-toTm a0)
from-toTm (natrec a0 a1 a2) = c3 natrec (from-toTm a0) (from-toTm a1) (from-toTm a2)
from-toTm (con a0) = cong con (from-toTm a0)
from-toTm (ielim a0 a1 a2 a3) = c4 ielim (from-toTm a0) (from-toTm a1) (from-toTm a2) (from-toTm a3)
from-toTm dι = refl
from-toTm (dσ a0 a1) = cong₂ dσ (from-toTm a0) (from-toTm a1)
from-toTm (dρ a0 a1) = cong₂ dρ (from-toTm a0) (from-toTm a1)
from-toTm (dpay a0 a1 a2) = c3 dpay (from-toTm a0) (from-toTm a1) (from-toTm a2)
from-toTm (dih a0 a1 a2 a3) = c4 dih (from-toTm a0) (from-toTm a1) (from-toTm a2) (from-toTm a3)
from-toTm fzero = refl
from-toTm (fsuc a0) = cong fsuc (from-toTm a0)
from-toTm (fcase a0 a1 a2) = c3 fcase (from-toTm a0) (from-toTm a1) (from-toTm a2)
from-toTm (fcase0 a0) = cong fcase0 (from-toTm a0)
from-toTm (psplit a0 a1) = cong₂ psplit (from-toTm a0) (from-toTm a1)
from-toTm ⌜Nat⌝ = refl
from-toTm (⌜IMu⌝ a0 a1 a2) = c3 ⌜IMu⌝ (from-toTm a0) (from-toTm a1) (from-toTm a2)
from-toTm (⌜Fin⌝ a0) = cong ⌜Fin⌝ refl
from-toTm ⌜Unit⌝ = refl
from-toTm (ref a0 a1) = cong₂ ref refl (from-toTm a1)

------------------------------------------------------------------------
-- 3. ★ THE THEOREMS.
------------------------------------------------------------------------

-- a closed normal Knot type / term IS a quote
unqTy : {n : RTm ε} → ◇ ⊢ n ∷ K 0 (dep Γ) → IsNormal n → Σ (RTy Γ) (λ A → n ≡ quoteTy A)
unqTy {Γ = Γ} dn nrm with syn-unquote KOK nthᵍ-z (⊢-cast (cong (K 0) (dep-num Γ)) dn) nrm
... | x , eq = fromTy x , trans eq (sym (quote-fromTy x))

unqTm : {n : RTm ε} → ◇ ⊢ n ∷ K 1 (dep Γ) → IsNormal n → Σ (RTm Γ) (λ u → n ≡ quoteTm u)
unqTm {Γ = Γ} dn nrm with syn-unquote KOK (nthᵍ-s nthᵍ-z) (⊢-cast (cong (K 1) (dep-num Γ)) dn) nrm
... | x , eq = fromTm x , trans eq (sym (quote-fromTm x))

-- quotation is injective
quoteTy-inj : (A B : RTy Γ) → quoteTy A {Θ} ≡ quoteTy B → A ≡ B
quoteTy-inj A B e =
  trans (sym (from-toTy A))
    (trans (cong fromTy (⌜⌝ˢ-inj (toTy A) (toTy B) (trans (quote-toTy A) (trans e (sym (quote-toTy B))))))
           (from-toTy B))

quoteTm-inj : (u v : RTm Γ) → quoteTm u {Θ} ≡ quoteTm v → u ≡ v
quoteTm-inj u v e =
  trans (sym (from-toTm u))
    (trans (cong fromTm (⌜⌝ˢ-inj (toTm u) (toTm v) (trans (quote-toTm u) (trans e (sym (quote-toTm v))))))
           (from-toTm v))
