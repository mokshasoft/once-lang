-- ★★★ `sz` OVER THE WHOLE KNOT.
szTm : {Γ : Cx} → RTm Γ → RTm Γ → RTm Γ
szTm i t = ielim KnotD i szMeths t

⊢szTm : {Γ : Ctx} {i t : RTm ⌊ Γ ⌋} →
        Γ ⊢ i ∷ Σ' Nat Nat → Γ ⊢ t ∷ K i → Γ ⊢ szTm i t ∷ Nat
⊢szTm di dt = ⊢ielim KnotWf ty-Nat di ⊢szMeths dt
