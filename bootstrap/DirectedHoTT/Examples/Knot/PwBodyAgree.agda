     » sel-there 19 _ _ (methsAt-past (cdTake 1 PD21) {mth = pwDefault} 21 18
     » sel-there 17 _ _ (methsAt-sel (cdTake 30 PD23) {mth = pwDefault} 23 17 (inCD (cdTake 30 PD23) 17 tt)))) i _
    (chainOf (evSpine 3 _))
  » ⟶*-castₗ (pwDef-w² IHS PAY i tagTm-cUnit)
      (  ⟶*-appˡ (⟶*-appˡ (⟶*-ielimⁱ hi))
      »  ⟶*-appˡ (⟶*-appʳ (⟶*-nsuc hd))
      »  ren-agree {ρ = vs} (rep {Γ = Γ} hd) ⌜Unit⌝ )
  where
    PAY : RTm _
    PAY = (pair (idrefl ⌜Nat⌝ sTm) unit)
    IHS : RTm _
    IHS = iihs KnotD pwBodyMethsK (isingle i)
                 (ilookupD KnotD tagTm-cUnit) PAY
    hd : snd i ⟶* num (len Γ)
    hd = ⟶*-snd hi » step (βsnd _ _) done

-- ★★★ ROW 20 — `pwBody (⌜Π⌝ γ δ) = δ`.
--
-- ⚠⚠ THE `jsub`/`symN` WRAPPER COSTS ALMOST NOTHING, because
--   `jsub-refl : jsub d (idrefl c s) e ⟶ e` IGNORES THE MOTIVE.
--   `pwPi`'s motive mentions the index under the `jsub` binder — a
--   THIRD tower, at a third depth — and none of it has to be
--   normalised: reduce the PROOF to an `idrefl` and the rule fires.
--   `symN a p = jsub (⌜Id⌝ ⌜Nat⌝ (var vz) (w a)) p (reflN a)`, so the
--   inner `jsub` fires as soon as the payload's FORD is exposed, and
--   it answers `idrefl ⌜Nat⌝ (fst i)` — already an `idrefl`, whatever
--   `fst i` is.  ⇒ two `jsub-refl`s, and the index is never touched.
pwb-agree {Γ} i hi (⌜Π⌝ y0 y1) =
  head-red tagTm-cPi
    (methsAt-past (cdTake 20 KnotD) {mth = pwDefault} 0 0 » sel-here _ _) i _
    (chainOf (evSpine 3 _))
  » ⟶*-jsubᵖ ( ⟶*-jsubᵖ
                 (⟶*-castₗ (cong (λ w → fst (snd (snd w)))
                                 (wk-single {v = IHS} PAY))
                    (⟶*-fst (⟶*-snd (chainOf (evProj 1 _))
                             » step (βsnd _ _) done) » step (βfst _ _) done))
             » step (jsub-refl _ _ _ _) done )
  » step (jsub-refl _ _ _ _) done
  » ⟶*-castₗ (cong (λ w → fst (snd w)) (wk-single {v = IHS} PAY))
      (chainOf (evProj 2 _))
  where
    PAY : RTm _
    PAY = pair (enTm y0) (pair (enTm y1) (pair (idrefl ⌜Nat⌝ sTm) unit))
    IHS : RTm _
    IHS = iihs KnotD pwBodyMethsK (isingle i) (ilookupD KnotD tagTm-cPi) PAY

-- ★★★ ROW 22 — the ONE row that recurses.
--
--     pwBody (⌜Hom⌝ C a b) = ⌜Hom⌝ (pwBody C) (app (w a) vz) (app (w b) vz)
--
-- ⚠ THREE SOURCES IN ONE TERM: the code from the IH, the endpoints
--   from the PAYLOAD (weakened, then applied to the new variable).
--   `Knot/PwBody`'s header says a fold that only read its IH tuple
--   could not write this row, and the proof shows it — the code slot
--   is the IH, the endpoint slots are `ren-agree` AGAIN, because
--   `wkTmK` IS `renTmAtK` at `vsRenK`.
pwb-agree {Γ} i hi (⌜Hom⌝ y0 y1 y2) =
  head-red tagTm-cHom
    (methsAt-past (cdTake 20 KnotD) {mth = pwDefault} 0 2
     » sel-there 1 _ _ (methsAt-past (cdTake 1 PD21) {mth = pwDefault} 21 0
     » sel-here _ _)) i _
    (chainOf (evSpine 3 _))
  » ⟶*-jsubᵖ ( ⟶*-jsubᵖ
                 (⟶*-castₗ (cong (λ w → fst (snd (snd (snd w))))
                                 (wk-single {v = IHS} PAY))
                    (⟶*-fst (⟶*-snd (⟶*-snd (chainOf (evProj 1 _))
                                     » step (βsnd _ _) done)
                             » step (βsnd _ _) done) » step (βfst _ _) done))
             » step (jsub-refl _ _ _ _) done )
  » step (jsub-refl _ _ _ _) done
  -- ★ ONE cast for the whole row: the index at two rungs, the payload at
  --   one.  The IH tuple is the INNERMOST binder and owes nothing.
  » ⟶*-castₗ (homBody-w² IHS PAY i)
    (  -- the CODE slot — the IH
       ⟶*-icon (⟶*-pairˡ
         (step (βfst _ _) done
          » ⟶*-ielimᵗ (step (βfst _ _) done)
          » pwb-agree _ (⟶*-pairʳ hd) y0))
       -- the FIRST endpoint
    »  ⟶*-icon (⟶*-pairʳ (⟶*-pairˡ
         (⟶*-icon (⟶*-pairˡ
            (  ⟶*-appˡ (⟶*-appˡ (⟶*-ielimⁱ (⟶*-pairʳ hd)))
            »  ⟶*-appˡ (⟶*-appʳ (⟶*-nsuc hd))
            »  ⟶*-appˡ (⟶*-appˡ (⟶*-ielimᵗ (⟶*-fst (chainOf (evProj 1 _))
                          » step (βfst _ _) done)))
            »  ren-agree {ρ = vs} (rep {Γ = Γ} hd) y1))
          » ⟶*-icon (⟶*-pairʳ (⟶*-pairˡ
              (⟶*-icon (⟶*-pairˡ (⟶*-Var-vzKᵈ hd))))))))
       -- the SECOND endpoint
    »  ⟶*-icon (⟶*-pairʳ (⟶*-pairʳ (⟶*-pairˡ
         (⟶*-icon (⟶*-pairˡ
            (  ⟶*-appˡ (⟶*-appˡ (⟶*-ielimⁱ (⟶*-pairʳ hd)))
            »  ⟶*-appˡ (⟶*-appʳ (⟶*-nsuc hd))
            »  ⟶*-appˡ (⟶*-appˡ (⟶*-ielimᵗ (⟶*-fst (⟶*-snd (chainOf (evProj 1 _))
                                  » step (βsnd _ _) done)
                          » step (βfst _ _) done)))
            »  ren-agree {ρ = vs} (rep {Γ = Γ} hd) y2))
          » ⟶*-icon (⟶*-pairʳ (⟶*-pairˡ
              (⟶*-icon (⟶*-pairˡ (⟶*-Var-vzKᵈ hd))))))))))
  where
    PAY : RTm _
    PAY = pair (enTm y0) (pair (enTm y1)
                 (pair (enTm y2) (pair (idrefl ⌜Nat⌝ sTm) unit)))
    IHS : RTm _
    IHS = iihs KnotD pwBodyMethsK (isingle i) (ilookupD KnotD tagTm-cHom) PAY
    hd : snd i ⟶* num (len Γ)
    hd = ⟶*-snd hi » step (βsnd _ _) done

------------------------------------------------------------------------
-- ★★★ AT THE LEDGER'S NAMES.
--
-- ⚠ TWO ENTRIES, NOT ONE.  `pwDefault` is a METHOD, not a directly
--   applied program, so its adequacy only means anything relative to
--   `pwBodyK`'s fold — which is exactly what the 28 default rows above
--   are.  It is discharged BY them, not beside them.
------------------------------------------------------------------------
pwBodyK-agree : {Γ Θ : Cx} (t : RTm Γ) →
                pwBodyK (pair sTm (num (len Γ))) (enTm {Γ} {Θ} t)
                ⟶* enTm {Γ ∙} {Θ} (pwBody t)
pwBodyK-agree t = pwb-agree (pair sTm (num (len _))) done t
