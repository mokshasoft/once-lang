fst (pair a b) ⁺   = a ⁺
fst (var x) ⁺      = fst (var x ⁺)
fst (lam t) ⁺      = fst (lam t ⁺)
fst (app f a) ⁺    = fst (app f a ⁺)
fst (fst p) ⁺      = fst (fst p ⁺)
fst (snd p) ⁺      = fst (snd p ⁺)
fst ⌜Nat⌝ ⁺        = fst (⌜Nat⌝ ⁺)
fst ⌜Unit⌝ ⁺       = fst (⌜Unit⌝ ⁺)
fst ⌜base⌝ ⁺       = fst (⌜base⌝ ⁺)
fst unit ⁺         = fst (unit ⁺)
fst nzero ⁺        = fst (nzero ⁺)
fst (nsuc n) ⁺     = fst (nsuc n ⁺)
fst (ordtr a t u p q) ⁺ = fst (ordtr a t u p q ⁺)
fst (absurd c f) ⁺ = fst (absurd (c ⁺) (f ⁺))
fst (natrec z s n) ⁺ = fst (natrec z s n ⁺)
fst (⌜Π⌝ c d) ⁺    = fst (⌜Π⌝ c d ⁺)
fst (⌜Σ⌝ c d) ⁺    = fst (⌜Σ⌝ c d ⁺)
fst (⌜Hom⌝ c a b) ⁺ = fst (⌜Hom⌝ c a b ⁺)
fst (hrefl c t) ⁺   = fst (hrefl c t ⁺)
