// ======================================================================
// seL4 IPC Primitives - RISC-V64 Implementation
// ======================================================================
//
// seL4 RISC-V64 syscall convention (standard RISC-V ABI):
//   a7: Syscall number (negative for seL4: -1 to -8)
//   a0: Capability (destination/source endpoint)
//   a1: MessageInfo (packed word)
//   a2: Message Register 0
//   a3: Message Register 1
//   a4: Message Register 2
//   a5: Message Register 3
//
// Syscall invocation: ecall
//
// On return:
//   a0: Badge (for Recv) or unchanged
//   a1: MessageInfo (for Recv/Call)
//   a2-a5: Message Registers 0-3
//
// Once calling convention (RISC-V LP64 ABI):
//   a0: First argument (pointer to tuple for multi-arg)
//   a0: Return value (pointer to tuple for multi-return)
//   s0-s11: Callee-saved registers
//   ra: Return address
//
// Once tuple layout (nested pairs):
//   (a, b, c, d) = (a, (b, (c, d)))
//   Each pair: [fst: 8 bytes][snd: 8 bytes]
//
// ======================================================================

.text
.align 2

#ifndef ONCE_SEL4_RISCV64_DEFINED
#define ONCE_SEL4_RISCV64_DEFINED

// ======================================================================
// seL4 Syscall Numbers
// ======================================================================
.equ SEL4_SYS_SEND,       -1
.equ SEL4_SYS_NBSEND,     -2
.equ SEL4_SYS_RECV,       -3
.equ SEL4_SYS_REPLY,      -4
.equ SEL4_SYS_REPLYRECV,  -5
.equ SEL4_SYS_CALL,       -6
.equ SEL4_SYS_YIELD,      -7
.equ SEL4_SYS_NBRECV,     -8

// ----------------------------------------------------------------------
// seL4_Yield - Yield remaining timeslice
// ----------------------------------------------------------------------
// Input: Unit (ignored)
// Output: Unit (returns 0)
// Simplest syscall - good for testing

.global once_seL4_Yield
.type once_seL4_Yield, @function
once_seL4_Yield:
    addi    sp, sp, -16
    sd      ra, 8(sp)
    sd      s0, 0(sp)
    addi    s0, sp, 16

    // Syscall number for seL4_Yield
    li      a7, SEL4_SYS_YIELD

    // Trap to seL4 kernel
    ecall

    // Return Unit (0)
    li      a0, 0

    ld      s0, 0(sp)
    ld      ra, 8(sp)
    addi    sp, sp, 16
    ret
.size once_seL4_Yield, .-once_seL4_Yield

// ----------------------------------------------------------------------
// seL4_Send - Send message to endpoint (blocking)
// ----------------------------------------------------------------------
// Input: (cap, msgInfo, mr0, mr1, mr2, mr3) as nested tuple
// Output: Unit

.global once_seL4_Send
.type once_seL4_Send, @function
once_seL4_Send:
    addi    sp, sp, -16
    sd      ra, 8(sp)
    sd      s0, 0(sp)
    addi    s0, sp, 16

    // Unpack nested tuple: (cap, (msgInfo, (mr0, (mr1, (mr2, mr3)))))
    // a0 points to first pair
    ld      t0, 0(a0)           // t0 = cap
    ld      a0, 8(a0)           // a0 = ptr to rest

    ld      t1, 0(a0)           // t1 = msgInfo
    ld      a0, 8(a0)           // a0 = ptr to rest

    ld      a2, 0(a0)           // a2 = mr0
    ld      a0, 8(a0)           // a0 = ptr to rest

    ld      a3, 0(a0)           // a3 = mr1
    ld      a0, 8(a0)           // a0 = ptr to rest

    ld      a4, 0(a0)           // a4 = mr2
    ld      a5, 8(a0)           // a5 = mr3

    // Set up seL4 registers
    mv      a0, t0              // a0 = capability
    mv      a1, t1              // a1 = msgInfo
    // a2-a5 already have MRs

    // Syscall number for seL4_Send
    li      a7, SEL4_SYS_SEND

    // Trap to kernel
    ecall

    // Return Unit
    li      a0, 0

    ld      s0, 0(sp)
    ld      ra, 8(sp)
    addi    sp, sp, 16
    ret
.size once_seL4_Send, .-once_seL4_Send

// ----------------------------------------------------------------------
// seL4_NBSend - Non-blocking send
// ----------------------------------------------------------------------
// Same as seL4_Send but with syscall number -2

.global once_seL4_NBSend
.type once_seL4_NBSend, @function
once_seL4_NBSend:
    addi    sp, sp, -16
    sd      ra, 8(sp)
    sd      s0, 0(sp)
    addi    s0, sp, 16

    // Unpack tuple (same as seL4_Send)
    ld      t0, 0(a0)
    ld      a0, 8(a0)
    ld      t1, 0(a0)
    ld      a0, 8(a0)
    ld      a2, 0(a0)
    ld      a0, 8(a0)
    ld      a3, 0(a0)
    ld      a0, 8(a0)
    ld      a4, 0(a0)
    ld      a5, 8(a0)

    mv      a0, t0
    mv      a1, t1

    // Syscall number for seL4_NBSend
    li      a7, SEL4_SYS_NBSEND

    ecall

    li      a0, 0

    ld      s0, 0(sp)
    ld      ra, 8(sp)
    addi    sp, sp, 16
    ret
.size once_seL4_NBSend, .-once_seL4_NBSend

// ----------------------------------------------------------------------
// seL4_Recv - Wait for message on endpoint (blocking)
// ----------------------------------------------------------------------
// Input: (src, reply) as pair
// Output: (badge, msgInfo, mr0, mr1, mr2, mr3) as nested tuple
//
// Returns tuple allocated on stack

.global once_seL4_Recv
.type once_seL4_Recv, @function
once_seL4_Recv:
    addi    sp, sp, -64
    sd      ra, 56(sp)
    sd      s0, 48(sp)
    sd      s1, 40(sp)
    sd      s2, 32(sp)
    sd      s3, 24(sp)
    sd      s4, 16(sp)
    addi    s0, sp, 64

    // Unpack input: (src, reply)
    ld      t0, 0(a0)           // t0 = src (endpoint cap)
    // [a0+8] = reply cap (MCS kernel, not used in syscall on master)

    // Set up seL4 registers
    mv      a0, t0              // a0 = endpoint capability

    // Syscall number for seL4_Recv
    li      a7, SEL4_SYS_RECV

    // Trap to kernel
    ecall

    // On return:
    // a0 = badge, a1 = msgInfo, a2-a5 = mr0-mr3

    // Save return values to callee-saved registers
    mv      s1, a0              // badge
    mv      s2, a1              // msgInfo
    mv      s3, a2              // mr0
    mv      s4, a3              // mr1
    // a4, a5 still have mr2, mr3

    // Build result tuple on stack
    // Layout: 6 words = 48 bytes for nested pairs
    // (badge, (msgInfo, (mr0, (mr1, (mr2, mr3)))))
    addi    sp, sp, -80         // Space for 5 pairs (each 16 bytes)

    // Innermost pair: (mr2, mr3)
    sd      a4, 64(sp)          // mr2
    sd      a5, 72(sp)          // mr3

    // (mr1, ptr_to_mr2_mr3)
    addi    t0, sp, 64          // ptr to (mr2, mr3)
    sd      s4, 48(sp)          // mr1
    sd      t0, 56(sp)          // ptr

    // (mr0, ptr_to_rest)
    addi    t0, sp, 48
    sd      s3, 32(sp)          // mr0
    sd      t0, 40(sp)          // ptr

    // (msgInfo, ptr_to_rest)
    addi    t0, sp, 32
    sd      s2, 16(sp)          // msgInfo
    sd      t0, 24(sp)          // ptr

    // (badge, ptr_to_rest)
    addi    t0, sp, 16
    sd      s1, 0(sp)           // badge
    sd      t0, 8(sp)           // ptr

    // Return pointer to outermost pair
    mv      a0, sp

    addi    sp, sp, 80
    ld      s4, 16(sp)
    ld      s3, 24(sp)
    ld      s2, 32(sp)
    ld      s1, 40(sp)
    ld      s0, 48(sp)
    ld      ra, 56(sp)
    addi    sp, sp, 64
    ret
.size once_seL4_Recv, .-once_seL4_Recv

// ----------------------------------------------------------------------
// seL4_NBRecv - Non-blocking receive
// ----------------------------------------------------------------------
// Same as seL4_Recv but with syscall number -8

.global once_seL4_NBRecv
.type once_seL4_NBRecv, @function
once_seL4_NBRecv:
    addi    sp, sp, -64
    sd      ra, 56(sp)
    sd      s0, 48(sp)
    sd      s1, 40(sp)
    sd      s2, 32(sp)
    sd      s3, 24(sp)
    sd      s4, 16(sp)
    addi    s0, sp, 64

    // Unpack input
    ld      t0, 0(a0)
    mv      a0, t0

    li      a7, SEL4_SYS_NBRECV

    ecall

    // Save and build tuple (same as seL4_Recv)
    mv      s1, a0
    mv      s2, a1
    mv      s3, a2
    mv      s4, a3

    addi    sp, sp, -80

    sd      a4, 64(sp)
    sd      a5, 72(sp)

    addi    t0, sp, 64
    sd      s4, 48(sp)
    sd      t0, 56(sp)

    addi    t0, sp, 48
    sd      s3, 32(sp)
    sd      t0, 40(sp)

    addi    t0, sp, 32
    sd      s2, 16(sp)
    sd      t0, 24(sp)

    addi    t0, sp, 16
    sd      s1, 0(sp)
    sd      t0, 8(sp)

    mv      a0, sp

    addi    sp, sp, 80
    ld      s4, 16(sp)
    ld      s3, 24(sp)
    ld      s2, 32(sp)
    ld      s1, 40(sp)
    ld      s0, 48(sp)
    ld      ra, 56(sp)
    addi    sp, sp, 64
    ret
.size once_seL4_NBRecv, .-once_seL4_NBRecv

// ----------------------------------------------------------------------
// seL4_Call - RPC-style send and receive
// ----------------------------------------------------------------------
// Input: (cap, msgInfo, mr0, mr1, mr2, mr3)
// Output: (msgInfo, mr0, mr1, mr2, mr3)

.global once_seL4_Call
.type once_seL4_Call, @function
once_seL4_Call:
    addi    sp, sp, -48
    sd      ra, 40(sp)
    sd      s0, 32(sp)
    sd      s1, 24(sp)
    sd      s2, 16(sp)
    sd      s3, 8(sp)
    addi    s0, sp, 48

    // Unpack input tuple
    ld      t0, 0(a0)           // cap
    ld      a0, 8(a0)
    ld      t1, 0(a0)           // msgInfo
    ld      a0, 8(a0)
    ld      a2, 0(a0)           // mr0
    ld      a0, 8(a0)
    ld      a3, 0(a0)           // mr1
    ld      a0, 8(a0)
    ld      a4, 0(a0)           // mr2
    ld      a5, 8(a0)           // mr3

    mv      a0, t0
    mv      a1, t1
    li      a7, SEL4_SYS_CALL

    ecall

    // Return: a1=msgInfo, a2=mr0, a3=mr1, a4=mr2, a5=mr3
    mv      s1, a1              // msgInfo
    mv      s2, a2              // mr0
    mv      s3, a3              // mr1
    // a4, a5 still have mr2, mr3

    // Build result tuple: (msgInfo, (mr0, (mr1, (mr2, mr3))))
    addi    sp, sp, -64

    sd      a4, 48(sp)          // mr2
    sd      a5, 56(sp)          // mr3

    addi    t0, sp, 48
    sd      s3, 32(sp)          // mr1
    sd      t0, 40(sp)

    addi    t0, sp, 32
    sd      s2, 16(sp)          // mr0
    sd      t0, 24(sp)

    addi    t0, sp, 16
    sd      s1, 0(sp)           // msgInfo
    sd      t0, 8(sp)

    mv      a0, sp

    addi    sp, sp, 64
    ld      s3, 8(sp)
    ld      s2, 16(sp)
    ld      s1, 24(sp)
    ld      s0, 32(sp)
    ld      ra, 40(sp)
    addi    sp, sp, 48
    ret
.size once_seL4_Call, .-once_seL4_Call

// ----------------------------------------------------------------------
// seL4_Reply - Reply to caller
// ----------------------------------------------------------------------
// Input: (msgInfo, mr0, mr1, mr2, mr3)
// Output: Unit

.global once_seL4_Reply
.type once_seL4_Reply, @function
once_seL4_Reply:
    addi    sp, sp, -16
    sd      ra, 8(sp)
    sd      s0, 0(sp)
    addi    s0, sp, 16

    // Unpack: (msgInfo, (mr0, (mr1, (mr2, mr3))))
    ld      a1, 0(a0)           // msgInfo
    ld      a0, 8(a0)
    ld      a2, 0(a0)           // mr0
    ld      a0, 8(a0)
    ld      a3, 0(a0)           // mr1
    ld      a0, 8(a0)
    ld      a4, 0(a0)           // mr2
    ld      a5, 8(a0)           // mr3

    li      a7, SEL4_SYS_REPLY

    ecall

    li      a0, 0

    ld      s0, 0(sp)
    ld      ra, 8(sp)
    addi    sp, sp, 16
    ret
.size once_seL4_Reply, .-once_seL4_Reply

// ----------------------------------------------------------------------
// seL4_ReplyRecv - Atomic reply and receive
// ----------------------------------------------------------------------
// Input: (src, msgInfo, mr0, mr1, mr2, mr3, reply)
// Output: (badge, msgInfo, mr0, mr1, mr2, mr3)

.global once_seL4_ReplyRecv
.type once_seL4_ReplyRecv, @function
once_seL4_ReplyRecv:
    addi    sp, sp, -64
    sd      ra, 56(sp)
    sd      s0, 48(sp)
    sd      s1, 40(sp)
    sd      s2, 32(sp)
    sd      s3, 24(sp)
    sd      s4, 16(sp)
    addi    s0, sp, 64

    // Unpack 7-element tuple
    ld      t0, 0(a0)           // src (endpoint)
    ld      a0, 8(a0)
    ld      t1, 0(a0)           // msgInfo
    ld      a0, 8(a0)
    ld      a2, 0(a0)           // mr0
    ld      a0, 8(a0)
    ld      a3, 0(a0)           // mr1
    ld      a0, 8(a0)
    ld      a4, 0(a0)           // mr2
    ld      a0, 8(a0)
    ld      a5, 0(a0)           // mr3
    // Note: reply cap at 8(a0) - used by MCS kernel

    mv      a0, t0              // endpoint cap
    mv      a1, t1              // msgInfo
    li      a7, SEL4_SYS_REPLYRECV

    ecall

    // Save results and build return tuple (same as Recv)
    mv      s1, a0              // badge
    mv      s2, a1              // msgInfo
    mv      s3, a2              // mr0
    mv      s4, a3              // mr1

    addi    sp, sp, -80

    sd      a4, 64(sp)
    sd      a5, 72(sp)

    addi    t0, sp, 64
    sd      s4, 48(sp)
    sd      t0, 56(sp)

    addi    t0, sp, 48
    sd      s3, 32(sp)
    sd      t0, 40(sp)

    addi    t0, sp, 32
    sd      s2, 16(sp)
    sd      t0, 24(sp)

    addi    t0, sp, 16
    sd      s1, 0(sp)
    sd      t0, 8(sp)

    mv      a0, sp

    addi    sp, sp, 80
    ld      s4, 16(sp)
    ld      s3, 24(sp)
    ld      s2, 32(sp)
    ld      s1, 40(sp)
    ld      s0, 48(sp)
    ld      ra, 56(sp)
    addi    sp, sp, 64
    ret
.size once_seL4_ReplyRecv, .-once_seL4_ReplyRecv

#endif // ONCE_SEL4_RISCV64_DEFINED
