-- | Integer arithmetic primitives for Linux
--
-- These primitives enable numeric computation in Once.
-- Required for competitive programming, algorithms, etc.

------------------------------------------------------------------------
-- Basic Arithmetic (pure - no effects needed)
------------------------------------------------------------------------

-- | Addition
signature add : Int * Int -> Int

-- | Subtraction
signature sub : Int * Int -> Int

-- | Multiplication
signature mul : Int * Int -> Int

-- | Division (integer division, truncated toward zero)
signature div : Int * Int -> Int

-- | Modulo (remainder after division)
signature mod : Int * Int -> Int

-- | Negation
signature neg : Int -> Int

-- | Absolute value
signature abs : Int -> Int

------------------------------------------------------------------------
-- Comparisons (return 0 for false, 1 for true)
------------------------------------------------------------------------

-- | Equal
signature eq : Int * Int -> Int

-- | Not equal
signature neq : Int * Int -> Int

-- | Less than
signature lt : Int * Int -> Int

-- | Less than or equal
signature le : Int * Int -> Int

-- | Greater than
signature gt : Int * Int -> Int

-- | Greater than or equal
signature ge : Int * Int -> Int

------------------------------------------------------------------------
-- Bitwise Operations
------------------------------------------------------------------------

-- | Bitwise AND
signature band : Int * Int -> Int

-- | Bitwise OR
signature bor : Int * Int -> Int

-- | Bitwise XOR
signature bxor : Int * Int -> Int

-- | Bitwise NOT
signature bnot : Int -> Int

-- | Left shift
signature shl : Int * Int -> Int

-- | Right shift (arithmetic)
signature shr : Int * Int -> Int

------------------------------------------------------------------------
-- Min/Max
------------------------------------------------------------------------

-- | Minimum of two integers
signature min : Int * Int -> Int

-- | Maximum of two integers
signature max : Int * Int -> Int