// ======================================================================
// Floating-point Arithmetic Primitives - x86_64 Implementation
// ======================================================================
//
// Double-precision (64-bit) floating-point operations using SSE2.
// Required for n-body, spectral-norm, mandelbrot benchmarks.
//
// Note: Transcendental functions (sin, cos, exp, log, pow) require
// libm or software implementations. This file provides hardware-only
// operations. Use the C implementation for transcendentals.
//
// Calling convention:
// - Float values passed/returned in xmm0 (or via memory for pairs)
// - Pairs passed as pointer to OncePair in rdi
// - Float stored in void* via type punning (same bits as double)
//
// ======================================================================

.text
.align 16

#ifndef ONCE_LINUX_X86_64_FLOAT_DEFINED
#define ONCE_LINUX_X86_64_FLOAT_DEFINED

// ======================================================================
// Basic Arithmetic
// ======================================================================

// ----------------------------------------------------------------------
// fadd - Add two floats
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in rdi
// Output: double in xmm0
.global fadd
.type fadd, @function
fadd:
    movsd   (%rdi), %xmm0       // xmm0 = fst
    addsd   8(%rdi), %xmm0      // xmm0 += snd
    ret
.size fadd, .-fadd

// ----------------------------------------------------------------------
// fsub - Subtract two floats
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in rdi
// Output: double in xmm0
.global fsub
.type fsub, @function
fsub:
    movsd   (%rdi), %xmm0       // xmm0 = fst
    subsd   8(%rdi), %xmm0      // xmm0 -= snd
    ret
.size fsub, .-fsub

// ----------------------------------------------------------------------
// fmul - Multiply two floats
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in rdi
// Output: double in xmm0
.global fmul
.type fmul, @function
fmul:
    movsd   (%rdi), %xmm0       // xmm0 = fst
    mulsd   8(%rdi), %xmm0      // xmm0 *= snd
    ret
.size fmul, .-fmul

// ----------------------------------------------------------------------
// fdiv - Divide two floats
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in rdi
// Output: double in xmm0
.global fdiv
.type fdiv, @function
fdiv:
    movsd   (%rdi), %xmm0       // xmm0 = fst
    divsd   8(%rdi), %xmm0      // xmm0 /= snd
    ret
.size fdiv, .-fdiv

// ----------------------------------------------------------------------
// fneg - Negate a float
// ----------------------------------------------------------------------
// Input: double in xmm0
// Output: double in xmm0
.global fneg
.type fneg, @function
fneg:
    // XOR with sign bit mask to flip sign
    movq    %xmm0, %rax
    movabs  $0x8000000000000000, %rcx
    xor     %rcx, %rax
    movq    %rax, %xmm0
    ret
.size fneg, .-fneg

// ----------------------------------------------------------------------
// fabs - Absolute value
// ----------------------------------------------------------------------
// Input: double in xmm0
// Output: double in xmm0
.global fabs
.type fabs, @function
fabs:
    // AND with mask to clear sign bit
    movq    %xmm0, %rax
    movabs  $0x7FFFFFFFFFFFFFFF, %rcx
    and     %rcx, %rax
    movq    %rax, %xmm0
    ret
.size fabs, .-fabs

// ======================================================================
// Hardware-supported operations
// ======================================================================

// ----------------------------------------------------------------------
// fsqrt - Square root
// ----------------------------------------------------------------------
// Input: double in xmm0
// Output: double in xmm0
.global fsqrt
.type fsqrt, @function
fsqrt:
    sqrtsd  %xmm0, %xmm0
    ret
.size fsqrt, .-fsqrt

// ======================================================================
// Comparisons (return 0 for false, 1 for true)
// ======================================================================

// ----------------------------------------------------------------------
// flt - Less than
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in rdi
// Output: int64 (0 or 1) in rax
.global flt
.type flt, @function
flt:
    movsd   (%rdi), %xmm0       // xmm0 = fst
    ucomisd 8(%rdi), %xmm0      // compare fst with snd
    setb    %al                 // set if fst < snd (below, for unordered compare)
    movzbl  %al, %eax
    ret
.size flt, .-flt

// ----------------------------------------------------------------------
// fle - Less than or equal
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in rdi
// Output: int64 (0 or 1) in rax
.global fle
.type fle, @function
fle:
    movsd   (%rdi), %xmm0
    ucomisd 8(%rdi), %xmm0
    setbe   %al                 // set if fst <= snd
    movzbl  %al, %eax
    ret
.size fle, .-fle

// ----------------------------------------------------------------------
// fgt - Greater than
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in rdi
// Output: int64 (0 or 1) in rax
.global fgt
.type fgt, @function
fgt:
    movsd   (%rdi), %xmm0
    ucomisd 8(%rdi), %xmm0
    seta    %al                 // set if fst > snd
    movzbl  %al, %eax
    ret
.size fgt, .-fgt

// ----------------------------------------------------------------------
// fge - Greater than or equal
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in rdi
// Output: int64 (0 or 1) in rax
.global fge
.type fge, @function
fge:
    movsd   (%rdi), %xmm0
    ucomisd 8(%rdi), %xmm0
    setae   %al                 // set if fst >= snd
    movzbl  %al, %eax
    ret
.size fge, .-fge

// ----------------------------------------------------------------------
// feq - Equal
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in rdi
// Output: int64 (0 or 1) in rax
.global feq
.type feq, @function
feq:
    movsd   (%rdi), %xmm0
    ucomisd 8(%rdi), %xmm0
    sete    %al
    setnp   %cl                 // also check not unordered (NaN)
    and     %cl, %al
    movzbl  %al, %eax
    ret
.size feq, .-feq

// ----------------------------------------------------------------------
// fne - Not equal
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in rdi
// Output: int64 (0 or 1) in rax
.global fne
.type fne, @function
fne:
    movsd   (%rdi), %xmm0
    ucomisd 8(%rdi), %xmm0
    setne   %al
    setp    %cl                 // or if unordered (NaN)
    or      %cl, %al
    movzbl  %al, %eax
    ret
.size fne, .-fne

// ======================================================================
// Conversions
// ======================================================================

// ----------------------------------------------------------------------
// intToFloat - Convert integer to float
// ----------------------------------------------------------------------
// Input: int64 in rdi
// Output: double in xmm0
.global intToFloat
.type intToFloat, @function
intToFloat:
    cvtsi2sdq %rdi, %xmm0
    ret
.size intToFloat, .-intToFloat

// ----------------------------------------------------------------------
// floatToInt - Convert float to integer (truncate toward zero)
// ----------------------------------------------------------------------
// Input: double in xmm0
// Output: int64 in rax
.global floatToInt
.type floatToInt, @function
floatToInt:
    cvttsd2siq %xmm0, %rax
    ret
.size floatToInt, .-floatToInt

// ======================================================================
// Constants
// ======================================================================

// ----------------------------------------------------------------------
// pi - Return pi constant
// ----------------------------------------------------------------------
// Input: Unit (ignored)
// Output: double in xmm0
.global pi
.type pi, @function
pi:
    movsd   .Lpi_const(%rip), %xmm0
    ret
.size pi, .-pi

.section .rodata
.align 8
.Lpi_const:
    .double 3.14159265358979323846

.text

// ======================================================================
// Min/Max
// ======================================================================

// ----------------------------------------------------------------------
// fmin - Minimum of two floats
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in rdi
// Output: double in xmm0
.global fmin
.type fmin, @function
fmin:
    movsd   (%rdi), %xmm0
    minsd   8(%rdi), %xmm0
    ret
.size fmin, .-fmin

// ----------------------------------------------------------------------
// fmax - Maximum of two floats
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in rdi
// Output: double in xmm0
.global fmax
.type fmax, @function
fmax:
    movsd   (%rdi), %xmm0
    maxsd   8(%rdi), %xmm0
    ret
.size fmax, .-fmax

// ======================================================================
// Transcendental functions - STUB implementations
// ======================================================================
// These require libm or software implementations.
// For now, they are not implemented in pure assembly.
// Use the C implementation (Float.c) for these functions.
//
// Not implemented: fsin, fcos, fpow, flog, fexp
// Not implemented: parseFloat, floatToString (require string handling)
//
// ======================================================================

#endif // ONCE_LINUX_X86_64_FLOAT_DEFINED
