-- | Floating-point arithmetic primitives for Linux
--
-- Double-precision (64-bit) floating-point operations.
-- Required for n-body, spectral-norm, mandelbrot benchmarks.

------------------------------------------------------------------------
-- Basic Arithmetic
------------------------------------------------------------------------

-- | Addition
signature fadd : Float * Float -> Float

-- | Subtraction
signature fsub : Float * Float -> Float

-- | Multiplication
signature fmul : Float * Float -> Float

-- | Division
signature fdiv : Float * Float -> Float

-- | Negation
signature fneg : Float -> Float

-- | Absolute value
signature fabs : Float -> Float

------------------------------------------------------------------------
-- Transcendental Functions
------------------------------------------------------------------------

-- | Square root
signature fsqrt : Float -> Float

-- | Sine
signature fsin : Float -> Float

-- | Cosine
signature fcos : Float -> Float

-- | Power (x^y)
signature fpow : Float * Float -> Float

-- | Natural logarithm
signature flog : Float -> Float

-- | Exponential (e^x)
signature fexp : Float -> Float

------------------------------------------------------------------------
-- Comparisons (return 0 for false, 1 for true)
------------------------------------------------------------------------

-- | Less than
signature flt : Float * Float -> Int

-- | Less than or equal
signature fle : Float * Float -> Int

-- | Greater than
signature fgt : Float * Float -> Int

-- | Greater than or equal
signature fge : Float * Float -> Int

-- | Equal (exact comparison)
signature feq : Float * Float -> Int

-- | Not equal
signature fne : Float * Float -> Int

------------------------------------------------------------------------
-- Conversions
------------------------------------------------------------------------

-- | Convert integer to float
signature intToFloat : Int -> Float

-- | Convert float to integer (truncates toward zero)
signature floatToInt : Float -> Int

-- | Parse float from string (returns 0.0 on failure)
signature parseFloat : String -> Float

-- | Convert float to string
signature floatToString : Float -> String

------------------------------------------------------------------------
-- Constants
------------------------------------------------------------------------

-- | Pi (3.14159...)
signature pi : Unit -> Float

------------------------------------------------------------------------
-- Min/Max
------------------------------------------------------------------------

-- | Minimum of two floats
signature fmin : Float * Float -> Float

-- | Maximum of two floats
signature fmax : Float * Float -> Float