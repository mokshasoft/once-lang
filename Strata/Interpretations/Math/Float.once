-- | Floating-point arithmetic primitives for Linux
--
-- Double-precision (64-bit) floating-point operations.
-- Required for n-body, spectral-norm, mandelbrot benchmarks.

------------------------------------------------------------------------
-- Basic Arithmetic
------------------------------------------------------------------------

-- | Absolute value
signature fabs : Float -> Float

------------------------------------------------------------------------
-- Transcendental Functions
------------------------------------------------------------------------

-- | Square root
signature fsqrt : Float -> Float

-- | Sine
signature fsin : Float -> Float

-- | Cosine
signature fcos : Float -> Float

-- | Power (x^y)
signature fpow : Float * Float -> Float

-- | Natural logarithm
signature flog : Float -> Float

-- | Exponential (e^x)
signature fexp : Float -> Float

------------------------------------------------------------------------
-- Conversions
------------------------------------------------------------------------

-- | Convert float to integer (truncates toward zero)
signature floatToInt : Float -> Int

------------------------------------------------------------------------
-- Constants
------------------------------------------------------------------------

-- | Pi (3.14159...)
signature pi : Unit -> Float

------------------------------------------------------------------------
-- Min/Max
------------------------------------------------------------------------

-- | Minimum of two floats
signature fmin : Float * Float -> Float

-- | Maximum of two floats
signature fmax : Float * Float -> Float
