// ======================================================================
// Floating-point Arithmetic Primitives - RISC-V64 Implementation
// ======================================================================
//
// Double-precision (64-bit) floating-point operations using RV64D.
// Required for n-body, spectral-norm, mandelbrot benchmarks.
//
// Note: Transcendental functions (sin, cos, exp, log, pow) require
// libm or software implementations. This file provides hardware-only
// operations. Use the C implementation for transcendentals.
//
// Calling convention:
// - Float values passed/returned in fa0
// - Pairs passed as pointer to OncePair in a0
// - Integer results returned in a0
//
// ======================================================================

.text
.align 2

#ifndef ONCE_LINUX_RISCV64_FLOAT_DEFINED
#define ONCE_LINUX_RISCV64_FLOAT_DEFINED

// ======================================================================
// Basic Arithmetic
// ======================================================================

// ----------------------------------------------------------------------
// fadd - Add two floats
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in a0
// Output: double in fa0
.global fadd
.type fadd, @function
fadd:
    fld     fa0, 0(a0)          // fa0 = fst
    fld     fa1, 8(a0)          // fa1 = snd
    fadd.d  fa0, fa0, fa1
    ret
.size fadd, .-fadd

// ----------------------------------------------------------------------
// fsub - Subtract two floats
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in a0
// Output: double in fa0
.global fsub
.type fsub, @function
fsub:
    fld     fa0, 0(a0)
    fld     fa1, 8(a0)
    fsub.d  fa0, fa0, fa1
    ret
.size fsub, .-fsub

// ----------------------------------------------------------------------
// fmul - Multiply two floats
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in a0
// Output: double in fa0
.global fmul
.type fmul, @function
fmul:
    fld     fa0, 0(a0)
    fld     fa1, 8(a0)
    fmul.d  fa0, fa0, fa1
    ret
.size fmul, .-fmul

// ----------------------------------------------------------------------
// fdiv - Divide two floats
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in a0
// Output: double in fa0
.global fdiv
.type fdiv, @function
fdiv:
    fld     fa0, 0(a0)
    fld     fa1, 8(a0)
    fdiv.d  fa0, fa0, fa1
    ret
.size fdiv, .-fdiv

// ----------------------------------------------------------------------
// fneg - Negate a float
// ----------------------------------------------------------------------
// Input: double in fa0
// Output: double in fa0
.global fneg
.type fneg, @function
fneg:
    fneg.d  fa0, fa0
    ret
.size fneg, .-fneg

// ----------------------------------------------------------------------
// fabs - Absolute value
// ----------------------------------------------------------------------
// Input: double in fa0
// Output: double in fa0
.global fabs
.type fabs, @function
fabs:
    fabs.d  fa0, fa0
    ret
.size fabs, .-fabs

// ======================================================================
// Hardware-supported operations
// ======================================================================

// ----------------------------------------------------------------------
// fsqrt - Square root
// ----------------------------------------------------------------------
// Input: double in fa0
// Output: double in fa0
.global fsqrt
.type fsqrt, @function
fsqrt:
    fsqrt.d fa0, fa0
    ret
.size fsqrt, .-fsqrt

// ======================================================================
// Comparisons (return 0 for false, 1 for true)
// ======================================================================

// ----------------------------------------------------------------------
// flt - Less than
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in a0
// Output: int64 (0 or 1) in a0
.global flt
.type flt, @function
flt:
    fld     fa0, 0(a0)
    fld     fa1, 8(a0)
    flt.d   a0, fa0, fa1        // a0 = (fa0 < fa1) ? 1 : 0
    ret
.size flt, .-flt

// ----------------------------------------------------------------------
// fle - Less than or equal
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in a0
// Output: int64 (0 or 1) in a0
.global fle
.type fle, @function
fle:
    fld     fa0, 0(a0)
    fld     fa1, 8(a0)
    fle.d   a0, fa0, fa1
    ret
.size fle, .-fle

// ----------------------------------------------------------------------
// fgt - Greater than
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in a0
// Output: int64 (0 or 1) in a0
.global fgt
.type fgt, @function
fgt:
    fld     fa0, 0(a0)
    fld     fa1, 8(a0)
    flt.d   a0, fa1, fa0        // fgt(a,b) = flt(b,a)
    ret
.size fgt, .-fgt

// ----------------------------------------------------------------------
// fge - Greater than or equal
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in a0
// Output: int64 (0 or 1) in a0
.global fge
.type fge, @function
fge:
    fld     fa0, 0(a0)
    fld     fa1, 8(a0)
    fle.d   a0, fa1, fa0        // fge(a,b) = fle(b,a)
    ret
.size fge, .-fge

// ----------------------------------------------------------------------
// feq - Equal
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in a0
// Output: int64 (0 or 1) in a0
.global feq
.type feq, @function
feq:
    fld     fa0, 0(a0)
    fld     fa1, 8(a0)
    feq.d   a0, fa0, fa1
    ret
.size feq, .-feq

// ----------------------------------------------------------------------
// fne - Not equal
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in a0
// Output: int64 (0 or 1) in a0
.global fne
.type fne, @function
fne:
    fld     fa0, 0(a0)
    fld     fa1, 8(a0)
    feq.d   a0, fa0, fa1
    xori    a0, a0, 1           // invert result
    ret
.size fne, .-fne

// ======================================================================
// Conversions
// ======================================================================

// ----------------------------------------------------------------------
// intToFloat - Convert integer to float
// ----------------------------------------------------------------------
// Input: int64 in a0
// Output: double in fa0
.global intToFloat
.type intToFloat, @function
intToFloat:
    fcvt.d.l fa0, a0
    ret
.size intToFloat, .-intToFloat

// ----------------------------------------------------------------------
// floatToInt - Convert float to integer (truncate toward zero)
// ----------------------------------------------------------------------
// Input: double in fa0
// Output: int64 in a0
.global floatToInt
.type floatToInt, @function
floatToInt:
    fcvt.l.d a0, fa0, rtz       // rtz = round toward zero
    ret
.size floatToInt, .-floatToInt

// ======================================================================
// Constants
// ======================================================================

// ----------------------------------------------------------------------
// pi - Return pi constant
// ----------------------------------------------------------------------
// Input: Unit (ignored)
// Output: double in fa0
.global pi
.type pi, @function
pi:
    lla     t0, .Lpi_const
    fld     fa0, 0(t0)
    ret
.size pi, .-pi

.section .rodata
.align 8
.Lpi_const:
    .double 3.14159265358979323846

.text

// ======================================================================
// Min/Max
// ======================================================================

// ----------------------------------------------------------------------
// fmin - Minimum of two floats
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in a0
// Output: double in fa0
.global fmin
.type fmin, @function
fmin:
    fld     fa0, 0(a0)
    fld     fa1, 8(a0)
    fmin.d  fa0, fa0, fa1
    ret
.size fmin, .-fmin

// ----------------------------------------------------------------------
// fmax - Maximum of two floats
// ----------------------------------------------------------------------
// Input: OncePair* (fst, snd) in a0
// Output: double in fa0
.global fmax
.type fmax, @function
fmax:
    fld     fa0, 0(a0)
    fld     fa1, 8(a0)
    fmax.d  fa0, fa0, fa1
    ret
.size fmax, .-fmax

// ======================================================================
// Transcendental functions - STUB implementations
// ======================================================================
// These require libm or software implementations.
// For now, they are not implemented in pure assembly.
// Use the C implementation (Float.c) for these functions.
//
// Not implemented: fsin, fcos, fpow, flog, fexp
// Not implemented: parseFloat, floatToString (require string handling)
//
// ======================================================================

#endif // ONCE_LINUX_RISCV64_FLOAT_DEFINED
