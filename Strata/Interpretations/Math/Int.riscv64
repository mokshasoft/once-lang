/* Integer arithmetic primitives for Once
 *
 * RISC-V LP64D ABI implementation of Arith.once primitives.
 * OncePair (16 bytes) passed in: a0 (fst), a1 (snd)
 * int64_t passed in: a0
 * Return value in: a0
 */

.text

/*========================================================================
 * Basic Arithmetic
 *========================================================================*/

.globl add
.type add, @function
add:
    add     a0, a0, a1      // return fst + snd
    ret
.size add, .-add

.globl sub
.type sub, @function
sub:
    sub     a0, a0, a1      // return fst - snd
    ret
.size sub, .-sub

.globl mul
.type mul, @function
mul:
    mul     a0, a0, a1      // return fst * snd
    ret
.size mul, .-mul

.globl div
.type div, @function
div:
    beqz    a1, .Ldiv_zero  // if snd == 0, return 0
    div     a0, a0, a1      // signed divide
    ret
.Ldiv_zero:
    li      a0, 0
    ret
.size div, .-div

.globl mod
.type mod, @function
mod:
    beqz    a1, .Lmod_zero  // if snd == 0, return 0
    rem     a0, a0, a1      // signed remainder
    ret
.Lmod_zero:
    li      a0, 0
    ret
.size mod, .-mod

.globl neg
.type neg, @function
neg:
    neg     a0, a0
    ret
.size neg, .-neg

.globl abs
.type abs, @function
abs:
    bgez    a0, .Labs_done  // if a0 >= 0, already positive
    neg     a0, a0
.Labs_done:
    ret
.size abs, .-abs

/*========================================================================
 * Comparisons (return 0 or 1)
 *========================================================================*/

.globl eq
.type eq, @function
eq:
    xor     a0, a0, a1      // a0 = 0 if equal
    seqz    a0, a0          // a0 = 1 if a0 == 0
    ret
.size eq, .-eq

.globl neq
.type neq, @function
neq:
    xor     a0, a0, a1      // a0 = 0 if equal
    snez    a0, a0          // a0 = 1 if a0 != 0
    ret
.size neq, .-neq

.globl lt
.type lt, @function
lt:
    slt     a0, a0, a1      // a0 = 1 if fst < snd (signed)
    ret
.size lt, .-lt

.globl le
.type le, @function
le:
    slt     a0, a1, a0      // a0 = 1 if snd < fst
    xori    a0, a0, 1       // a0 = !(snd < fst) = (fst <= snd)
    ret
.size le, .-le

.globl gt
.type gt, @function
gt:
    slt     a0, a1, a0      // a0 = 1 if snd < fst (i.e., fst > snd)
    ret
.size gt, .-gt

.globl ge
.type ge, @function
ge:
    slt     a0, a0, a1      // a0 = 1 if fst < snd
    xori    a0, a0, 1       // a0 = !(fst < snd) = (fst >= snd)
    ret
.size ge, .-ge

/*========================================================================
 * Bitwise Operations
 *========================================================================*/

.globl band
.type band, @function
band:
    and     a0, a0, a1
    ret
.size band, .-band

.globl bor
.type bor, @function
bor:
    or      a0, a0, a1
    ret
.size bor, .-bor

.globl bxor
.type bxor, @function
bxor:
    xor     a0, a0, a1
    ret
.size bxor, .-bxor

.globl bnot
.type bnot, @function
bnot:
    not     a0, a0
    ret
.size bnot, .-bnot

.globl shl
.type shl, @function
shl:
    sll     a0, a0, a1      // logical left shift
    ret
.size shl, .-shl

.globl shr
.type shr, @function
shr:
    sra     a0, a0, a1      // arithmetic right shift
    ret
.size shr, .-shr

/*========================================================================
 * Min/Max
 *========================================================================*/

.globl min
.type min, @function
min:
    blt     a0, a1, .Lmin_done  // if fst < snd, use fst
    mv      a0, a1              // else use snd
.Lmin_done:
    ret
.size min, .-min

.globl max
.type max, @function
max:
    bgt     a0, a1, .Lmax_done  // if fst > snd, use fst
    mv      a0, a1              // else use snd
.Lmax_done:
    ret
.size max, .-max
