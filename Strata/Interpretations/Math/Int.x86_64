/* Integer arithmetic primitives for Once
 *
 * x86-64 System V ABI implementation of Arith.once primitives.
 * OncePair (16 bytes) passed in: rdi (fst), rsi (snd)
 * int64_t passed in: rdi
 * Return value in: rax
 */

.text

/*========================================================================
 * Basic Arithmetic
 *========================================================================*/

.globl add
.type add, @function
add:
    mov     %rdi, %rax      // a = fst
    add     %rsi, %rax      // a + snd
    ret
.size add, .-add

.globl sub
.type sub, @function
sub:
    mov     %rdi, %rax      // a = fst
    sub     %rsi, %rax      // a - snd
    ret
.size sub, .-sub

.globl mul
.type mul, @function
mul:
    mov     %rdi, %rax      // a = fst
    imul    %rsi, %rax      // a * snd
    ret
.size mul, .-mul

.globl div
.type div, @function
div:
    test    %rsi, %rsi      // check if b == 0
    jz      .div_zero
    mov     %rdi, %rax      // a = fst
    cqo                     // sign-extend rax to rdx:rax
    idiv    %rsi            // rdx:rax / rsi -> quotient in rax
    ret
.div_zero:
    xor     %eax, %eax      // return 0 for division by zero
    ret
.size div, .-div

.globl mod
.type mod, @function
mod:
    test    %rsi, %rsi      // check if b == 0
    jz      .mod_zero
    mov     %rdi, %rax      // a = fst
    cqo                     // sign-extend rax to rdx:rax
    idiv    %rsi            // rdx:rax / rsi -> remainder in rdx
    mov     %rdx, %rax      // return remainder
    ret
.mod_zero:
    xor     %eax, %eax      // return 0 for mod by zero
    ret
.size mod, .-mod

.globl neg
.type neg, @function
neg:
    mov     %rdi, %rax
    neg     %rax
    ret
.size neg, .-neg

.globl abs
.type abs, @function
abs:
    mov     %rdi, %rax
    mov     %rdi, %rdx
    neg     %rdx
    cmovs   %rdx, %rax      // if rax was negative, use negated value
    ret
.size abs, .-abs

/*========================================================================
 * Comparisons (return 0 or 1)
 *========================================================================*/

.globl eq
.type eq, @function
eq:
    xor     %eax, %eax      // result = 0
    cmp     %rsi, %rdi      // compare fst, snd
    sete    %al             // set al = 1 if equal
    ret
.size eq, .-eq

.globl neq
.type neq, @function
neq:
    xor     %eax, %eax
    cmp     %rsi, %rdi
    setne   %al
    ret
.size neq, .-neq

.globl lt
.type lt, @function
lt:
    xor     %eax, %eax
    cmp     %rsi, %rdi      // fst - snd
    setl    %al             // signed less than
    ret
.size lt, .-lt

.globl le
.type le, @function
le:
    xor     %eax, %eax
    cmp     %rsi, %rdi
    setle   %al
    ret
.size le, .-le

.globl gt
.type gt, @function
gt:
    xor     %eax, %eax
    cmp     %rsi, %rdi
    setg    %al
    ret
.size gt, .-gt

.globl ge
.type ge, @function
ge:
    xor     %eax, %eax
    cmp     %rsi, %rdi
    setge   %al
    ret
.size ge, .-ge

/*========================================================================
 * Bitwise Operations
 *========================================================================*/

.globl band
.type band, @function
band:
    mov     %rdi, %rax
    and     %rsi, %rax
    ret
.size band, .-band

.globl bor
.type bor, @function
bor:
    mov     %rdi, %rax
    or      %rsi, %rax
    ret
.size bor, .-bor

.globl bxor
.type bxor, @function
bxor:
    mov     %rdi, %rax
    xor     %rsi, %rax
    ret
.size bxor, .-bxor

.globl bnot
.type bnot, @function
bnot:
    mov     %rdi, %rax
    not     %rax
    ret
.size bnot, .-bnot

.globl shl
.type shl, @function
shl:
    mov     %rdi, %rax
    mov     %rsi, %rcx      // shift amount must be in cl
    shl     %cl, %rax
    ret
.size shl, .-shl

.globl shr
.type shr, @function
shr:
    mov     %rdi, %rax
    mov     %rsi, %rcx      // shift amount must be in cl
    sar     %cl, %rax       // arithmetic right shift (preserves sign)
    ret
.size shr, .-shr

/*========================================================================
 * Min/Max
 *========================================================================*/

.globl min
.type min, @function
min:
    mov     %rdi, %rax      // a = fst
    cmp     %rsi, %rdi      // compare a, b
    cmovg   %rsi, %rax      // if a > b, use b
    ret
.size min, .-min

.globl max
.type max, @function
max:
    mov     %rdi, %rax      // a = fst
    cmp     %rsi, %rdi      // compare a, b
    cmovl   %rsi, %rax      // if a < b, use b
    ret
.size max, .-max
