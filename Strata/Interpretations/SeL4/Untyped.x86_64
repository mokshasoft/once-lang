# ======================================================================
# seL4 Untyped Primitives - x86_64 Implementation
# ======================================================================
#
# An object invocation is an seL4_Call on the object's capability with
# the method's message info (label, extra caps, length), made by the seL4
# Host's `once_sel4_invoke`; only the root task has the IPC buffer it
# needs, so these run in the root task. The answer is the reply's label:
# the seL4_Error. Parameter order: libsel4's `object-api.xml` (word
# parameters are message words, capability parameters are extra caps).
# Every seL4 number is in the block below, checked against the pinned
# kernel by examples/seL4 `check-numbers.sh`.
#
# SigOp ABI: the argument in rdi (a left-nested tuple of cells
# [fst, snd]), the answer in rax; every other register is preserved,
# r15 (Once's heap pointer, and seL4's fourth message register) too.
#
# ======================================================================

# seL4 numbers
.equ RETYPE_INFO, 0x1086            # = MSG_INFO(UntypedRetype, 0, 1, 6)
# end seL4 numbers

# Frame: the flattened arguments, the message words, the extra caps
.equ ARGS,   0
.equ WORDS,  64
.equ CAPS,   112
.equ FRAME,  144

.macro SAVE_ALL
    pushq %r15
    pushq %r14
    pushq %r13
    pushq %r12
    pushq %r11
    pushq %r10
    pushq %r9
    pushq %r8
    pushq %rbp
    pushq %rdi
    pushq %rsi
    pushq %rdx
    pushq %rcx
    pushq %rbx
.endm

.macro RESTORE_ALL
    popq %rbx
    popq %rcx
    popq %rdx
    popq %rsi
    popq %rdi
    popq %rbp
    popq %r8
    popq %r9
    popq %r10
    popq %r11
    popq %r12
    popq %r13
    popq %r14
    popq %r15
.endm

# Copy argument `idx` (or 0 when idx < 0) to the frame slot `off`
.macro ARG_TO off, idx
.if \idx < 0
    movq    $0, \off(%rsp)
.else
    movq    (ARGS + 8 * \idx)(%rsp), %rax
    movq    %rax, \off(%rsp)
.endif
.endm

# An invocation on argument 0's capability: `n` arguments, message info
# `info`, message words from arguments w0..w5, extra caps from c0..c2.
.macro SEL4_INVOCATION name, n, info, w0=-1, w1=-1, w2=-1, w3=-1, w4=-1, w5=-1, c0=-1, c1=-1, c2=-1
.global \name
.type \name, @function
\name:
    SAVE_ALL
    subq    $FRAME, %rsp
.if \n == 1
    movq    %rdi, ARGS(%rsp)
.else
    leaq    ARGS(%rsp), %rsi
    movq    $\n, %rcx
    call    once_sel4_flatten
.endif
    ARG_TO  (WORDS + 0), \w0
    ARG_TO  (WORDS + 8), \w1
    ARG_TO  (WORDS + 16), \w2
    ARG_TO  (WORDS + 24), \w3
    ARG_TO  (WORDS + 32), \w4
    ARG_TO  (WORDS + 40), \w5
    ARG_TO  (CAPS + 0), \c0
    ARG_TO  (CAPS + 8), \c1
    ARG_TO  (CAPS + 16), \c2
    movq    ARGS(%rsp), %rdi
    movq    $\info, %rsi
    leaq    WORDS(%rsp), %r12
    leaq    CAPS(%rsp), %r13
    call    once_sel4_invoke
    addq    $FRAME, %rsp
    RESTORE_ALL
    ret
.size \name, .-\name
.endm

.text
.align 16

# seL4_Untyped_Retype : (untyped, type, sizeBits, root, nodeIndex,
#                        nodeDepth, nodeOffset, numObjects) -> seL4_Error
# Words: type, sizeBits, nodeIndex, nodeDepth, nodeOffset, numObjects;
# cap: root.
SEL4_INVOCATION seL4_Untyped_Retype, 8, RETYPE_INFO, w0=1, w1=2, w2=4, w3=5, w4=6, w5=7, c0=3
