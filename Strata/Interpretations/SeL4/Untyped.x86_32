# ======================================================================
# seL4 Untyped Primitives - x86_32 Implementation
# ======================================================================
#
# As Untyped.x86_64: an object invocation is an seL4_Call made by the seL4
# Host's `once_sel4_invoke` (root task only). Every seL4 number is in the
# block below, checked against the pinned kernel.
#
# SigOp ABI: the argument in %ecx (a tuple is one flat block of words,
# D381), the answer in %eax; every other register is preserved, %esi
# (Once's heap pointer, and seL4's message-info register) too.
#
# ======================================================================

# seL4 numbers
.equ RETYPE_INFO, 0x1086            # = MSG_INFO(UntypedRetype, 0, 1, 6)
.equ NOTIFICATION_BITS, 4           # = seL4_NotificationBits
.equ TCB_BITS, 11                   # = seL4_TCBBits
.equ SLOT_BITS, 4                   # = seL4_SlotBits
# end seL4 numbers

# Frame: the arguments, the message words, the extra caps
.equ ARGS,   0
.equ WORDS,  32
.equ CAPS,   56
.equ FRAME,  72
.equ SAVED_EAX, FRAME + 28          # pushal's slot for %eax

# Copy argument `idx` (or 0 when idx < 0) to the frame slot `off`
.macro ARG_TO off, idx
.if \idx < 0
    movl    $0, \off(%esp)
.else
    movl    (ARGS + 4 * \idx)(%esp), %eax
    movl    %eax, \off(%esp)
.endif
.endm

# An invocation on argument 0's capability: `n` arguments, message info
# `info`, message words from arguments w0..w5, extra caps from c0..c2.
.macro SEL4_INVOCATION name, n, info, w0=-1, w1=-1, w2=-1, w3=-1, w4=-1, w5=-1, c0=-1, c1=-1, c2=-1
.global \name
.type \name, @function
\name:
    pushal
    subl    $FRAME, %esp
.if \n == 1
    movl    %ecx, ARGS(%esp)
.else
    movl    %ecx, %eax
    leal    ARGS(%esp), %edx
    movl    $\n, %ecx
    call    once_sel4_copy_arg
.endif
    ARG_TO  (WORDS + 0), \w0
    ARG_TO  (WORDS + 4), \w1
    ARG_TO  (WORDS + 8), \w2
    ARG_TO  (WORDS + 12), \w3
    ARG_TO  (WORDS + 16), \w4
    ARG_TO  (WORDS + 20), \w5
    ARG_TO  (CAPS + 0), \c0
    ARG_TO  (CAPS + 4), \c1
    ARG_TO  (CAPS + 8), \c2
    movl    ARGS(%esp), %ebx
    movl    $\info, %esi
    leal    WORDS(%esp), %edi
    leal    CAPS(%esp), %ebp
    call    once_sel4_invoke
    movl    %eax, SAVED_EAX(%esp)
    addl    $FRAME, %esp
    popal
    ret
.size \name, .-\name
.endm

.text
.align 16

# seL4_Untyped_Retype : (untyped, type, sizeBits, root, nodeIndex,
#                        nodeDepth, nodeOffset, numObjects) -> seL4_Error
# Words: type, sizeBits, nodeIndex, nodeDepth, nodeOffset, numObjects;
# cap: root.
SEL4_INVOCATION seL4_Untyped_Retype, 8, RETYPE_INFO, w0=1, w1=2, w2=4, w3=5, w4=6, w5=7, c0=3

# The object sizes : Unit -> Int
.global seL4_NotificationBits
.type seL4_NotificationBits, @function
seL4_NotificationBits:
    movl    $NOTIFICATION_BITS, %eax
    ret

.global seL4_TCBBits
.type seL4_TCBBits, @function
seL4_TCBBits:
    movl    $TCB_BITS, %eax
    ret

.global seL4_SlotBits
.type seL4_SlotBits, @function
seL4_SlotBits:
    movl    $SLOT_BITS, %eax
    ret
