# ======================================================================
# seL4 IPC Primitives - x86_64 Implementation
# ======================================================================
#
# seL4 x86_64 syscall convention (libsel4 `syscalls_syscall.h`, non-MCS):
#   rdx: syscall number; rdi: destination/source cap (out: badge);
#   rsi: message info (in and out); r10, r8, r9, r15: message words 0-3;
#   `syscall` clobbers rcx, r11; rsp is kept in rbx across it.
# The syscall numbers are the kernel's names, checked against the pinned
# kernel by examples/seL4 `check-numbers.sh`.
# Messages are the four register words only: no IPC buffer is needed.
#
# SigOp ABI: the argument in rdi (a left-nested tuple of cells
# [fst, snd]), the answer in rax (Unit is 0; a tuple answer is allocated
# at the heap pointer r15, which is advanced); every other register is
# preserved. r15 is both Once's heap pointer and seL4's fourth message
# word, so it is saved around each syscall.
#
# ======================================================================

# seL4 numbers
.equ SysCall, -1
.equ SysReplyRecv, -2
.equ SysSend, -3
.equ SysNBSend, -4
.equ SysRecv, -5
.equ SysReply, -6
.equ SysYield, -7
.equ SysNBRecv, -8
# end seL4 numbers

# Frame: the flattened arguments, the results
.equ ARGS,   0
.equ RES,    64
.equ FRAME,  112
.equ SAVED_R15, FRAME + 13 * 8      # pushed first by SAVE_ALL

.macro SAVE_ALL
    pushq %r15
    pushq %r14
    pushq %r13
    pushq %r12
    pushq %r11
    pushq %r10
    pushq %r9
    pushq %r8
    pushq %rbp
    pushq %rdi
    pushq %rsi
    pushq %rdx
    pushq %rcx
    pushq %rbx
.endm

# Restore all but r15, which keeps its (advanced) value
.macro RESTORE_ALL_BUT_R15
    popq %rbx
    popq %rcx
    popq %rdx
    popq %rsi
    popq %rdi
    popq %rbp
    popq %r8
    popq %r9
    popq %r10
    popq %r11
    popq %r12
    popq %r13
    popq %r14
    addq $8, %rsp
.endm

.macro SYSCALL_SEL4 number
    movq    $\number, %rdx
    movq    %rsp, %rbx
    syscall
    movq    %rbx, %rsp
.endm

# Flatten the n-tuple argument (rdi) into ARGS
.macro FLATTEN n
    leaq    ARGS(%rsp), %rsi
    movq    $\n, %rcx
    call    once_sel4_flatten
.endm

# Message words 0-3 from ARGS slots a..a+3
.macro LOAD_MRS a
    movq    (ARGS + 8 * \a)(%rsp), %r10
    movq    (ARGS + 8 * (\a + 1))(%rsp), %r8
    movq    (ARGS + 8 * (\a + 2))(%rsp), %r9
    movq    (ARGS + 8 * (\a + 3))(%rsp), %r15
.endm

# Message words 0-3 to RES slots r..r+3
.macro STORE_MRS r
    movq    %r10, (RES + 8 * \r)(%rsp)
    movq    %r8, (RES + 8 * (\r + 1))(%rsp)
    movq    %r9, (RES + 8 * (\r + 2))(%rsp)
    movq    %r15, (RES + 8 * (\r + 3))(%rsp)
.endm

# Answer the n results in RES as a tuple; restore the heap pointer first
.macro ANSWER_TUPLE n
    movq    SAVED_R15(%rsp), %r15
    leaq    RES(%rsp), %rsi
    movq    $\n, %rcx
    call    once_sel4_build
.endm

.text
.align 16

# (The tuple argument is read by the seL4 Host's `once_sel4_flatten`, a
# tuple answer built by its `once_sel4_build`.)

# ----------------------------------------------------------------------
# seL4_Yield : Unit -> Unit
# ----------------------------------------------------------------------
.global seL4_Yield
.type seL4_Yield, @function
seL4_Yield:
    SAVE_ALL
    SYSCALL_SEL4 SysYield
    movq    (13 * 8)(%rsp), %r15
    RESTORE_ALL_BUT_R15
    xorq    %rax, %rax
    ret
.size seL4_Yield, .-seL4_Yield

# ----------------------------------------------------------------------
# seL4_Send / seL4_NBSend : (cap, msgInfo, mr0, mr1, mr2, mr3) -> Unit
# ----------------------------------------------------------------------
.macro SEND_OP name, number
.global \name
.type \name, @function
\name:
    SAVE_ALL
    subq    $FRAME, %rsp
    FLATTEN 6
    movq    (ARGS + 0)(%rsp), %rdi
    movq    (ARGS + 8)(%rsp), %rsi
    LOAD_MRS 2
    SYSCALL_SEL4 \number
    movq    SAVED_R15(%rsp), %r15
    addq    $FRAME, %rsp
    RESTORE_ALL_BUT_R15
    xorq    %rax, %rax
    ret
.size \name, .-\name
.endm

SEND_OP seL4_Send, SysSend
SEND_OP seL4_NBSend, SysNBSend

# ----------------------------------------------------------------------
# seL4_Recv / seL4_NBRecv : (src, reply) -> (badge, msgInfo, mr0..mr3)
# (reply is the MCS reply cap; unused on this kernel)
# ----------------------------------------------------------------------
.macro RECV_OP name, number
.global \name
.type \name, @function
\name:
    SAVE_ALL
    subq    $FRAME, %rsp
    FLATTEN 2
    movq    (ARGS + 0)(%rsp), %rdi
    SYSCALL_SEL4 \number
    movq    %rdi, (RES + 0)(%rsp)
    movq    %rsi, (RES + 8)(%rsp)
    STORE_MRS 2
    ANSWER_TUPLE 6
    addq    $FRAME, %rsp
    RESTORE_ALL_BUT_R15
    ret
.size \name, .-\name
.endm

RECV_OP seL4_Recv, SysRecv
RECV_OP seL4_NBRecv, SysNBRecv

# ----------------------------------------------------------------------
# seL4_Call : (cap, msgInfo, mr0, mr1, mr2, mr3) -> (msgInfo, mr0..mr3)
# ----------------------------------------------------------------------
.global seL4_Call
.type seL4_Call, @function
seL4_Call:
    SAVE_ALL
    subq    $FRAME, %rsp
    FLATTEN 6
    movq    (ARGS + 0)(%rsp), %rdi
    movq    (ARGS + 8)(%rsp), %rsi
    LOAD_MRS 2
    SYSCALL_SEL4 SysCall
    movq    %rsi, (RES + 0)(%rsp)
    STORE_MRS 1
    ANSWER_TUPLE 5
    addq    $FRAME, %rsp
    RESTORE_ALL_BUT_R15
    ret
.size seL4_Call, .-seL4_Call

# ----------------------------------------------------------------------
# seL4_Reply : (msgInfo, mr0, mr1, mr2, mr3) -> Unit
# ----------------------------------------------------------------------
.global seL4_Reply
.type seL4_Reply, @function
seL4_Reply:
    SAVE_ALL
    subq    $FRAME, %rsp
    FLATTEN 5
    movq    (ARGS + 0)(%rsp), %rsi
    LOAD_MRS 1
    SYSCALL_SEL4 SysReply
    movq    SAVED_R15(%rsp), %r15
    addq    $FRAME, %rsp
    RESTORE_ALL_BUT_R15
    xorq    %rax, %rax
    ret
.size seL4_Reply, .-seL4_Reply

# ----------------------------------------------------------------------
# seL4_ReplyRecv : (src, msgInfo, mr0, mr1, mr2, mr3, reply)
#                  -> (badge, msgInfo, mr0..mr3)
# ----------------------------------------------------------------------
.global seL4_ReplyRecv
.type seL4_ReplyRecv, @function
seL4_ReplyRecv:
    SAVE_ALL
    subq    $FRAME, %rsp
    FLATTEN 7
    movq    (ARGS + 0)(%rsp), %rdi
    movq    (ARGS + 8)(%rsp), %rsi
    LOAD_MRS 2
    SYSCALL_SEL4 SysReplyRecv
    movq    %rdi, (RES + 0)(%rsp)
    movq    %rsi, (RES + 8)(%rsp)
    STORE_MRS 2
    ANSWER_TUPLE 6
    addq    $FRAME, %rsp
    RESTORE_ALL_BUT_R15
    ret
.size seL4_ReplyRecv, .-seL4_ReplyRecv
