# ======================================================================
# seL4 BootInfo Primitives - x86_32 Implementation
# ======================================================================
#
# The kernel passes the BootInfo pointer to the root task in %ebx; the
# seL4 Host saves it at entry (`once_sel4_bootinfo`). Offsets are
# seL4_BootInfo's on ia32, checked against the pinned kernel.
#
# SigOp ABI: the argument in %ecx (a tuple is one flat block of words,
# D381), the answer in %eax; every other register is preserved, %esi
# (Once's heap pointer, and seL4's message-info register) too.
#
# ======================================================================

.text
.align 16

# seL4 numbers
.equ BI_IPC_BUFFER, 0x10            # = offsetof(seL4_BootInfo, ipcBuffer)
.equ BI_EMPTY, 0x14                 # = offsetof(seL4_BootInfo, empty)
.equ BI_USER_IMAGE_FRAMES, 0x24     # = offsetof(seL4_BootInfo, userImageFrames)
.equ BI_INIT_DOMAIN, 0x48           # = offsetof(seL4_BootInfo, initThreadDomain)
.equ BI_UNTYPED, 0x4C               # = offsetof(seL4_BootInfo, untyped)
.equ BI_UNTYPED_LIST, 0x54          # = offsetof(seL4_BootInfo, untypedList)
.equ SLOT_REGION_END, 4             # = offsetof(seL4_SlotRegion, end)
.equ UNTYPED_DESC_SIZE_BITS, 3      # = (sizeof(seL4_UntypedDesc) == 8) ? 3 : -1
.equ UD_PADDR, 0                    # = offsetof(seL4_UntypedDesc, paddr)
.equ UD_SIZE_BITS, 4                # = offsetof(seL4_UntypedDesc, sizeBits)
.equ UD_IS_DEVICE, 5                # = offsetof(seL4_UntypedDesc, isDevice)
.equ seL4_CapInitThreadTCB, 1
.equ seL4_CapInitThreadCNode, 2
.equ seL4_CapInitThreadVSpace, 3
.equ WORD_BITS, 32                  # = seL4_WordBits
# end seL4 numbers

.global wordBits
.type wordBits, @function
wordBits:
    movl    $WORD_BITS, %eax
    ret
.size wordBits, .-wordBits

.global getBootInfo
.type getBootInfo, @function
getBootInfo:
    movl    once_sel4_bootinfo, %eax
    ret
.size getBootInfo, .-getBootInfo

.global getIPCBuffer
.type getIPCBuffer, @function
getIPCBuffer:
    movl    once_sel4_bootinfo, %eax
    movl    BI_IPC_BUFFER(%eax), %eax
    ret
.size getIPCBuffer, .-getIPCBuffer

.global bootinfo_emptyStart
.type bootinfo_emptyStart, @function
bootinfo_emptyStart:
    movl    BI_EMPTY(%ecx), %eax
    ret
.size bootinfo_emptyStart, .-bootinfo_emptyStart

.global bootinfo_emptyEnd
.type bootinfo_emptyEnd, @function
bootinfo_emptyEnd:
    movl    (BI_EMPTY + SLOT_REGION_END)(%ecx), %eax
    ret
.size bootinfo_emptyEnd, .-bootinfo_emptyEnd

.global bootinfo_untypedCount
.type bootinfo_untypedCount, @function
bootinfo_untypedCount:
    movl    (BI_UNTYPED + SLOT_REGION_END)(%ecx), %eax
    subl    BI_UNTYPED(%ecx), %eax
    ret
.size bootinfo_untypedCount, .-bootinfo_untypedCount

.global bootinfo_untypedStart
.type bootinfo_untypedStart, @function
bootinfo_untypedStart:
    movl    BI_UNTYPED(%ecx), %eax
    ret
.size bootinfo_untypedStart, .-bootinfo_untypedStart

.global bootinfo_initThreadTCB
.type bootinfo_initThreadTCB, @function
bootinfo_initThreadTCB:
    movl    $seL4_CapInitThreadTCB, %eax
    ret
.size bootinfo_initThreadTCB, .-bootinfo_initThreadTCB

.global bootinfo_initThreadCNode
.type bootinfo_initThreadCNode, @function
bootinfo_initThreadCNode:
    movl    $seL4_CapInitThreadCNode, %eax
    ret
.size bootinfo_initThreadCNode, .-bootinfo_initThreadCNode

.global bootinfo_initThreadVSpace
.type bootinfo_initThreadVSpace, @function
bootinfo_initThreadVSpace:
    movl    $seL4_CapInitThreadVSpace, %eax
    ret
.size bootinfo_initThreadVSpace, .-bootinfo_initThreadVSpace

.global bootinfo_userImageFrames
.type bootinfo_userImageFrames, @function
bootinfo_userImageFrames:
    movl    (BI_USER_IMAGE_FRAMES + SLOT_REGION_END)(%ecx), %eax
    subl    BI_USER_IMAGE_FRAMES(%ecx), %eax
    ret
.size bootinfo_userImageFrames, .-bootinfo_userImageFrames

.global bootinfo_domainInfo
.type bootinfo_domainInfo, @function
bootinfo_domainInfo:
    movl    BI_INIT_DOMAIN(%ecx), %eax
    ret
.size bootinfo_domainInfo, .-bootinfo_domainInfo

# bootinfo_getUntyped : (bootinfo, index) -> ((paddr, sizeBits), isDevice)
.global bootinfo_getUntyped
.type bootinfo_getUntyped, @function
bootinfo_getUntyped:
    pushl   %ebx
    movl    4(%ecx), %ebx               # index
    shll    $UNTYPED_DESC_SIZE_BITS, %ebx
    addl    (%ecx), %ebx                # + bootinfo
    addl    $BI_UNTYPED_LIST, %ebx      # = &untypedList[index]
    movl    UD_PADDR(%ebx), %eax
    movl    %eax, 0(%esi)               # flat: [paddr, sizeBits, isDevice]
    movzbl  UD_SIZE_BITS(%ebx), %eax
    movl    %eax, 4(%esi)
    movzbl  UD_IS_DEVICE(%ebx), %eax
    movl    %eax, 8(%esi)
    movl    %esi, %eax
    addl    $12, %esi
    popl    %ebx
    ret
.size bootinfo_getUntyped, .-bootinfo_getUntyped

