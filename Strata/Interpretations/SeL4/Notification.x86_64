# ======================================================================
# seL4 Notification Primitives - x86_64 Implementation
# ======================================================================
#
# As libsel4 (non-MCS): seL4_Signal is seL4_Send with an empty message;
# seL4_Wait is seL4_Recv and seL4_Poll is seL4_NBRecv on the
# notification, answering the badge (rdi), which holds the notification
# word. Syscall convention as in IPC.x86_64; every seL4 number is in the
# block below, checked against the pinned kernel by examples/seL4
# `check-numbers.sh`.
#
# SigOp ABI: the argument in rdi, the answer in rax; every other register
# is preserved (r15, Once's heap pointer, is seL4's fourth message word).
#
# ======================================================================

# seL4 numbers
.equ SysSend, -3
.equ SysRecv, -5
.equ SysNBRecv, -8
.equ EMPTY_INFO, 0                  # = MSG_INFO(0, 0, 0, 0)
# end seL4 numbers

.macro SAVE_ALL
    pushq %r15
    pushq %r11
    pushq %r10
    pushq %r9
    pushq %r8
    pushq %rdi
    pushq %rsi
    pushq %rdx
    pushq %rcx
    pushq %rbx
.endm

.macro RESTORE_ALL
    popq %rbx
    popq %rcx
    popq %rdx
    popq %rsi
    popq %rdi
    popq %r8
    popq %r9
    popq %r10
    popq %r11
    popq %r15
.endm

.macro SYSCALL_SEL4 number
    movq    $\number, %rdx
    movq    %rsp, %rbx
    syscall
    movq    %rbx, %rsp
.endm

.text
.align 16

# ----------------------------------------------------------------------
# seL4_Signal : cap -> Unit
# ----------------------------------------------------------------------
.global seL4_Signal
.type seL4_Signal, @function
seL4_Signal:
    SAVE_ALL
    movq    $EMPTY_INFO, %rsi
    SYSCALL_SEL4 SysSend
    RESTORE_ALL
    xorq    %rax, %rax
    ret
.size seL4_Signal, .-seL4_Signal

# ----------------------------------------------------------------------
# seL4_Wait : (src, reply) -> the notification word
# (reply is the MCS reply cap; unused on this kernel)
# ----------------------------------------------------------------------
.global seL4_Wait
.type seL4_Wait, @function
seL4_Wait:
    SAVE_ALL
    movq    (%rdi), %rdi                # src
    SYSCALL_SEL4 SysRecv
    movq    %rdi, %rax                  # the badge: the notification word
    RESTORE_ALL
    ret
.size seL4_Wait, .-seL4_Wait

# ----------------------------------------------------------------------
# seL4_Poll : cap -> the notification word (0 if none)
# ----------------------------------------------------------------------
.global seL4_Poll
.type seL4_Poll, @function
seL4_Poll:
    SAVE_ALL
    SYSCALL_SEL4 SysNBRecv
    movq    %rdi, %rax                  # the badge: the notification word
    RESTORE_ALL
    ret
.size seL4_Poll, .-seL4_Poll
