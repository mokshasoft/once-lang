/* Integer arithmetic primitives for Once
 *
 * ARM64 AAPCS64 implementation of Arith.once primitives.
 * OncePair (16 bytes) passed in: x0 (fst), x1 (snd)
 * int64_t passed in: x0
 * Return value in: x0
 */

.text

/*========================================================================
 * Basic Arithmetic
 *========================================================================*/

.globl once_add
.type once_add, %function
once_add:
    add     x0, x0, x1      // return fst + snd
    ret
.size once_add, .-once_add

.globl once_sub
.type once_sub, %function
once_sub:
    sub     x0, x0, x1      // return fst - snd
    ret
.size once_sub, .-once_sub

.globl once_mul
.type once_mul, %function
once_mul:
    mul     x0, x0, x1      // return fst * snd
    ret
.size once_mul, .-once_mul

.globl once_div
.type once_div, %function
once_div:
    cbz     x1, .Ldiv_zero  // if snd == 0, return 0
    sdiv    x0, x0, x1      // signed divide
    ret
.Ldiv_zero:
    mov     x0, #0
    ret
.size once_div, .-once_div

.globl once_mod
.type once_mod, %function
once_mod:
    cbz     x1, .Lmod_zero  // if snd == 0, return 0
    sdiv    x2, x0, x1      // quotient in x2
    msub    x0, x2, x1, x0  // x0 = x0 - (x2 * x1) = remainder
    ret
.Lmod_zero:
    mov     x0, #0
    ret
.size once_mod, .-once_mod

.globl once_neg
.type once_neg, %function
once_neg:
    neg     x0, x0
    ret
.size once_neg, .-once_neg

.globl once_abs
.type once_abs, %function
once_abs:
    cmp     x0, #0
    cneg    x0, x0, lt      // negate if negative
    ret
.size once_abs, .-once_abs

/*========================================================================
 * Comparisons (return 0 or 1)
 *========================================================================*/

.globl once_eq
.type once_eq, %function
once_eq:
    cmp     x0, x1
    cset    x0, eq          // x0 = 1 if equal, 0 otherwise
    ret
.size once_eq, .-once_eq

.globl once_neq
.type once_neq, %function
once_neq:
    cmp     x0, x1
    cset    x0, ne
    ret
.size once_neq, .-once_neq

.globl once_lt
.type once_lt, %function
once_lt:
    cmp     x0, x1
    cset    x0, lt          // signed less than
    ret
.size once_lt, .-once_lt

.globl once_le
.type once_le, %function
once_le:
    cmp     x0, x1
    cset    x0, le
    ret
.size once_le, .-once_le

.globl once_gt
.type once_gt, %function
once_gt:
    cmp     x0, x1
    cset    x0, gt
    ret
.size once_gt, .-once_gt

.globl once_ge
.type once_ge, %function
once_ge:
    cmp     x0, x1
    cset    x0, ge
    ret
.size once_ge, .-once_ge

/*========================================================================
 * Bitwise Operations
 *========================================================================*/

.globl once_band
.type once_band, %function
once_band:
    and     x0, x0, x1
    ret
.size once_band, .-once_band

.globl once_bor
.type once_bor, %function
once_bor:
    orr     x0, x0, x1
    ret
.size once_bor, .-once_bor

.globl once_bxor
.type once_bxor, %function
once_bxor:
    eor     x0, x0, x1
    ret
.size once_bxor, .-once_bxor

.globl once_bnot
.type once_bnot, %function
once_bnot:
    mvn     x0, x0
    ret
.size once_bnot, .-once_bnot

.globl once_shl
.type once_shl, %function
once_shl:
    lsl     x0, x0, x1
    ret
.size once_shl, .-once_shl

.globl once_shr
.type once_shr, %function
once_shr:
    asr     x0, x0, x1      // arithmetic right shift
    ret
.size once_shr, .-once_shr

/*========================================================================
 * Min/Max
 *========================================================================*/

.globl once_min
.type once_min, %function
once_min:
    cmp     x0, x1
    csel    x0, x0, x1, lt  // select x0 if x0 < x1, else x1
    ret
.size once_min, .-once_min

.globl once_max
.type once_max, %function
once_max:
    cmp     x0, x1
    csel    x0, x0, x1, gt  // select x0 if x0 > x1, else x1
    ret
.size once_max, .-once_max
