-- | File I/O convenience functions for Linux
--
-- Higher-level file operations built on raw syscalls.
-- These are still primitives (implemented in C) but provide
-- a more convenient interface than raw fd_read/fd_write.

------------------------------------------------------------------------
-- Standard File Descriptors
------------------------------------------------------------------------

-- | Standard input (fd 0)
stdin : Int
stdin = 0

-- | Standard output (fd 1)
stdout : Int
stdout = 1

-- | Standard error (fd 2)
stderr : Int
stderr = 2

------------------------------------------------------------------------
-- Output Operations (D032: All I/O is effectful)
------------------------------------------------------------------------

-- | Write string to stdout (no newline)
signature print : Eff (String) Unit

-- | Write string to stdout with newline
signature println : Eff (String) Unit

-- | Write string to stderr (no newline)
signature err : Eff (String) Unit

-- | Write string to stderr with newline
signature errln : Eff (String) Unit

-- | Write a single character to stdout
signature putc : Eff Int Unit

-- | Flush stdout
signature flush : Eff Unit Unit

------------------------------------------------------------------------
-- Input Operations (D032: All I/O is effectful)
------------------------------------------------------------------------

-- | Read a single character from stdin
-- Returns -1 on EOF
signature getc : Eff Unit Int

-- | Read a line from stdin into buffer
-- Returns number of bytes read, or -1 on EOF
-- Does not include the newline character
signature getline : Eff (Buffer * Int) Int

------------------------------------------------------------------------
-- File Reading Helpers (D032: All I/O is effectful)
------------------------------------------------------------------------

-- | Read entire file contents into buffer
-- Returns bytes read or -1 on error
signature readfile : Eff (String * Buffer * Int) Int

-- | Get file size
-- Returns size in bytes or -1 on error
signature filesize : Eff (String) Int