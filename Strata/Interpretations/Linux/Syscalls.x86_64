    mov     $SYS_getegid, %rax
    syscall
    ret
.size getegid, .-getegid

#======================================================================
#File Descriptors
#======================================================================

#----------------------------------------------------------------------
#fd_read - Read from file descriptor
#----------------------------------------------------------------------
#Input: (fd, (buf_data, buf_len), count) as nested tuple
#Output: Int (bytes read or -errno)
.global fd_read
.type fd_read, @function
fd_read:
    push    %rbp
    mov     %rsp, %rbp

    #Unpack: (fd, ((buf_data, buf_len), count))
    mov     (%rdi), %r8         #r8 = fd
    mov     8(%rdi), %rdi       #rdi = ptr to rest

    mov     (%rdi), %r9         #r9 = ptr to buffer pair
    mov     8(%rdi), %rdx       #rdx = count

    mov     (%r9), %rsi         #rsi = buf_data
    #buf_len at 8(%r9) not needed for syscall

    mov     %r8, %rdi           #rdi = fd
    #rsi = buf_data
    #rdx = count

    mov     $SYS_read, %rax
    syscall

    pop     %rbp
    ret
.size fd_read, .-fd_read

#----------------------------------------------------------------------
#fd_write - Write to file descriptor
#----------------------------------------------------------------------
#Input: (fd, (buf_data, buf_len), count) as nested tuple
#Output: Int (bytes written or -errno)
.global fd_write
.type fd_write, @function
fd_write:
    push    %rbp
    mov     %rsp, %rbp

    #Unpack: (fd, ((buf_data, buf_len), count))
    mov     (%rdi), %r8         #r8 = fd
    mov     8(%rdi), %rdi       #rdi = ptr to rest

    mov     (%rdi), %r9         #r9 = ptr to buffer pair
    mov     8(%rdi), %rdx       #rdx = count

    mov     (%r9), %rsi         #rsi = buf_data

    mov     %r8, %rdi           #rdi = fd
    #rsi = buf_data
    #rdx = count

    mov     $SYS_write, %rax
    syscall

    pop     %rbp
    ret
.size fd_write, .-fd_write

#----------------------------------------------------------------------
#fd_close - Close file descriptor
#----------------------------------------------------------------------
#Input: Int (fd)
#Output: Int (0 or -errno)
.global fd_close
.type fd_close, @function
fd_close:
    #rdi = fd
    mov     $SYS_close, %rax
    syscall
    ret
.size fd_close, .-fd_close

#----------------------------------------------------------------------
#fd_dup - Duplicate file descriptor
#----------------------------------------------------------------------
#Input: Int (fd)
#Output: Int (new fd or -errno)
.global fd_dup
.type fd_dup, @function
fd_dup:
    #rdi = fd
    mov     $SYS_dup, %rax
    syscall
    ret
.size fd_dup, .-fd_dup

#----------------------------------------------------------------------
#fd_dup2 - Duplicate fd to specific number
#----------------------------------------------------------------------
#Input: (oldfd, newfd)
#Output: Int (new fd or -errno)
.global fd_dup2
.type fd_dup2, @function
fd_dup2:
    #Unpack: (oldfd, newfd)
    mov     (%rdi), %rax        #rax = oldfd
    mov     8(%rdi), %rsi       #rsi = newfd
    mov     %rax, %rdi          #rdi = oldfd

    mov     $SYS_dup2, %rax
    syscall
    ret
.size fd_dup2, .-fd_dup2

#======================================================================
#File Operations
#======================================================================

#----------------------------------------------------------------------
#open - Open file
#----------------------------------------------------------------------
#Input: ((path_data, path_len), (flags, mode))
#Output: Int (fd or -errno)
.global open
.type open, @function
open:
    push    %rbp
    mov     %rsp, %rbp

    #Unpack: ((path_data, path_len), (flags, mode))
    mov     (%rdi), %r8         #r8 = ptr to path
    mov     8(%rdi), %r9        #r9 = ptr to (flags, mode)

    mov     (%r8), %rdi         #rdi = path_data
    mov     (%r9), %rsi         #rsi = flags
    mov     8(%r9), %rdx        #rdx = mode

    mov     $SYS_open, %rax
    syscall

    pop     %rbp
    ret
.size open, .-open

#----------------------------------------------------------------------
#creat - Create file
#----------------------------------------------------------------------
#Input: ((path_data, path_len), mode)
#Output: Int (fd or -errno)
.global creat
.type creat, @function
creat:
    #Unpack: ((path_data, path_len), mode)
    mov     (%rdi), %r8         #r8 = ptr to path
    mov     8(%rdi), %rsi       #rsi = mode
    mov     (%r8), %rdi         #rdi = path_data

    mov     $SYS_creat, %rax
    syscall
    ret
.size creat, .-creat

#----------------------------------------------------------------------
#unlink - Delete file
#----------------------------------------------------------------------
#Input: (path_data, path_len)
#Output: Int (0 or -errno)
.global unlink
.type unlink, @function
unlink:
    #Unpack path string
    mov     (%rdi), %rdi        #rdi = path_data

    mov     $SYS_unlink, %rax
    syscall
    ret
.size unlink, .-unlink

#----------------------------------------------------------------------
#rename - Rename file
#----------------------------------------------------------------------
#Input: ((old_data, old_len), (new_data, new_len))
#Output: Int (0 or -errno)
.global rename
.type rename, @function
rename:
    #Unpack: ((old_data, old_len), (new_data, new_len))
    mov     (%rdi), %r8         #r8 = ptr to old path
    mov     8(%rdi), %r9        #r9 = ptr to new path

    mov     (%r8), %rdi         #rdi = old_data
    mov     (%r9), %rsi         #rsi = new_data

    mov     $SYS_rename, %rax
    syscall
    ret
.size rename, .-rename

#----------------------------------------------------------------------
#symlink - Create symbolic link
#----------------------------------------------------------------------
#Input: ((target_data, target_len), (link_data, link_len))
#Output: Int (0 or -errno)
.global symlink
.type symlink, @function
symlink:
    #Unpack: ((target_data, target_len), (link_data, link_len))
    mov     (%rdi), %r8         #r8 = ptr to target
    mov     8(%rdi), %r9        #r9 = ptr to link

    mov     (%r8), %rdi         #rdi = target_data
    mov     (%r9), %rsi         #rsi = link_data

    mov     $SYS_symlink, %rax
    syscall
    ret
.size symlink, .-symlink

#----------------------------------------------------------------------
#readlink - Read symbolic link
#----------------------------------------------------------------------
#Input: ((path_data, path_len), ((buf_data, buf_len), bufsiz))
#Output: Int (length or -errno)
.global readlink
.type readlink, @function
readlink:
    push    %rbp
    mov     %rsp, %rbp

    #Unpack
    mov     (%rdi), %r8         #r8 = ptr to path
    mov     8(%rdi), %r9        #r9 = ptr to rest

    mov     (%r8), %rdi         #rdi = path_data

    mov     (%r9), %r10         #r10 = ptr to buffer
    mov     8(%r9), %rdx        #rdx = bufsiz

    mov     (%r10), %rsi        #rsi = buf_data

    mov     $SYS_readlink, %rax
    syscall

    pop     %rbp
    ret
.size readlink, .-readlink

#----------------------------------------------------------------------
#stat - Get file status
#----------------------------------------------------------------------
#Input: ((path_data, path_len), (buf_data, buf_len))
#Output: Int (0 or -errno)
.global stat
.type stat, @function
stat:
    #Unpack
    mov     (%rdi), %r8         #r8 = ptr to path
    mov     8(%rdi), %r9        #r9 = ptr to buffer

    mov     (%r8), %rdi         #rdi = path_data
    mov     (%r9), %rsi         #rsi = buf_data

    mov     $SYS_stat, %rax
    syscall
    ret
.size stat, .-stat

#----------------------------------------------------------------------
#lstat - Get file status (don't follow symlinks)
#----------------------------------------------------------------------
#Input: ((path_data, path_len), (buf_data, buf_len))
#Output: Int (0 or -errno)
.global lstat
.type lstat, @function
lstat:
    mov     (%rdi), %r8
    mov     8(%rdi), %r9
    mov     (%r8), %rdi
    mov     (%r9), %rsi

    mov     $SYS_lstat, %rax
    syscall
    ret
.size lstat, .-lstat

#----------------------------------------------------------------------
#fstat - Get file status by fd
#----------------------------------------------------------------------
#Input: (fd, (buf_data, buf_len))
#Output: Int (0 or -errno)
.global fstat
.type fstat, @function
fstat:
    mov     (%rdi), %r8         #r8 = fd
    mov     8(%rdi), %r9        #r9 = ptr to buffer

    mov     %r8, %rdi           #rdi = fd
    mov     (%r9), %rsi         #rsi = buf_data

    mov     $SYS_fstat, %rax
    syscall
    ret
.size fstat, .-fstat

