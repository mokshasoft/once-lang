#
# Test-harness-local Emits SigOp `emit : Eff Int Unit` (Plan 0.36).
# Runtime = NOP: the observable is the SigOp trace (asserted at the Agda
# `obs` level), not stdout. Takes its Int argument in %rdi (Once SysV
# convention), returns Unit; touches no callee-saved register.

.text
.align 16
.global emit
.type emit, @function
emit:
    ret
.size emit, .-emit

# `emitF : Eff Float Unit` — the Float-argument twin of `emit`, same NOP
# runtime. Takes its Float argument in %rdi (Once SysV convention); the point is that the caller had
# to MATERIALISE the literal to make the call.
.align 16
.global emitF
.type emitF, @function
emitF:
    ret
.size emitF, .-emitF
