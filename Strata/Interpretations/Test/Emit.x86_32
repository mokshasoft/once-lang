#
# Test-harness-local Emits SigOp `emit : Eff Int Unit` (Plan 0.36) — x86-32.
# Runtime = NOP (like Emit.x86_64): the observable is the SigOp trace, not
# stdout. Takes its Int argument in %ecx (Once x86-32 Input1 convention),
# returns Unit; touches no callee-saved register.

.text
.align 16
.global emit
.type emit, @function
emit:
    ret
.size emit, .-emit

# `emitF : Eff Float Unit` — the Float-argument twin of `emit`, same NOP
# runtime. Takes its Float argument in %ecx (Once x86-32 Input1 convention); the point is that the caller had
# to MATERIALISE the literal to make the call.
.align 16
.global emitF
.type emitF, @function
emitF:
    ret
.size emitF, .-emitF
