# ======================================================================
# The Linux Host — riscv64 (D320)
#
# A Host is how a platform runs a program: `enter ; main ; leave`. The
# compiler calls `once_leave` when `main` returns and never knows which
# Host it is linked with (no name of a program has this symbol: a name's
# symbol has a digit after `once_`). Its contract: calling it ends the run, and that
# end is observed as `returned`. On Linux the run ends with exit status 0.
# `enter` is `_start` below: the region, then `once_main`.
# ======================================================================

.equ SYS_exit_group, 94

.text
.global once_leave
.type once_leave, @function
once_leave:
    li      a7, SYS_exit_group
    li      a0, 0                   # status = 0
    ecall
    # Does not return
.size once_leave, .-once_leave

# ----------------------------------------------------------------------
# once_exhausted — the run ran out of memory (D347). The compiler calls it
# when a room check fails; it never returns. Its contract: the run ends
# `exhausted`. On Linux the process sends itself SIGABRT, as C's `abort()`
# does: a parent sees death by a signal, distinct from every exit status
# (which `exit@S` can all produce). If SIGABRT is blocked or ignored, the
# run still ends: exit status 134 (128 + SIGABRT, a shell's reading).
# ----------------------------------------------------------------------
.equ SYS_getpid, 172
.equ SYS_kill, 129
.equ SIGABRT, 6

.global once_exhausted
.type once_exhausted, @function
once_exhausted:
    li      a7, SYS_getpid
    ecall                           # a0 = pid
    li      a1, SIGABRT
    li      a7, SYS_kill
    ecall
    li      a7, SYS_exit_group
    li      a0, 134
    ecall
    # Does not return
.size once_exhausted, .-once_exhausted

# ----------------------------------------------------------------------
# _start — the Host's `enter` (D320; plan 0.123 C.5). The kernel starts the
# process here. The Host owns the run's memory: one region, the cells at
# its bottom growing up, the stack at its top growing down; running out is
# the two meeting. It points the frontier register at the bottom and the
# stack pointer at the top, and enters the program at `once_main` (the
# compiler's portable entry, which knows no platform). On Linux the region
# is in `.bss`: the kernel maps it zeroed and pages it in as it is touched.
# ----------------------------------------------------------------------
.equ ONCE_REGION_SIZE, 8388608          # 8 MiB

.section .bss
.balign 16
once_region:
    .skip ONCE_REGION_SIZE
once_region_end:

.text
.global _start
.type _start, @function
_start:
    lla     s2, once_region             # the frontier: the region's bottom
    lla     sp, once_region_end         # the stack pointer: its top
    j       once_main
.size _start, .-_start
