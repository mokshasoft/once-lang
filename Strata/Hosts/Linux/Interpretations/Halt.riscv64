#
# `I.Halt` under the Linux Host, riscv64 (plan 0.140 §3.4–3.5): the run ends
# `halted`, which Linux reports as exit status 2 (`returned` is 0, `exhausted`
# is SIGABRT). The argument is Unit; the routine never returns.

.equ SYS_exit_group, 94
.equ END_HALTED, 2

.text
.global halt
.type halt, @function
halt:
    li      a0, END_HALTED
    li      a7, SYS_exit_group
    ecall
.size halt, .-halt
