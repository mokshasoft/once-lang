# ======================================================================
# The seL4 Host — x86_64 (D320, plan 0.127)
#
# A Host is how a platform runs a program: `enter ; main ; leave`.
#
# `enter` (`once_sel4_enter`, the ELF entry: `Host.x86_64.ld`). The kernel
# starts the root task at the ELF entry with the bootinfo pointer in `rdi`
# and no stack (seL4 `create_initial_thread`). `_start` needs a stack, so
# `enter` sets `%rsp` to a static stack, saves the bootinfo pointer for the
# Interpretations (`once_sel4_bootinfo`), and jumps to `_start`. This is
# what seL4's own runtime does for C (`sel4runtime`, `_sel4_start`).
#
# An image may hold further programs (plan 0.127 B.1): program 0 is the
# root task; programs 1-3 are linked beside it with their `_start`
# renamed `once_program_<n>` (weak here: an image without them links).
# `I.SeL4.Program.start` starts one on a thread at its start, on its
# stack below; its `_start` sets its own heap. `once_sel4_self` answers
# which program the calling thread runs, from its stack pointer.
#
# The Interpretations' shared routines are here too, since every seL4
# program links this Host: `once_sel4_flatten` / `once_sel4_build` (a
# SigOp's tuple argument and answer) and `once_sel4_invoke` (an object
# invocation).
#
# `leave` (`once_leave`): calling it ends the run, observed as `returned`.
# The program prints a fixed line on the debug console (debug kernel)
# and suspends its own thread (the root task's is `seL4_CapInitThreadTCB`,
# a started program's is the TCB it was started on).
#
# The seL4 numbers are the kernel's names (non-MCS, debug, printing),
# checked against the pinned kernel's headers (examples/seL4
# `check-numbers.sh`). A syscall saves `%rsp` in `%rbx` around `syscall`,
# as libsel4 does.
# ======================================================================

# seL4 numbers
.equ SysCall, -1
.equ SysYield, -7
.equ SysDebugPutChar, -9
.equ seL4_CapInitThreadTCB, 1
.equ SUSPEND_INFO, 0xB000           # = MSG_INFO(TCBSuspend, 0, 0, 0)
.equ MSG_LABEL_SHIFT, 12            # = __builtin_ctzl(MSG_INFO(1, 0, 0, 0))
.equ MSG_EXTRA_CAPS_SHIFT, 7        # = __builtin_ctzl(MSG_INFO(0, 0, 1, 0))
.equ MSG_EXTRA_CAPS_MASK, 3         # = MSG_INFO(0, 0, 3, 0) >> __builtin_ctzl(MSG_INFO(0, 0, 1, 0))
.equ MSG_LENGTH_MASK, 0x7f          # = MSG_INFO(0, 0, 0, 0x7f)
.equ BI_IPC_BUFFER, 0x20            # = offsetof(seL4_BootInfo, ipcBuffer)
.equ IPC_MSG, 8                     # = offsetof(seL4_IPCBuffer, msg)
.equ IPC_CAPS, 976                  # = offsetof(seL4_IPCBuffer, caps_or_badges)
# end seL4 numbers

.equ ROOT_STACK_SIZE,         65536
.equ PROGRAM_SLOTS,           4
.equ PROGRAM_STACK_SIZE,      65536
.equ PROGRAM_STACK_SHIFT,     16          # log2 PROGRAM_STACK_SIZE

.bss
.align 16
once_sel4_stack:
    .space ROOT_STACK_SIZE
once_sel4_stack_top:

.global once_sel4_bootinfo
.align 8
once_sel4_bootinfo:
    .space 8

# Programs 1..PROGRAM_SLOTS-1: one stack each
.align 16
once_sel4_program_stacks:
    .space (PROGRAM_SLOTS - 1) * PROGRAM_STACK_SIZE
once_sel4_program_stacks_end:

# Per program: the TCB and the Int it was started with (0: root task)
.global once_sel4_program_tcb
.align 8
once_sel4_program_tcb:
    .space 8 * PROGRAM_SLOTS
.global once_sel4_program_arg
once_sel4_program_arg:
    .space 8 * PROGRAM_SLOTS

.data
.weak once_program_1
.weak once_program_2
.weak once_program_3

# Per program: its start (0: the image has no such program)
.global once_sel4_program_entry
.align 8
once_sel4_program_entry:
    .quad 0
    .quad once_program_1
    .quad once_program_2
    .quad once_program_3

# Per program: its initial stack pointer (the top of its stack, less 16)
.global once_sel4_program_sp
once_sel4_program_sp:
    .quad 0
    .quad once_sel4_program_stacks + 1 * PROGRAM_STACK_SIZE - 16
    .quad once_sel4_program_stacks + 2 * PROGRAM_STACK_SIZE - 16
    .quad once_sel4_program_stacks + 3 * PROGRAM_STACK_SIZE - 16

.section .rodata
once_sel4_leave_line:
    .ascii "Once: returned\n"
once_sel4_leave_line_end:

.text
.global once_sel4_enter
.type once_sel4_enter, @function
once_sel4_enter:
    leaq    once_sel4_stack_top(%rip), %rsp
    movq    %rdi, once_sel4_bootinfo(%rip)
    jmp     _start
.size once_sel4_enter, .-once_sel4_enter

# once_sel4_self: the program the calling thread runs, in rax (0 for the
# root task: a stack pointer outside the programs' stacks). Preserves
# every other register.
.global once_sel4_self
.type once_sel4_self, @function
once_sel4_self:
    pushq   %rcx
    leaq    once_sel4_program_stacks(%rip), %rcx
    movq    %rsp, %rax
    subq    %rcx, %rax
    jb      1f                          # below the programs' stacks
    leaq    once_sel4_program_stacks_end(%rip), %rcx
    cmpq    %rcx, %rsp
    jae     1f                          # above them
    shrq    $PROGRAM_STACK_SHIFT, %rax
    incq    %rax
    popq    %rcx
    ret
1:  xorq    %rax, %rax
    popq    %rcx
    ret
.size once_sel4_self, .-once_sel4_self

# once_sel4_flatten: the left-nested n-tuple at rdi (n >= 2, in rcx) into
# the words at rsi, in order: how the Interpretations read a SigOp's
# argument (a pair is a cell [fst, snd]). Clobbers rax, rcx, rdi.
.global once_sel4_flatten
.type once_sel4_flatten, @function
once_sel4_flatten:
1:  cmpq    $1, %rcx
    je      2f
    decq    %rcx
    movq    8(%rdi), %rax
    movq    %rax, (%rsi,%rcx,8)
    movq    (%rdi), %rdi
    jmp     1b
2:  movq    %rdi, (%rsi)
    ret
.size once_sel4_flatten, .-once_sel4_flatten

# once_sel4_build: the n words at rsi (n >= 2, in rcx) as a left-nested
# tuple allocated at the heap pointer r15 (advanced); the tuple in rax.
# Clobbers rdx, r8.
.global once_sel4_build
.type once_sel4_build, @function
once_sel4_build:
    movq    (%rsi), %rax
    movq    $1, %r8
1:  cmpq    %rcx, %r8
    je      2f
    movq    %rax, 0(%r15)
    movq    (%rsi,%r8,8), %rdx
    movq    %rdx, 8(%r15)
    movq    %r15, %rax
    addq    $16, %r15
    incq    %r8
    jmp     1b
2:  ret
.size once_sel4_build, .-once_sel4_build

# once_sel4_invoke: an object invocation, seL4_Call on cap rdi with
# message info rsi; message words at r12 (at least 4: words 0-3 go in
# r10, r8, r9, r15), extra caps at r13. Words 4.. and the extra caps go
# in the root task's IPC buffer (`bootinfo->ipcBuffer`; only the root
# task has one). Answers the reply's label, the seL4_Error, in rax.
# Clobbers everything but rsp, rbp, r12, r13: the caller saves r15.
.global once_sel4_invoke
.type once_sel4_invoke, @function
once_sel4_invoke:
    movq    once_sel4_bootinfo(%rip), %r14
    movq    BI_IPC_BUFFER(%r14), %r14
    movq    %rsi, %rcx                  # the extra caps
    shrq    $MSG_EXTRA_CAPS_SHIFT, %rcx
    andq    $MSG_EXTRA_CAPS_MASK, %rcx
    xorq    %rdx, %rdx
1:  cmpq    %rcx, %rdx
    je      2f
    movq    (%r13,%rdx,8), %rax
    movq    %rax, IPC_CAPS(%r14,%rdx,8)
    incq    %rdx
    jmp     1b
2:  movq    %rsi, %rcx                  # the length
    andq    $MSG_LENGTH_MASK, %rcx
    movq    $4, %rdx
3:  cmpq    %rcx, %rdx
    jae     4f
    movq    (%r12,%rdx,8), %rax
    movq    %rax, IPC_MSG(%r14,%rdx,8)
    incq    %rdx
    jmp     3b
4:  movq    0(%r12), %r10
    movq    8(%r12), %r8
    movq    16(%r12), %r9
    movq    24(%r12), %r15
    movq    $SysCall, %rdx
    movq    %rsp, %rbx
    syscall
    movq    %rbx, %rsp
    movq    %rsi, %rax                  # the reply's label: the error
    shrq    $MSG_LABEL_SHIFT, %rax
    ret
.size once_sel4_invoke, .-once_sel4_invoke

.global once_leave
.type once_leave, @function
once_leave:
    leaq    once_sel4_leave_line(%rip), %r12
    leaq    once_sel4_leave_line_end(%rip), %r13
1:  cmpq    %r13, %r12
    je      2f
    movzbq  (%r12), %rdi
    movq    $SysDebugPutChar, %rdx
    movq    %rsp, %rbx
    syscall
    movq    %rbx, %rsp
    incq    %r12
    jmp     1b
    # seL4_TCB_Suspend(own TCB): seL4_Call with label TCBSuspend and no
    # message words
2:  movq    $seL4_CapInitThreadTCB, %rdi
    call    once_sel4_self
    testq   %rax, %rax
    jz      3f
    leaq    once_sel4_program_tcb(%rip), %rcx
    movq    (%rcx,%rax,8), %rdi
3:  movq    $SUSPEND_INFO, %rsi
    movq    $SysCall, %rdx
    movq    %rsp, %rbx
    syscall
    movq    %rbx, %rsp
    # Not reached: a suspended thread never runs again
4:  movq    $SysYield, %rdx
    movq    %rsp, %rbx
    syscall
    movq    %rbx, %rsp
    jmp     4b
.size once_leave, .-once_leave
