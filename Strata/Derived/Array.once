-- | Derived array operations (D042, D044, D046)
--
-- Higher-level array operations implemented in Once using
-- the primitives from I.Linux.Array.
--
-- D044: All operations are PURE (not wrapped in Eff).
-- Arrays are values. Write operations return the updated array.
-- QTT handles in-place vs copy-on-write automatically.
--
-- D046: Uses generic read/write primitives - compiler generates
-- inline code based on element type.
--
-- Uses recursion (D040) for iteration patterns.

import I.Linux.Array as A
import I.Linux.Control as C
import I.Linux.Arith as AR

------------------------------------------------------------------------
-- Swap operation (pure)
------------------------------------------------------------------------

-- | Swap elements at two positions in an Int array
-- swap (array, (i, j)) returns array with array[i] and array[j] swapped
-- Input is nested pair: (Array Int * (Int * Int))
-- Note: Currently Int-specific for primitive family monomorphization.
-- TODO: Add polymorphic version when type specialization is implemented.
swap : Array Int * (Int * Int) -> Array Int
swap = \args ->
  let a = fst args in
  let ij = snd args in
  let i = fst ij in
  let j = snd ij in
  let vi = unsafeRead@A (a, i) in
  let vj = unsafeRead@A (a, j) in
  let a1 = unsafeWrite@A (a, (i, vj)) in
  unsafeWrite@A (a1, (j, vi))

------------------------------------------------------------------------
-- Reverse prefix operation (pure)
------------------------------------------------------------------------

-- | Reverse the first k elements of an array (0 to k-1)
-- Uses recursive approach (D040)
--
-- Input: (Array Int * (Int * Int)) = (array, (lo, hi))
-- Returns: updated array with prefix reversed
--
-- Note: Stop when diff <= 1 (0 or 1 elements left). We check this by
-- first checking if diff == 0, then if diff == 1 via (diff - 1) == 0.
reversePrefixLoop : Array Int * (Int * Int) -> Array Int
reversePrefixLoop = \args ->
  let a = fst args in
  let lohi = snd args in
  let lo = fst lohi in
  let hi = snd lohi in
  let diff = sub@AR (hi, lo) in
  case ifZero@C diff of {
    Left done -> a;
    Right cont ->
      -- Also check if diff == 1 (one element left, no swap needed)
      let diffMinus1 = sub@AR (diff, 1) in
      case ifZero@C diffMinus1 of {
        Left oneElement -> a;
        Right moreThanOne ->
          let lo1 = add@AR (lo, 1) in
          let hi1 = sub@AR (hi, 1) in
          let swapArgs = (a, (lo, hi1)) in
          let a1 = swap swapArgs in
          let nextArgs = (a1, (lo1, hi1)) in
          reversePrefixLoop nextArgs
      }
  }

-- | Reverse first k elements (pure)
-- reversePrefix (array, k) returns array with array[0]..array[k-1] reversed
reversePrefix : Array Int * Int -> Array Int
reversePrefix = \args ->
  let a = fst args in
  let k = snd args in
  let loopArgs = (a, (0, k)) in
  reversePrefixLoop loopArgs

------------------------------------------------------------------------
-- Initialize array with range (pure)
------------------------------------------------------------------------

-- | Initialize array with values [0, 1, 2, ..., n-1]
-- Input: (Array Int * (Int * Int)) = (array, (i, n))
-- Returns: updated array with values written
initRangeLoop : Array Int * (Int * Int) -> Array Int
initRangeLoop = \args ->
  let a = fst args in
  let in_ = snd args in
  let i = fst in_ in
  let n = snd in_ in
  let diff = sub@AR (n, i) in
  case ifZero@C diff of {
    Left done -> a;
    Right cont ->
      let i1 = add@AR (i, 1) in
      let writeArgs = (a, (i, i)) in
      let a1 = unsafeWrite@A writeArgs in
      let nextArgs = (a1, (i1, n)) in
      initRangeLoop nextArgs
  }

-- | Initialize array with range [0..n-1] (pure)
-- Returns: updated array
initRange : Array Int * Int -> Array Int
initRange = \args ->
  let a = fst args in
  let n = snd args in
  let loopArgs = (a, (0, n)) in
  initRangeLoop loopArgs

------------------------------------------------------------------------
-- Copy array (pure)
------------------------------------------------------------------------

-- | Copy n integers from src to dest (element by element)
-- Input: (dest, (src, (i, n)))
-- Returns: updated dest array
copyLoop : Array Int * (Array Int * (Int * Int)) -> Array Int
copyLoop = \args ->
  let dest = fst args in
  let rest1 = snd args in
  let src = fst rest1 in
  let in_ = snd rest1 in
  let i = fst in_ in
  let n = snd in_ in
  let diff = sub@AR (n, i) in
  case ifZero@C diff of {
    Left done -> dest;
    Right cont ->
      let v = unsafeRead@A (src, i) in
      let i1 = add@AR (i, 1) in
      let writeArgs = (dest, (i, v)) in
      let dest1 = unsafeWrite@A writeArgs in
      let nextArgs = (dest1, (src, (i1, n))) in
      copyLoop nextArgs
  }

-- | Copy first n elements from src to dest (pure)
-- Returns: updated dest array
copyArray : Array Int * (Array Int * Int) -> Array Int
copyArray = \args ->
  let dest = fst args in
  let rest1 = snd args in
  let src = fst rest1 in
  let n = snd rest1 in
  let loopArgs = (dest, (src, (0, n))) in
  copyLoop loopArgs

------------------------------------------------------------------------
-- Fill array with value (pure)
------------------------------------------------------------------------

-- | Fill array with a value from index i to n-1
-- Input: (array, (value, (i, n)))
-- Returns: updated array
fillLoop : Array Int * (Int * (Int * Int)) -> Array Int
fillLoop = \args ->
  let a = fst args in
  let rest = snd args in
  let value = fst rest in
  let in_ = snd rest in
  let i = fst in_ in
  let n = snd in_ in
  let diff = sub@AR (n, i) in
  case ifZero@C diff of {
    Left done -> a;
    Right cont ->
      let i1 = add@AR (i, 1) in
      let a1 = unsafeWrite@A (a, (i, value)) in
      fillLoop (a1, (value, (i1, n)))
  }

-- | Fill first n elements with value (pure)
-- Returns: updated array
fill : Array Int * (Int * Int) -> Array Int
fill = \args ->
  let a = fst args in
  let vn = snd args in
  let value = fst vn in
  let n = snd vn in
  fillLoop (a, (value, (0, n)))

------------------------------------------------------------------------
-- Rotate operation (pure)
------------------------------------------------------------------------

-- | Rotate elements: move a[0] to a[k], shift a[1..k] left to a[0..k-1]
-- Input: (array, (first, (i, k))) where first is the saved first element
-- Shifts a[i+1] to a[i] until i == k
rotateLoop : Array Int * (Int * (Int * Int)) -> Array Int
rotateLoop = \args ->
  let a = fst args in
  let rest = snd args in
  let first = fst rest in
  let ik = snd rest in
  let i = fst ik in
  let k = snd ik in
  let diff = sub@AR (k, i) in
  case ifZero@C diff of {
    Left done ->
      -- i == k, put first at position k
      unsafeWrite@A (a, (k, first));
    Right cont ->
      -- Shift: a[i] = a[i+1]
      let i1 = add@AR (i, 1) in
      let val = unsafeRead@A (a, i1) in
      let a1 = unsafeWrite@A (a, (i, val)) in
      rotateLoop (a1, (first, (i1, k)))
  }

-- | Rotate first k+1 elements: a[0] moves to a[k], others shift left
-- rotate (array, k) where k is the last position
rotate : Array Int * Int -> Array Int
rotate = \args ->
  let a = fst args in
  let k = snd args in
  let first = unsafeRead@A (a, 0) in
  rotateLoop (a, (first, (0, k)))
