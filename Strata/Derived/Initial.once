-- | Initial - Data types as initial algebras
--
-- Basic sum types: Bool, Maybe, Result
--
-- Note: The `case` generator cannot be used standalone due to parser
-- conflict with `case...of` expression syntax.

------------------------------------------------------------------------
-- Bool
------------------------------------------------------------------------

type Bool = Unit + Unit

true : Unit -> Bool
true = compose inl terminal

false : Unit -> Bool
false = compose inr terminal

------------------------------------------------------------------------
-- Maybe
------------------------------------------------------------------------

type Maybe A = Unit + A

nothingM : Unit -> Maybe A
nothingM = compose inl terminal

just : A -> Maybe A
just = inr

------------------------------------------------------------------------
-- Result
------------------------------------------------------------------------

type Result A E = A + E

ok : A -> Result A E
ok = inl

errR : E -> Result A E
errR = inr
