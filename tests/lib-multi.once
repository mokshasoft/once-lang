-- lib-multi.once: a LIBRARY with several concrete interface functions (no
-- `main`). Each concrete signature is an anchor (the "concrete = interface"
-- model); the polymorphic builtins (`fst`, `snd`, `pair`, `id`) are
-- instantiated at each signature's type. No polymorphic signatures, no entry
-- point. Compiled to x86_64 assembly.

firstOf : Int * Int -> Int
firstOf = fst

secondOf : Int * Int -> Int
secondOf = snd

dupInt : Int -> Int * Int
dupInt = pair id id
