------------------------------------------------------------------------
-- Once.CompileX86v3
--
-- Single entry point for x86v3 compilation: source text → assembly text.
--
-- Pipeline:
--   1. Parse source text to Module
--   2. Extract functions with type signatures
--   3. For each function:
--      a. Type check and elaborate (RawExpr → SurfaceExpr)
--      b. Elaborate to IR (SurfaceExpr → Once.IR)
--      c. Optimize (categorical laws)
--      d. Convert to CCC.IR (for backend)
--      e. Code generate (CCC.IR → x86 instructions)
--      f. Emit (instructions → assembly text)
--   4. Concatenate all function assembly
--
-- The Haskell CLI handles I/O:
--   - Read source file
--   - Call compileX86v3
--   - Write .s file
--   - Invoke assembler/linker
------------------------------------------------------------------------

module Once.CompileX86v3 where

open import Data.List using (List; []; _∷_)
open import Data.Maybe using (Maybe; just; nothing)
open import Data.String using (String; _++_)
open import Data.Sum using (_⊎_; inj₁; inj₂)
open import Data.Product using (_×_; _,_)
open import Data.Nat using (ℕ)

-- Parser
open import Once.Parser using (parse; Module; extractFunctions; extractAliases)
open import Once.Parser using (FunInfo; mkFunInfo)
open FunInfo

-- Type system
open import Once.Type using (Type; Unit)
open import Once.TypeCheck.Raw using (RawExpr)

-- Type checking / elaboration
open import Once.TypeCheck.Elaborate using (ctxWithImportsAndSelf; checkElab)
open import Once.TypeCheck.Elaborate as TE using (CheckElabResult)

-- Surface → IR elaboration
open import Once.Surface.Elaborate using (elaborate)
open import Once.Surface.Syntax as SS using (Ctx; ∅)

-- IR and optimization
open import Once.IR as OnceIR using (IR)
open import Once.Optimize using (optimize)

-- CCC.IR (backend IR with free-heap)
open import Once.CCC.IR as CCCIR using (fromOnceIR)

-- X86v3 code generation and emission
open import Once.CCC.Target.X86v3.CodeGen using (compile-ir)
open import Once.Target.X86.Emit using (programToText)

------------------------------------------------------------------------
-- Helper: Function prologue/epilogue
------------------------------------------------------------------------

-- | Generate function prologue (label + ABI setup)
functionPrologue : String → String
functionPrologue fname =
  ".globl once_" ++ fname ++ "\n" ++
  "once_" ++ fname ++ ":\n"

-- | Generate function epilogue
functionEpilogue : String
functionEpilogue = "    ret\n\n"

------------------------------------------------------------------------
-- Helper: Compile a single function
------------------------------------------------------------------------

-- | Compile a single function: typecheck → elaborate → optimize → codegen → emit
-- Returns assembly text or error message
compileFunctionX86v3 : String → Type → RawExpr → String ⊎ String
compileFunctionX86v3 name ty rawExpr with checkElab (ctxWithImportsAndSelf [] name ty) rawExpr ty
... | TE.failure err = inj₁ ("Type error in " ++ name ++ ": " ++ err)
... | TE.success surfaceExpr _ _ _ =
      -- Elaborate Surface → Once.IR (from empty context, so result type is IR Unit A)
      let onceIR : OnceIR.IR Unit ty
          onceIR = elaborate surfaceExpr
          -- Optimize
          optimizedIR = optimize onceIR
          -- Convert to CCC.IR for backend
          cccIR = fromOnceIR optimizedIR
          -- Generate x86 code and emit
          program = compile-ir cccIR
          asmText = programToText program
      in inj₂ (functionPrologue name ++ asmText ++ functionEpilogue)

------------------------------------------------------------------------
-- Helper: Compile all functions from a module
------------------------------------------------------------------------

-- | Compile all functions, accumulating results
-- Returns first error or all assembly concatenated
compileAllFunctions : List FunInfo → String ⊎ String
compileAllFunctions [] = inj₂ ""
compileAllFunctions (fi ∷ rest) with compileFunctionX86v3 (funName fi) (funType fi) (funBody fi)
... | inj₁ err = inj₁ err
... | inj₂ asm with compileAllFunctions rest
...   | inj₁ err = inj₁ err
...   | inj₂ restAsm = inj₂ (asm ++ restAsm)

------------------------------------------------------------------------
-- Main Entry Point
------------------------------------------------------------------------

-- | Assembly file header (data section, etc.)
asmHeader : String
asmHeader =
  "# Generated by Once compiler (x86v3 backend)\n" ++
  ".section .text\n\n"

-- | Compile source text to x86-64 assembly
-- Returns: Left error | Right assembly
compileX86v3 : String → String ⊎ String
compileX86v3 source with parse source
... | nothing = inj₁ "Parse error: failed to parse module"
... | just mod =
      let aliases = extractAliases mod
          funs = extractFunctions aliases mod
      in go funs
  where
    go : List FunInfo → String ⊎ String
    go funs with compileAllFunctions funs
    ... | inj₁ err = inj₁ err
    ... | inj₂ asm = inj₂ (asmHeader ++ asm)

------------------------------------------------------------------------
-- Summary
--
-- compileX86v3 is the single entry point for x86v3 compilation.
--
-- The Haskell CLI (Once.CLI) only handles I/O:
--   1. Read source file
--   2. Call MAlonzo.Code.Once.CompileX86v3.d_compileX86v3
--   3. Write result to .s file (if Right) or print error (if Left)
--   4. Invoke `as` and `ld` for final executable
--
-- All actual compilation logic is in Agda, verified and extracted via MAlonzo.
------------------------------------------------------------------------
