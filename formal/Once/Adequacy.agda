-- Once.Adequacy — THE SPEC OF "WHAT A CORRECT COMPILER IS"
--
-- ╔══════════════════════════════════════════════════════════════════╗
-- ║  DO NOT EDIT THIS FILE.                                          ║
-- ║                                                                  ║
-- ║  This module states what compiler correctness means. It is       ║
-- ║  intentionally minimal and intentionally stable. The ONLY        ║
-- ║  reason to modify it is if the mathematical notion of            ║
-- ║  correctness itself changes — for example, replacing             ║
-- ║  propositional `≡` with a bisimulation relation. Even that is    ║
-- ║  rare; treat it as a one-way ratchet that requires rederiving    ║
-- ║  every existing instance proof.                                  ║
-- ║                                                                  ║
-- ║  Things that are NOT valid reasons to edit this file:            ║
-- ║    - "the language gained a feature"  → instance change          ║
-- ║    - "the implementation outputs more than one artefact"         ║
-- ║                                       → encode in `Bytes`        ║
-- ║    - "compilation became concurrent"  → orthogonal               ║
-- ║    - "we want to weaken the claim to make a proof easier"        ║
-- ║                                       → DO NOT                   ║
-- ║    - any pressure from code review, refactor, or build           ║
-- ║                                       → instance file            ║
-- ║                                                                  ║
-- ║  The shape `Source → Maybe Bytes` is intentionally general       ║
-- ║  enough to absorb any future variation — separate compilation,   ║
-- ║  multi-artefact outputs, concurrent builds — by changing what    ║
-- ║  the instance picks for `Source` and `Bytes`. The spec stays.    ║
-- ║                                                                  ║
-- ║  All concrete types, semantics, and the actual compile function  ║
-- ║  live in instance files (e.g. `Once.Compiler`) that construct    ║
-- ║  a `CorrectCompiler` value. Until every field — including        ║
-- ║  `correct` — is filled in, no compiler value exists, the CLI    ║
-- ║  cannot project `compile` out, and no binary can be produced.    ║
-- ║  Filling `correct` is the work; doing so via `postulate` is      ║
-- ║  permitted but every such postulate is NAMED, lives in the       ║
-- ║  instance file, and is listed by `make postulates`.              ║
-- ╚══════════════════════════════════════════════════════════════════╝
------------------------------------------------------------------------

module Once.Adequacy where

open import Data.Bool using (Bool)
open import Data.Maybe using (Maybe; just; nothing; map)
open import Data.Maybe.Relation.Binary.Pointwise using (Pointwise)

record CorrectCompiler : Set₁ where
  field
    -- The abstract types. Each instance picks concrete inhabitants.
    Arch     : Set
    Source   : Set
    Bytes    : Set
    Behavior : Set

    -- Source and target semantics. Behavioural EQUIVALENCE (`_≈_`) is
    -- what "the compiled program does the same thing as the source"
    -- ultimately reduces to — stated as an abstract relation, not raw
    -- `≡`, so the certificate stays observable-agnostic AND funext-free:
    -- for the SigOp-trace observable (`Behavior = ℕ → List SigOpEvent`)
    -- the instance picks pointwise / up-to-`n` prefix equality (Plan 0.44).
    -- The source meaning is TOTAL: a well-formed source denotes `just`
    -- its SigOp trace; an INVALID source (ill-typed / unparseable) denotes
    -- `nothing` — it has no behaviour. Making `⟦_⟧` total is what lets the
    -- single `correct` below subsume soundness and completeness.
    ⟦_⟧  : Source → Maybe Behavior
    exec : Arch → Bytes → Behavior
    _≈_  : Behavior → Behavior → Set

    -- The compiler. `Bool` selects whether the optimizer runs; correctness
    -- is required for BOTH settings, so the optimizer can never be
    -- load-bearing for correctness (it may only PRESERVE an already-correct
    -- result — it cannot mask a bug from another stage). May fail.
    compile : Arch → Bool → Source → Maybe Bytes

    -- THE claim — one unconditional statement. The behaviour the compiler
    -- exhibits on `src` (run the bytes if it accepts, `nothing` if it
    -- rejects) equals the source's meaning, for EVERY source and either
    -- optimizer setting. Via `Pointwise` (`just ≁ nothing`) this is:
    --   • soundness     — `⟦src⟧ = nothing` forces `compile = nothing`;
    --   • completeness  — `⟦src⟧ = just _` forces `compile = just _`;
    --   • trace-correct — accepted ⇒ `exec bytes ≈ ⟦src⟧`.
    correct : ∀ arch doOpt src →
              Pointwise _≈_ (map (exec arch) (compile arch doOpt src)) (⟦ src ⟧)
