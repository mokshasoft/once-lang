------------------------------------------------------------------------
-- Once.Target.X86-32
--
-- x86-32 target implementation.
--
-- Code generation goes via the shared abstract-trace pipeline:
--   IR  ──Once.CCC.Codegen.IRToTrace──▶  AbstractTrace
--       ──AbstractToX86-32.compile-trace──▶  X86-32.Program
--       ──Emit.programToText──▶  String
--
-- Stubbed IR cases (pair, curry, apply, recursion schemes, SigOp)
-- produce empty traces → empty function bodies. Implementing them
-- requires slot-tracking and per-arch closure addressing; tracked
-- in IRToTrace's coverage notes.
------------------------------------------------------------------------

module Once.Target.X86-32 where

open import Data.String using (String; _++_)

open import Once.Target using (Target)
open import Once.Target.Symbol using (once-symbol; once-symbol-own)
open import Once.IR using (IR)

open import Once.CCC.Codegen.IRToTrace using (ir-to-trace; ir-to-trace-from)
open import Data.Nat using (ℕ)
open import Data.Product using (_×_; _,_)
open import Once.CCC.Target.X86-32.AbstractToX86-32 using (compile-trace)
open import Once.CCC.Target.X86-32.Emit using (programToText)

------------------------------------------------------------------------
-- x86-32 Assembly Format (System V i386 ABI, GAS syntax)
------------------------------------------------------------------------

x86-32-asmHeader : String
x86-32-asmHeader =
  "# Generated by Once compiler (x86-32 target)\n" ++
  ".section .text\n\n"

x86-32-functionPrologue : String → String
x86-32-functionPrologue fname =
  ".globl " ++ once-symbol-own fname ++ "\n" ++
  once-symbol-own fname ++ ":\n"

-- | Plan 0.2.4.2 Phase B: closure-body emission stub.
-- Plan 0.12 Layer 1: takes a starting label counter for symmetry
-- with the x86-64 backend; x86-32 doesn't actually emit thunks
-- yet so the counter passes through unchanged.
x86-32-irToBodies : ℕ → ∀ {A B} → IR A B → ℕ × String
x86-32-irToBodies l _ = l , ""

x86-32-functionEpilogue : String
x86-32-functionEpilogue = "    ret\n\n"

------------------------------------------------------------------------
-- IR → Assembly
------------------------------------------------------------------------

-- Plan 0.12 Layer 1: takes a starting label counter for symmetry
-- with the x86-64 backend; x86-32 doesn't currently emit thunks
-- so the counter passes through unchanged.
x86-32-irToAsm : ℕ → ∀ {A B} → IR A B → ℕ × String
x86-32-irToAsm l ir =
  let (l' , trace) = ir-to-trace-from l ir
  in l' , programToText (compile-trace trace)

------------------------------------------------------------------------
-- Target Instance
------------------------------------------------------------------------

x86-32 : Target
x86-32 = record
  { irToAsm          = x86-32-irToAsm
  ; irToBodies       = x86-32-irToBodies
  ; asmHeader        = x86-32-asmHeader
  ; functionPrologue = x86-32-functionPrologue
  ; functionEpilogue = x86-32-functionEpilogue
  ; emitArithBlocks  = λ _ → ""
  }
