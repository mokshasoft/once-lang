------------------------------------------------------------------------
-- Once.Target.RiscV64
--
-- RISC-V 64 target implementation.
--
-- Code generation goes via the shared abstract-trace pipeline:
--   IR  ──Once.CCC.Codegen.IRToTrace──▶  AbstractTrace
--       ──AbstractToRiscV.compile-trace──▶  RiscV64.Program
--       ──Emit.programToText──▶  String
--
-- Stubbed IR cases (pair, curry, apply, recursion schemes, SigOp)
-- produce empty traces → empty function bodies. Implementing them
-- requires slot-tracking and per-arch closure addressing; tracked
-- in IRToTrace's coverage notes.
------------------------------------------------------------------------

module Once.Target.RiscV64 where

open import Data.String using (String; _++_)

open import Once.Target using (Target)
open import Once.Target.Symbol using (once-symbol)
open import Once.CCC.IR using (IR)

open import Once.CCC.Codegen.IRToTrace using (ir-to-trace)
open import Once.CCC.Target.RiscV64.AbstractToRiscV using (compile-trace)
open import Once.CCC.Target.RiscV64.Emit using (programToText)

------------------------------------------------------------------------
-- RV64 Assembly Format (LP64 ABI, GAS syntax)
------------------------------------------------------------------------

riscv64-asmHeader : String
riscv64-asmHeader =
  "# Generated by Once compiler (RISC-V 64 target)\n" ++
  ".section .text\n\n"

riscv64-functionPrologue : String → String
riscv64-functionPrologue fname =
  ".globl " ++ once-symbol fname ++ "\n" ++
  once-symbol fname ++ ":\n"

-- | Plan 0.2.4.2 Phase B: closure-body emission stub.
riscv64-irToBodies : ∀ {A B} → IR A B → String
riscv64-irToBodies _ = ""

riscv64-functionEpilogue : String
riscv64-functionEpilogue = "    ret\n\n"

------------------------------------------------------------------------
-- IR → Assembly
------------------------------------------------------------------------

riscv64-irToAsm : ∀ {A B} → IR A B → String
riscv64-irToAsm ir = programToText (compile-trace (ir-to-trace ir))

------------------------------------------------------------------------
-- Target Instance
------------------------------------------------------------------------

riscv64 : Target
riscv64 = record
  { irToAsm          = riscv64-irToAsm
  ; irToBodies       = riscv64-irToBodies
  ; asmHeader        = riscv64-asmHeader
  ; functionPrologue = riscv64-functionPrologue
  ; functionEpilogue = riscv64-functionEpilogue
  }
