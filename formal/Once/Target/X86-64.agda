------------------------------------------------------------------------
-- Once.Target.X86-64
--
-- x86-64 target implementation.
-- Provides Target instance for x86-64 code generation.
------------------------------------------------------------------------

module Once.Target.X86-64 where

open import Data.String using (String; _++_)

open import Once.Target using (Target)
open import Once.CCC.IR using (IR)

-- x86-64 code generation and emission
open import Once.CCC.Target.X86-64.CodeGen.Compile using (compile-ir)
open import Once.CCC.Target.X86-64.Emit using (programToText)

------------------------------------------------------------------------
-- x86-64 Assembly Format
------------------------------------------------------------------------

x86-64-asmHeader : String
x86-64-asmHeader =
  "# Generated by Once compiler (x86-64 target)\n" ++
  ".section .text\n\n" ++
  -- Entry stub: invoke once_main, then apply the returned
  -- `Eff Unit Unit` closure (a [env, code] pair) to drive the
  -- effect. If the effect returns, exit(0) as a fallback.
  ".globl _start\n" ++
  "_start:\n" ++
  "    xorq %rdi, %rdi\n" ++        -- unit input (tt)
  "    callq once_main\n" ++         -- rax = closure pointer
  "    movq (%rax), %r12\n" ++       -- env ← closure[0]
  "    movq 8(%rax), %r15\n" ++      -- code ← closure[1]
  "    xorq %rdi, %rdi\n" ++         -- unit arg for the thunk
  "    callq *%r15\n" ++             -- invoke the thunk
  "    movq $60, %rax\n" ++          -- fallback: exit syscall
  "    xorq %rdi, %rdi\n" ++         --   status 0
  "    syscall\n\n"

x86-64-functionPrologue : String → String
x86-64-functionPrologue fname =
  ".globl once_" ++ fname ++ "\n" ++
  "once_" ++ fname ++ ":\n"

x86-64-functionEpilogue : String
x86-64-functionEpilogue = "    ret\n\n"

------------------------------------------------------------------------
-- IR → Assembly
------------------------------------------------------------------------

x86-64-irToAsm : ∀ {A B} → IR A B → String
x86-64-irToAsm ir = programToText (compile-ir ir)

------------------------------------------------------------------------
-- Target Instance
------------------------------------------------------------------------

x86-64 : Target
x86-64 = record
  { irToAsm          = x86-64-irToAsm
  ; asmHeader        = x86-64-asmHeader
  ; functionPrologue = x86-64-functionPrologue
  ; functionEpilogue = x86-64-functionEpilogue
  }
