------------------------------------------------------------------------
-- Once.CCC.Assembler
--
-- Assembly infrastructure: target architecture types and assembly file
-- generation (function wrapping with proper GAS directives).
--
-- The pure parts (target type, file extensions, directive generation)
-- are defined here and extracted via MAlonzo. The IO parts (invoking
-- the system assembler/linker) remain in the Haskell CLI layer.
--
-- For cross-compilation, set AS and LD environment variables:
--   AS=aarch64-linux-gnu-as LD=aarch64-linux-gnu-ld   for AArch64
--   AS=riscv64-linux-gnu-as LD=riscv64-linux-gnu-ld   for RISC-V64
------------------------------------------------------------------------

module Once.CCC.Assembler where

open import Data.String using (String; _++_)
open import Data.List using (List; []; _∷_; map; foldr)
open import Data.Product using (_×_; _,_)

------------------------------------------------------------------------
-- Target architecture
------------------------------------------------------------------------

-- | Compilation target
data Target : Set where
  C       : Target   -- C backend (default)
  X86-64  : Target   -- x86-64 assembly
  AArch64 : Target   -- ARM64 assembly
  RiscV64 : Target   -- RISC-V 64-bit assembly

-- | File extension for each target's output
targetExtension : Target → String
targetExtension C       = ".c"
targetExtension X86-64  = ".s"
targetExtension AArch64 = ".s"
targetExtension RiscV64 = ".s"

-- | Comment prefix for each target's assembly syntax
commentPrefix : Target → String
commentPrefix C       = "// "
commentPrefix X86-64  = "# "
commentPrefix AArch64 = "// "
commentPrefix RiscV64 = "# "

-- | Function type directive syntax
-- AArch64 uses %function, x86/RISC-V use @function
functionTypeDirective : Target → String
functionTypeDirective AArch64 = "%function"
functionTypeDirective _       = "@function"

-- | Return instruction for each architecture
retInstr : Target → String
retInstr X86-64  = "    retq"
retInstr AArch64 = "    ret"
retInstr RiscV64 = "    ret"
retInstr C       = ""

------------------------------------------------------------------------
-- Interpretation type (for multi-target interpretation resolution)
------------------------------------------------------------------------

-- | Interpretation implementation type
data InterpType : Set where
  InterpC       : InterpType   -- C implementation (.c)
  InterpX86-64  : InterpType   -- x86-64 assembly (.x86_64)
  InterpAArch64 : InterpType   -- ARM64 assembly (.arm64)
  InterpRiscV64 : InterpType   -- RISC-V assembly (.riscv64)

-- | File extension for each interpretation type
interpTypeExtension : InterpType → String
interpTypeExtension InterpC       = ".c"
interpTypeExtension InterpX86-64  = ".x86_64"
interpTypeExtension InterpAArch64 = ".arm64"
interpTypeExtension InterpRiscV64 = ".riscv64"

-- | Convert a target to its corresponding interpretation type
targetToInterp : Target → InterpType
targetToInterp C       = InterpC
targetToInterp X86-64  = InterpX86-64
targetToInterp AArch64 = InterpAArch64
targetToInterp RiscV64 = InterpRiscV64

------------------------------------------------------------------------
-- String helpers
------------------------------------------------------------------------

-- | Join strings with newlines
unlines : List String → String
unlines []           = ""
unlines (x ∷ [])     = x
unlines (x ∷ xs)     = x ++ "\n" ++ unlines xs

-- | Concatenate all strings in a list
concat : List String → String
concat = foldr _++_ ""

------------------------------------------------------------------------
-- Assembly wrapping: function definitions
------------------------------------------------------------------------

-- | Generate a single function definition with proper GAS directives.
-- Given the target, function name, and body text (from per-arch Emit),
-- produces the complete function definition.
wrapFunction : Target → String → String → String
wrapFunction t name body = unlines
  ( (".globl once_" ++ name)
  ∷ (".type once_" ++ name ++ ", " ++ functionTypeDirective t)
  ∷ ("once_" ++ name ++ ":")
  ∷ body
  ∷ retInstr t
  ∷ (".size once_" ++ name ++ ", .-once_" ++ name)
  ∷ [] )

------------------------------------------------------------------------
-- Assembly wrapping: library (multiple functions, no entry point)
------------------------------------------------------------------------

-- | Wrap multiple function definitions for library output.
-- Produces a .text section with all functions exported.
wrapLibrary : Target → List (String × String) → String
wrapLibrary t funcs =
  let header = (commentPrefix t ++ "Generated by Once (verified via MAlonzo)")
               ++ "\n" ++ ".text" ++ "\n\n"
      bodies = concat (map (λ { (name , body) → wrapFunction t name body ++ "\n" }) funcs)
  in header ++ bodies

------------------------------------------------------------------------
-- Assembly wrapping: executable (with _start entry point)
------------------------------------------------------------------------

-- | Generate _start entry point that calls once_main and exits.
-- Uses the appropriate syscall convention for each architecture.
startEntry : Target → String
startEntry AArch64 = unlines
  ( ""
  ∷ "// Entry point"
  ∷ ".globl _start"
  ∷ ".type _start, %function"
  ∷ "_start:"
  ∷ "    mov x0, #0"
  ∷ "    bl once_main"
  ∷ "    mov x8, #93"
  ∷ "    mov x0, #0"
  ∷ "    svc #0"
  ∷ ".size _start, .-_start"
  ∷ [] )
startEntry X86-64 = unlines
  ( ""
  ∷ "# Entry point"
  ∷ ".globl _start"
  ∷ ".type _start, @function"
  ∷ "_start:"
  ∷ "    xorq %rdi, %rdi"
  ∷ "    call once_main"
  ∷ "    movq $60, %rax"
  ∷ "    xorq %rdi, %rdi"
  ∷ "    syscall"
  ∷ ".size _start, .-_start"
  ∷ [] )
startEntry RiscV64 = unlines
  ( ""
  ∷ "# Entry point"
  ∷ ".globl _start"
  ∷ ".type _start, @function"
  ∷ "_start:"
  ∷ "    li a0, 0"
  ∷ "    call once_main"
  ∷ "    li a7, 93"
  ∷ "    li a0, 0"
  ∷ "    ecall"
  ∷ ".size _start, .-_start"
  ∷ [] )
startEntry C = ""

-- | Wrap multiple functions for executable output.
-- Includes .text section, all functions, and _start entry point.
wrapExecutable : Target → List (String × String) → String
wrapExecutable t funcs =
  let header = (commentPrefix t ++ "Generated by Once (verified via MAlonzo)")
               ++ "\n" ++ ".text" ++ "\n\n"
      bodies = concat (map (λ { (name , body) → wrapFunction t name body ++ "\n" }) funcs)
  in header ++ bodies ++ startEntry t
