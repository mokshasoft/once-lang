------------------------------------------------------------------------
-- Once.CCC.Target.RiscV64.File — plan 0.107: THE ASSEMBLY FILE as syntax.
--
-- What the compiler emits and what the CPU model decodes are the same object:
-- the instruction program, the index of its entry point (`_start`), the arith
-- blocks it carries (as the payloads the machine dispatches), and the external
-- symbols it calls (resolved by `ld` against the linked interpretation). The
-- emitted text is `print` of it — nothing the compiler decides lives outside
-- this record, so nothing can hide in the `as-faithful` trust point (D261).
--
-- PLATFORM-GENERAL: the only runtime data is a `.bss` heap (a linker-script
-- section on bare metal), and `_start` is ordinary code in `code`.
------------------------------------------------------------------------

module Once.CCC.Target.RiscV64.File where

open import Data.Bool using (true; false)
open import Data.List using (List; []; _∷_; _++_; map; length)
open import Data.List.Membership.Propositional using (_∈_)
open import Data.List.Relation.Unary.All using (All)
open import Data.List.Relation.Unary.Unique.Propositional using (Unique)
open import Data.Maybe using (Maybe; just; nothing)
open import Data.Nat using (ℕ; suc; _<_)
open import Data.Product using (_×_; _,_; proj₁)
open import Data.String using (String)
  renaming (_++_ to _++ˢ_)
open import Data.Sum using (_⊎_)
import Data.Unit

open import Once.CCC.Label using (labelSym; thunkSym)
open import Once.Target.AsmSymbol using (AsmSym)
open import Once.CCC.Target.RiscV64.Syntax
open import Once.CCC.Target.RiscV64.Emit using (instrToLine)
open import Once.Arith.Backend.XInstr.Syntax using (XProgram)
open import Once.Arith.Backend.RiscV64.Emit using (emit-payload)

-- What an arith block IS to the machine: its instructions and scratch need.
Payload : Set
Payload = XProgram × ℕ

record Image : Set where
  constructor mkImage
  field
    code    : Program                     -- `.text`, `_start` included
    entry   : Maybe ℕ                     -- where `_start` is (a library has none)
    blocks  : List (String × Payload)     -- the arith blocks, by symbol
    externs : List String                 -- symbols `ld` resolves elsewhere

open Image

------------------------------------------------------------------------
-- THE CANONICAL TEXT. The runtime's data (one `.bss` heap), then `.text` with
-- `_start` declared global at the entry index, then the arith blocks.
------------------------------------------------------------------------

heap-sym : String
heap-sym = "once_heap_base"

preamble : String
preamble =
  "# Generated by Once compiler (RISC-V 64 target)\n" ++ˢ
  ".section .bss\n" ++ˢ
  "    .align 16\n" ++ˢ
  heap-sym ++ˢ ":\n" ++ˢ
  "    .skip 65536\n\n" ++ˢ
  ".section .text\n\n"

start-mark : Maybe ℕ → ℕ → String
start-mark nothing  k = ""
start-mark (just e) k with e Data.Nat.≡ᵇ k
... | true  = ".globl _start\n_start:\n"
... | false = ""

code-text : Maybe ℕ → ℕ → Program → String
code-text e k []       = ""
code-text e k (i ∷ is) = start-mark e k ++ˢ instrToLine i ++ˢ code-text e (suc k) is

blocks-text : List (String × Payload) → String
blocks-text []               = ""
blocks-text ((s , p) ∷ bs)   = emit-payload s p ++ˢ blocks-text bs

-- D272: the externs are PART of the text. Leaving them out made `print` identify
-- images that differ only in `externs`, and `as-faithful` then proved ⊥.
externs-text : List String → String
externs-text []       = ""
externs-text (s ∷ ss) = ".extern " ++ˢ s ++ˢ "\n" ++ˢ externs-text ss

print : Image → String
print F = preamble ++ˢ externs-text (externs F) ++ˢ code-text (entry F) 0 (code F) ++ˢ blocks-text (blocks F)

------------------------------------------------------------------------
-- WHAT `as` (WITH `ld`) DEMANDS OF A FILE. Every symbol the text defines is
-- defined once; every symbol it references is defined in it or external; the
-- entry point is an instruction of it.
------------------------------------------------------------------------

label-defs : Program → List String
label-defs []              = []
label-defs (label l ∷ is)  = labelSym l ∷ label-defs is
{-# CATCHALL #-}
label-defs (_ ∷ is)        = label-defs is

ref-syms : Instr → List String
ref-syms (beq _ _ l)   = labelSym l ∷ []
ref-syms (bne _ _ l)   = labelSym l ∷ []
ref-syms (jal _ l)     = labelSym l ∷ []
ref-syms (j l)         = labelSym l ∷ []
ref-syms (lla _ n)     = thunkSym n ∷ []
ref-syms (lla-sym _ s) = s ∷ []
ref-syms (call-sym s)  = s ∷ []
{-# CATCHALL #-}
ref-syms _             = []

refs : Program → List String
refs []       = []
refs (i ∷ is) = ref-syms i ++ refs is

start-defs : Maybe ℕ → List String
start-defs nothing  = []
start-defs (just _) = "_start" ∷ []

defs : Image → List String
defs F = heap-sym ∷ start-defs (entry F) ++ label-defs (code F) ++ map proj₁ (blocks F)

EntryIn : Maybe ℕ → ℕ → Set
EntryIn nothing  n = Data.Unit.⊤
EntryIn (just e) n = e < n

record AsmWF (F : Image) : Set where
  field
    defined-once : Unique (defs F)
    resolved     : All (λ s → s ∈ defs F ⊎ s ∈ externs F) (refs (code F))
    entry-in     : EntryIn (entry F) (length (code F))
    -- D272: every symbol is one `as` reads as a symbol name, so no symbol can
    -- carry text of its own (a newline and an instruction) into the file.
    -- References need no clause: `resolved` puts each among these.
    defs-valid    : All AsmSym (defs F)
    externs-valid : All AsmSym (externs F)
