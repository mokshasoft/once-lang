-- | An item, its position erased.
data EItem : Set where
  etok     : Token → EItem
  ecomment : String → EItem
  econt    : EItem

erase : Item → EItem
erase (tok t)     = etok (forget t)
erase (comment c) = ecomment c
erase cont        = econt

