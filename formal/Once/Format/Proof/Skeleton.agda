------------------------------------------------------------------------
-- Once.Format.Proof.Skeleton — a declaration printed with two trivia
-- differs only at its anchors (plan 0.124 step 4.5).
--
-- The printer reads the trivia only at an anchor (its comments), so a
-- declaration printed with two trivia is one skeleton, the same documents
-- everywhere but at the anchors (`Sk`): at the k-th anchor each printing
-- holds that anchor's comments around the same token (`anchorDoc`). What is
-- not an anchor is plain (`plain`: tokens that are not anchors, blanks, line
-- breaks, nesting, groups). The skeleton is what the second formatting pass
-- is compared to the first through.
--
-- Generated by `scripts/gen-format-skel.py` (the printer induction is the
-- one `Proof.Canon` uses, `scripts/format_printers.py`): edit the generator,
-- not this file.
------------------------------------------------------------------------

module Once.Format.Proof.Skeleton where

open import Data.Bool using (Bool; true; false; not; _∧_; _∨_; if_then_else_; T)
open import Data.List using (List; []; _∷_; _++_; map)
open import Data.Maybe using (Maybe; just; nothing)
open import Data.Nat using (ℕ; zero; suc; _+_; _<ᵇ_; _≡ᵇ_; _∸_)
open import Data.Product using (_×_; _,_; proj₁; proj₂)
open import Data.String using (String; toList)
open import Data.Unit using (tt)
import Data.Char as Ch
open import Relation.Nullary using (does)
import Once.Spec.Surface.Lexing as S
open import Relation.Binary.PropositionalEquality using (_≡_; refl; sym; trans; cong; cong₂; subst)

open import Once.Spec.Grade using (Quantity; Zero; One; Many; pureᶠ; actᶠ)
open import Once.Spec.Surface.Syntax
open import Once.Spec.Name using (canonical)
open import Once.Spec.Surface.Lexing using (Token; TWord; TInt; TFloat; TNewline; TEOF)
open import Once.Format.Doc using (Doc; empty; tk; sp; cmt; para; line; newline; blank; eol; _<>_; nest; group;
  indent; flatWidth)
