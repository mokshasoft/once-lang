-- D394: the same arith tree over two input SHAPES is two blocks. `snd p + 1`
-- reads word 1 of an `Int * Int` and word 2 of an `(Int * Int) * Int` (the
-- flat layout, D390), so a block name without the shape linked both calls to
-- one body and `f (1, 2)` read past its pair.
--
-- f (1, 2) + g ((3, 4), 40) = 3 + 41.
--
-- Expected: exit code 44.

import I.Linux.Syscalls as S

f : Int * Int -> Int
f p = snd p + 1

g : Int * Int * Int -> Int
g q = snd q + 1

main : Act Unit Void
main = exit@S (f (1, 2) + g ((3, 4), 40))
