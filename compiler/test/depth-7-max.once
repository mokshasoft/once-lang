-- Test program with exactly 7 levels of nesting (maximum proven depth)
-- This should compile successfully

-- Depth 7: Seven nested lambdas
test7 : Unit -> Unit -> Unit -> Unit -> Unit -> Unit -> Unit -> (Unit * (Unit * (Unit * (Unit * (Unit * (Unit * Unit))))))
test7 = \a1 -> \a2 -> \a3 -> \a4 -> \a5 -> \a6 -> \a7 -> (a1, (a2, (a3, (a4, (a5, (a6, a7))))))