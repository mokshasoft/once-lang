-- Layer 3 test: sum nested inside a pair
-- Right branch fires; exercises snd through pair, then destruct on inr
-- Expected: trace [42]

import I.Test.Emit as E

main : Act Unit Unit
main = emit@E (destruct snd (1, (inr 42 : Int + Int)) of { Left x -> 99 ; Right y -> y })
