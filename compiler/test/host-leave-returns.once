-- D320: a program whose `main` RETURNS, without calling `exit`, ends by the
-- Host's `leave` (`enter ; main ; leave`): on Linux the run ends with status 0.
-- Before D320 the image ended `main` in a silent self-jump and the binary never
-- terminated.
--
-- Expected: exit code 0.

main : Eff Unit Unit
main = \u -> u
