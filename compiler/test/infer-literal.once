-- Type inference (D007): NO signatures. Each definition's type is fully
-- determined by the composition / the generators' fixed types — no
-- specialization, no ambiguity.
--
--   `code` : Int           (inferred from the integer literal)
--   `main` : Eff Unit Unit (inferred; `main` is canonically Eff Unit Unit)
--
-- Expected: exit code 7

import I.Linux.Syscalls as S

code = 7

main = exit@S code
