-- Type inference (D007/D072): a NESTED composition with a bare poly arm.
-- `compose id id : a -> a` (the oracle keeps the schema through the inner
-- compose), then the outer compose against `exit@S : Int -> Eff Unit Unit`
-- pins `a = Int`, so `run : Int -> Eff Unit Unit` — fully inferred, no
-- signatures anywhere.
--
-- Expected: exit code 7

import I.Linux.Syscalls as S

run = compose exit@S (compose id id)

main = run 7
