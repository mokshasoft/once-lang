-- Layer 4: partial application — `keepFst 42` stored as a top-level
-- fn, applied later. The closure with captured x=42 survives the
-- top-level def boundary. Expected: trace [42].
import I.Test.Emit as E

keepFst : Int -> Int -> Int
keepFst x y = x

partial : Int -> Int
partial = keepFst 42

main : Act Unit Unit
main = emit@E (partial 99)
