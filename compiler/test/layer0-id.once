-- Layer 0 test: identity function
-- Tests the simplest possible program using only `id`
-- Expected: trace [42]

import I.Test.Emit as E

-- emit@E applied to a value: `Act Int Unit` at a value is `Act Unit Unit`
main : Act Unit Unit
main = emit@E (id 42)
