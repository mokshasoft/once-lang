-- Type inference (D007): the type flows THROUGH a composition. `run` has no
-- signature; `compose exit@S id` is `exit@S ∘ id`, and the composition forces
-- `id`'s type to `Int -> Int` here (because `exit@S` consumes `Int`). The type
-- of `run` is fully determined — no signature, no specialization choice.
--
--   `run`  : Int -> Eff Unit Unit   (inferred from the composition)
--   `main` : Eff Unit Unit          (inferred)
--
-- Expected: exit code 5
-- D072: the principal-type oracle solves the composition's constraints
-- (unification), yielding the GROUND type `Int -> Eff Unit Unit` for
-- `run`; the verified elaborator re-checks the body at that type
-- (check-after-infer), so the oracle stays untrusted.

import I.Linux.Syscalls as S

run = compose exit@S id

main = run 5
