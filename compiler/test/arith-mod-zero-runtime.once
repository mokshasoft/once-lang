-- arith-mod-zero-runtime.once: D055 total remainder, RUNTIME zero divisor.
-- f 7 = 7 % (7 - 7) = 7 % 0 = 7 (dividend). x86 must guard, not trap.
-- Expected exit code 7.

import I.Linux.Syscalls as S

f : Int -> Int
f x = x % (x - x)

main : IO Unit
main = exit@S (f 7)
