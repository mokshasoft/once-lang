#
# x86_64 implementation of the test-framework `I.Test.Emit.emit` SigOp.
#
# The symbol is what the verified codegen emits for an IMPORTED SigOp:
# Once.Target.Symbol mangles the full canonical name `Interpretations.Test.Emit.emit`
# to `once_` + length-prefixed, `_`-joined parts. So:
#   emit  ->  once_15Interpretations_4Test_4Emit_4emit
# (15="Interpretations", 4="Test", 4="Emit", 4="emit"). This is the same scheme
# every shipped interpretation .x86_64 follows (e.g. Syscalls.x86_64's
# once_15Interpretations_5Linux_8Syscalls_4exit).
#
# Once SysV convention: the Int argument arrives in %rdi. `emit` writes its
# low byte to stdout (fd 1) so the emitted sequence is observable, then returns
# Unit (0).

.text
.align 16
.global once_15Interpretations_4Test_4Emit_4emit
.type once_15Interpretations_4Test_4Emit_4emit, @function
once_15Interpretations_4Test_4Emit_4emit:
    movb    %dil, -1(%rsp)      # stash the argument's low byte (red zone)
    leaq    -1(%rsp), %rsi      # rsi = buffer
    movq    $1, %rdi            # rdi = fd (stdout)
    movq    $1, %rdx            # rdx = count (1 byte)
    movq    $1, %rax            # rax = SYS_write
    syscall
    xorq    %rax, %rax          # return Unit (0)
    ret
.size once_15Interpretations_4Test_4Emit_4emit, .-once_15Interpretations_4Test_4Emit_4emit
