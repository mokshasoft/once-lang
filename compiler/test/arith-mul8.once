-- arith-mul8.once: multiply by a power-of-two literal. f x = x * 8; f 6 = 48.
-- Expected trace [48]. Exercises strength reduction (shl, not imul).

import I.Test.Emit as E

f : Int -> Int
f x = x * 8

main : Act Unit Unit
main = emit@E (f 6)
