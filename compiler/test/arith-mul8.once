-- arith-mul8.once: multiply by a power-of-two literal. f x = x * 8; f 6 = 48.
-- Expected exit code 48. Exercises strength reduction (shl, not imul).

import I.Linux.Syscalls as S

f : Int -> Int
f x = x * 8

main : IO Unit
main = exit@S (f 6)
