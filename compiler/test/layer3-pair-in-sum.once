-- Layer 3 test: pair nested inside a sum
-- Exercises: pair construction, inl, destruct, fst (Layer 1 + 2)
-- Expected: trace [42]

import I.Test.Emit as E

main : Act Unit Unit
main = emit@E (destruct (inl (42, 99) : Int * Int + Int) of { Left p -> fst p ; Right y -> y })
