-- Test program with 8 levels of nesting (exceeds proven limit)
-- This should be REJECTED by the type checker with depth error

-- Depth 8: Eight nested lambdas - should fail
test8 : Unit -> Unit -> Unit -> Unit -> Unit -> Unit -> Unit -> Unit -> (Unit * (Unit * (Unit * (Unit * (Unit * (Unit * (Unit * Unit)))))))
test8 = \a1 -> \a2 -> \a3 -> \a4 -> \a5 -> \a6 -> \a7 -> \a8 -> (a1, (a2, (a3, (a4, (a5, (a6, (a7, a8)))))))
