-- Plan 0.150: the remaining Float comparisons (float-cmp-order.once has the
-- other eight), one weighted bit each.
--
--   nan != nan            = 0 (·1)     -(0.0) != 0.0  = 1 (·2)
--   nan <= nan            = 1 (·4)     nan > 1.0      = 1 (·8)
--   -(0.0) >= 0.0         = 0 (·16)    nan !=. nan    = 1 (·32)
--   1.0 <=. 1.0           = 1 (·64)    nan >=. nan    = 0 (·128)
--
--   2.0 >. 1.0            = 1 (·256)
--
-- Expected: trace [366]

import I.Test.Emit as E

no : Unit -> Int
no _ = 0

yes : Unit -> Int
yes _ = 1

bit : Unit + Unit -> Int
bit = case no yes

nan : Unit -> Float
nan _ = 0.0 /. 0.0

nz : Unit -> Float
nz _ = -(0.0)

-- Four comparisons per definition: an unoptimized riscv64 frame must stay
-- within its 12-bit offsets (a known backend limit), and twelve in one
-- definition do not.
part1 : Unit -> Int
part1 _ =
  bit (nan () != nan ())
    + 2 * bit (nz () != 0.0)
    + 4 * bit (nan () <= nan ())
    + 8 * bit (nan () > 1.0)

part2 : Unit -> Int
part2 _ =
  16 * bit (nz () >= 0.0)
    + 32 * bit (nan () !=. nan ())
    + 64 * bit (1.0 <=. 1.0)
    + 128 * bit (nan () >=. nan ())

part3 : Unit -> Int
part3 _ = 256 * bit (2.0 >. 1.0)

main : Act Unit Unit
main = emit@E (part1 () + part2 () + part3 ())
