-- Plan 0.36 north-star test (EFFECTFUL — THE CROWN CASE). Functor shape #5
-- (leaf binary tree, TWO recursive positions), effect-emitting: emit each
-- leaf's Int. Combines the case the legacy codegen could not do (two recursive
-- children) with effect ORDERING across them.
--
-- Compiles + runs to the exit-7 sentinel (the suite's assertion). `emit@E` is
-- the test-local Emits SigOp (runtime nop in the shipped interpretation; the
-- emit ORDERING is exercised by TraceSpec against the byte interpretation).
--
-- Plan 0.52 retired `arr`; the algebra composes the eff SigOp with the builtin
-- `terminal`, and `emitTree` is applied to `t` in a `let` (composing a
-- user-named cata as a morphism arm is a separate open frontend item — see
-- plans/0.53-HANDOFF-compose-pure-eff-subsumption.md).

import I.Linux.Syscalls as S
import I.Test.Emit as E

-- node(leaf 40, leaf 2)
t : Mu (K Int + (Id * Id))
t = In (inr (In (inl 40), In (inl 2)))

-- algebra over `K Int + (Id * Id)` (recursive positions already folded to Unit):
--   leaf (K Int):        emit@E       -- emit the leaf value
--   node (Unit * Unit):  terminal     -- children already emitted; emit nothing
emitTree : Eff (Mu (K Int + (Id * Id))) Unit
emitTree = cata (case emit@E terminal)

main : IO Unit
main = let r = emitTree t in exit@S 7
