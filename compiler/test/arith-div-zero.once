-- arith-div-zero.once: D055 total division by zero: x / 0 = -1 (all-ones).
-- f 7 = 7 / 0 = -1; low byte = 255. Expected exit code 255.

import I.Linux.Syscalls as S

f : Int -> Int
f x = x / 0

main : IO Unit
main = exit@S (f 7)
