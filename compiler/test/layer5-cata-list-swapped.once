-- 2026-10-30 regression (D361): functor shape Mu ((K Int * Id) + K Unit).
-- The cons arm comes FIRST: 2 + 3 + 0 = 5 (was 178).
-- The deleted shape-specialised cata codegens (strat-nat / strat-linear)
-- miscompiled it; every recursive functor now takes the generic walk.
--
-- Expected: exit 5

import I.Linux.Syscalls as S

zeroI : Unit -> Int
zeroI _ = 0

step : Int * Int -> Int
step p = fst p + snd p

f : Mu (K Int * Id + K Unit) -> Int
f = cata (case step zeroI)

v : Mu (K Int * Id + K Unit)
v = In (inl (2, In (inl (3, In (inr unit)))))

main : Act Unit Void
main = exit@S (f v)
