-- Layer 1 test: user-defined function over a pair
-- Tests that top-level user functions whose bodies emit thunks
-- coexist in the same module without thunk-label collisions
-- (Plan 0.12 thunk-label-threading fix).
-- Expected: exit code 42

import I.Linux.Syscalls as S

swap : Int * Int -> Int * Int
swap p = (snd p, fst p)

main : IO Unit
main = exit@S (fst (swap (99, 42)))
