-- Layer 2 test: `initial : Void -> A` (the ex falso quodlibet morphism).
--
-- Encodes Void as one branch of a sum so the elaborator/typechecker
-- accepts the program. The Left branch fires at runtime, so `initial`
-- itself is never invoked dynamically (it cannot be — Void is
-- uninhabited). The test guards that `initial` continues to typecheck
-- and link as a CCT2 primitive.

import I.Linux.Syscalls as S

-- D321: `initial`'s principal type over the domain `Void` is `Void -> Void`;
-- the destruct is at the join of its branches, `Int ⊔ Void = Int` (D322).
fromVoid : Void -> Void
fromVoid = initial

pickInt : Int + Void -> Int
pickInt s = destruct s of { Left x -> x ; Right v -> fromVoid v }

main : Act Unit Void
main = exit@S (pickInt ((inl 42) : Int + Void))
