-- FLOAT ARITHMETIC OVER AN ARGUMENT (plan 0.129 B5). Expected exit code 23
--
-- Until B5 an arith block could not read a `Float` input, so `x + x` stayed a
-- call to `arith.add.float`, a symbol nothing defines, and this program failed
-- to link. What hid it: `arith-sigop-contract` assumed the file's block table
-- has every compiler primitive's symbol. `addI` has the same tree at `Int`;
-- the two blocks must get different symbols. The values are checked by
-- `FloatEmitSpec`'s "argument:" group; this test checks both builds link and run.

import I.Linux.Syscalls as S
import I.Test.Emit as E

addF : Float * Float -> Float
addF p = fst p + snd p

addI : Int * Int -> Int
addI p = fst p + snd p

twice : Float -> Float
twice x = x + x

emitArg : Act Unit Unit
emitArg = emitF@E (addF (twice 1.5, 0.25))

main : Act Unit Void
main = exit@S . ((\_ -> addI (20, 3)) . emitArg)
