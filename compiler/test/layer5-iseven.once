-- Layer 5 test: a catamorphism, end-to-end.
--
-- Nat = Mu (K Unit + Id):  zero = In (inl unit) ; suc n = In (inr n).
-- isEven via cata: zero -> inl unit (even) ; suc b -> not b.
-- two is even, so isEven two = inl unit, and case picks even42 = exit 42.

import I.Linux.Syscalls as S

-- two = suc (suc zero)
two : Mu (K Unit + Id)
two = In (inr (In (inr (In (inl unit)))))

-- isEven : Nat -> Unit + Unit   (inl = even, inr = odd)
-- algebra : Unit + (Unit + Unit) -> Unit + Unit, point-free (copair of
-- closed morphisms):
--   inl tt (zero layer)        -> inl    (zero is even)
--   inr b  (suc layer, b=prev) -> not b  = case inr inl  (flip even/odd)
isEven : Mu (K Unit + Id) -> Unit + Unit
isEven = cata (case inl (case inr inl))

even42 : Unit -> Int
even42 _ = 42

odd99 : Unit -> Int
odd99 _ = 99

main : IO Unit
main = exit@S (case even42 odd99 (isEven two))
