-- arith-div-1.once: integer division. f x = x / 4; f 20 = 5. Expected exit code 5.
-- Plan 0.57 (D055): / is total, truncated toward zero.

import I.Linux.Syscalls as S

f : Int -> Int
f x = x / 4

main : IO Unit
main = exit@S (f 20)
