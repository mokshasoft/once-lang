-- arith-div-1.once: integer division. f x = x / 4; f 20 = 5. Expected trace [5].
-- Plan 0.57 (D055): / is total, truncated toward zero.

import I.Test.Emit as E

f : Int -> Int
f x = x / 4

main : Act Unit Unit
main = emit@E (f 20)
