-- 2026-10-30 regression (plan 0.125 cata): functor shape Mu (K Int + (Id + (Id * Id))).
-- Unary and binary recursive arms: 5 + (7 + 100) = 112.
-- The deleted shape-specialised cata codegens (strat-nat / strat-linear)
-- miscompiled it; every recursive functor now takes the generic walk.
--
-- Expected: exit 112

import I.Linux.Syscalls as S

leaf : Int -> Int
leaf n = n
one : Int -> Int
one n = n + 100
node : (Int * Int) -> Int
node p = fst p + snd p

f : Mu (K Int + (Id + (Id * Id))) -> Int
f = cata (case leaf (case one node))

v : Mu (K Int + (Id + (Id * Id)))
v = In (inr (inr (In (inl 5) , In (inr (inl (In (inl 7)))))))

main : Act Unit Void
main = exit@S (f v)
