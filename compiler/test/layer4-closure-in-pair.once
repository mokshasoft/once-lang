-- Layer 4 test: closure values carried as a PAIR component.
-- Exercises CCT1 (exponentials) crossed with CCTB (products):
--   applyFst : (Unit -> Int) * Int -> Int
-- Projects the fn out via fst, then applies it.
-- Expected: exit 42.

import I.Linux.Syscalls as S

forty2 : Unit -> Int
forty2 _ = 42

applyFst : (Unit -> Int) * Int -> Int
applyFst p = (fst p) ()

main : IO Unit
main = exit@S (applyFst (forty2, 99))
