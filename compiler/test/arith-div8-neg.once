-- arith-div8-neg.once: signed divide by a power-of-two literal, negative
-- dividend. f x = x / 8; f (0 - 24) = -3 (truncate toward zero). Emitted
-- whole. Expected: trace [-3].
-- Exercises the sign-corrected arithmetic-shift-right (sar + bias, not idiv).

import I.Test.Emit as E

f : Int -> Int
f x = x / 8

main : Act Unit Unit
main = emit@E (f (0 - 24))
