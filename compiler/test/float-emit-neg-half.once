-- D220: the float literal is USED — passed to `emitF`, and the TRACE is what
-- this test asserts.
--
-- It used to end `main = let _ = emitF@T (-0.5) in exit@S 13`, which binds a
-- suspension and never forces it. It emitted nothing and compiled
-- byte-identical to a bare `main = exit@S 13`, so its header's claim that
-- "the literal is USED" was false and the D109 `ud2` regression it was written
-- to catch could not have been caught: no float constant reached `.text` at all.
--
-- Two shape constraints, both load-bearing (FloatEmitSpec.hs:105-118):
--   * the effect must sit on `main`'s composition chain to run at all;
--   * the literal needs a SIGNATURE-CARRYING binding — nested inside another
--     `compose` it lands in an inference position, and a float literal has no
--     inferable type (a pre-existing frontend gap).
--
-- Expected: exit code 13.

import I.Linux.Syscalls as S
import I.Test.Emit as E

emitLit : IO Unit
emitLit = compose emitF@E (\_ -> (-0.5))

main : IO Unit
main = compose exit@S (compose (\_ -> 13) emitLit)
