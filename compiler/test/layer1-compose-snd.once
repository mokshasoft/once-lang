-- Layer 1 test: compose chain over snd morphisms
-- (snd . snd . snd) (1, (2, (3, 42))) should yield 42 via the
-- morphism-realm bypass (Plan 0.2.4.5 D2): three composes
-- collapse to a single CCC `_∘_`, no apply chain.
-- Expected: exit code 42

import I.Linux.Syscalls as S

main : IO Unit
main = exit@S ((snd . snd . snd) (1, (2, (3, 42))))
