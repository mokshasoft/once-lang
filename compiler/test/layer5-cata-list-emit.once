-- Point-free effectful cata (Plan 0.36). The algebra invokes the test-local
-- `emit` Emits SigOp once per cons layer, and THAT is what this test asserts —
-- the byte trace [5, 3], read back from the observable interpretation, not the
-- exit code.
--
-- D220: this file used to end `main = let r = emitAll xs in exit@S 7`, which
-- binds a SUSPENSION and never forces it. It emitted nothing, compiled
-- byte-identical to a bare `main = exit@S 7`, and passed on its hardcoded exit
-- code alone. The effect has to be on `main`'s composition chain to run, and a
-- top-level def is required to put it there — a `let`-bound name is not
-- interchangeable with one (plan 0.94).
--
-- Expected: exit code 7, trace [5, 3].

import I.Linux.Syscalls as S
import I.Test.Emit as E

-- [3, 5]
xs : Mu (K Unit + (K Int * Id))
xs = In (inr (3, In (inr (5, In (inl unit)))))

-- algebra : (Unit + (Int * Unit)) ->[eff] Unit  (nil: unit; cons: emit head)
emitAll : Eff (Mu (K Unit + (K Int * Id))) Unit
emitAll = cata (case terminal (compose emit@E fst))

-- The fold, as a morphism `main` can compose with.
runAll : IO Unit
runAll = emitAll xs

main : IO Unit
main = compose exit@S (compose (\_ -> 7) runAll)
