-- Plan 0.36 north-star (EFFECTFUL). Functor #3 (List Int), effect-emitting:
-- the cata algebra invokes the test-local `emit` Emits SigOp once per cons
-- layer. Tests effect ORDERING (cata folds bottom-up: [3,5] emits 5 then 3).
-- Point-free / effect-sequenced (D032 grade-polymorphic composition): `arr`
-- lifts pure morphisms into the effect realm; `compose` sequences the
-- effectful cata into main's chain so its emissions actually fire.
-- Expected observable TRACE: [ emit 5 , emit 3 , linux.exit 7 ]; the binary
-- runs to exit 7 (emit = runtime nop).

import I.Linux.Syscalls as S
import I.Test.Emit as E

-- [3, 5]
xs : Mu (K Unit + (K Int * Id))
xs = In (inr (3, In (inr (5, In (inl unit)))))

getXs : Unit -> Mu (K Unit + (K Int * Id))
getXs u = xs

seven : Unit -> Int
seven u = 7

-- algebra : (Unit + (Int * Unit)) ->[eff] Unit  (nil: unit; cons: emit head)
emitAll : Eff (Mu (K Unit + (K Int * Id))) Unit
emitAll = cata (case (arr terminal) (compose emit@E (arr fst)))

-- run emitAll on xs (sequenced into main's effect chain), then exit 7.
main : IO Unit
main = compose exit@S (compose (arr seven) (compose emitAll (arr getXs)))
