-- Point-free effectful cata (Plan 0.36). Compiles and runs to its sentinel
-- exit 7. The effect-emitting cata algebra invokes the test-local `emit` Emits
-- SigOp once per cons layer (a runtime nop in the shipped interpretation, so
-- the observable here is the exit code; the emit ORDERING itself is exercised
-- by TraceSpec against the byte-writing test interpretation).
--
-- Plan 0.52 retired `arr`; the algebra composes an eff SigOp with the builtin
-- `fst`/`terminal` morphisms directly, and `emitAll` is applied to `xs` in a
-- `let` (composing a user-named cata as a morphism arm is a separate open
-- frontend item — see plans/0.53-HANDOFF-compose-pure-eff-subsumption.md).

import I.Linux.Syscalls as S
import I.Test.Emit as E

-- [3, 5]
xs : Mu (K Unit + (K Int * Id))
xs = In (inr (3, In (inr (5, In (inl unit)))))

-- algebra : (Unit + (Int * Unit)) ->[eff] Unit  (nil: unit; cons: emit head)
emitAll : Eff (Mu (K Unit + (K Int * Id))) Unit
emitAll = cata (case terminal (compose emit@E fst))

-- run emitAll on xs, then exit 7.
main : IO Unit
main = let r = emitAll xs in exit@S 7
