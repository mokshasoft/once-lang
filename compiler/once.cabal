  hs-source-dirs:
      app
  ghc-options:
      -threaded
      -rtsopts
      -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , once
    , text

-- once-discover removed: depends on removed Once.MAlonzo module
-- Can be restored when optimizer testing is reimplemented at source level

test-suite once-test
  import: shared
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Paths_once
      ArithSpec
      Backend.Common
      FloatSpec
      FloatEmitSpec
      LitRangeSpec
      GeneratorSpec
      InferSpec
      IRSpec
      Layer0Spec
      Layer1Spec
      Layer2Spec
      Layer3Spec
      Layer4Spec
      Layer5Spec
      OptimizeSpec
      ParseSpec
      QttSpec
      PuritySpec
      SpecMatrixSpec
      TelescopeSpec
      SymbolNameSpec
      TraceSpec
      TypeCheckSpec
      TypeErrorSpec
      -- Disabled: reference old Haskell modules that no longer exist
      -- ElaborateSpec (Once.Elaborate, Once.Parser, Once.Syntax)
      -- ModuleSpec (Once.Module, Once.Syntax)
      -- QuantitySpec (Once.Quantity)
  autogen-modules:
      Paths_once
  hs-source-dirs:
      test
  ghc-options:
      -threaded
      -rtsopts
      -with-rtsopts=-N
  -- Put the freshly-built `once` executable on PATH for the tests. The test
  -- harness (Backend.Common.runOnce) resolves the compiler via
  -- `findExecutable "once"`; without this stanza `once` is absent and the
  -- harness falls back to `cabal run once --`, which deadlocks on cabal's
  -- build lock when many tests run concurrently under `cabal test`.
  build-tool-depends:
      once:once
  build-depends:
      base >=4.7 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , once
    , process
    , tasty
    , tasty-hunit
    , tasty-quickcheck
    , temporary
    , text
